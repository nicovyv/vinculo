@model Vinculo.Models.ViewModels.RegistroOrganizacionViewModel
@{
    ViewData["Title"] = "Registro de Organización";
}

<!-- Carga de Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<style>
    .font-tabular {
        font-variant-numeric: tabular-nums;
    }

    .card-selectable {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        border: 2px solid transparent;
    }

    .card-selectable.active {
        border-color: var(--bs-primary);
        background-color: #ffffff;
        box-shadow: 0 .125rem .25rem rgba(15, 42, 71, 0.08) !important;
    }

    .card-selectable:not(.active) {
        background-color: #eef3fb;
        opacity: 0.9;
    }

    .card-selectable:not(.active):hover {
        opacity: 1;
        border-color: #cbd5e1;
    }

    .step-circle {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bs-primary);
        color: #ffffff;
        font-weight: 600;
        font-size: 0.85rem;
    }

    #mapaDomicilio {
        width: 100%;
        height: 320px;
        border-radius: 12px;
        z-index: 1;
        border: 1px solid #e3e8f0;
    }

    .leaflet-control-attribution {
        font-size: 10px;
    }

    /* Estilos específicos del Modal de Stitch */
    .compact-clause {
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        background: #ffffff;
    }

    .icon-box {
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #eff4ff;
        color: #0d8b99;
    }

    .btn-teal-modal {
        background-color: #0d8b99;
        color: #ffffff;
        border: none;
    }
    .btn-teal-modal:hover, .btn-teal-modal:focus {
        background-color: #096874;
        color: #ffffff;
    }
    .btn-teal-modal:disabled {
        background-color: #8fa3b0;
        color: #ffffff;
        opacity: 0.65;
    }
</style>

<div class="container my-4">
    <!-- Columna Centrada para el Formulario -->
    <div class="col-lg-10 col-xl-9 mx-auto">

        <!-- Breadcrumb & Context Header -->
        <div class="row align-items-end mb-4 gy-2">
            <div class="col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small text-secondary">
                        <li class="breadcrumb-item">Portal Vínculo</li>
                        <li aria-current="page" class="breadcrumb-item active text-dark fw-medium">Alta de Organizaciones</li>
                    </ol>
                </nav>
                <h1 class="h2 fw-bold text-dark mb-1">Registro de Organización</h1>
                <p class="text-secondary mb-0">Conectamos capacidades corporativas IT con instituciones y comedores de impacto social.</p>
            </div>
        </div>

        <form asp-action="Registro" method="post" id="registrationForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Selector de Tipo de Entidad -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-uppercase text-secondary fw-semibold small" style="letter-spacing: 0.05em;">Paso Inicial</span>
                            <h2 class="h5 fw-bold text-dark mb-0">Seleccione el Tipo de Entidad</h2>
                        </div>
                    </div>
                    <div class="row g-3">
                        <!-- Card Institución Social -->
                        <div class="col-md-6">
                            <div class="card card-selectable active p-3 h-100 rounded-3" id="typeOptionOrg" onclick="selectRole('institucion')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="p-2 rounded bg-light text-primary">
                                        <i class="bi bi-building fs-4"></i>
                                    </div>
                                    <span class="badge rounded-circle bg-primary p-1 text-white" id="checkIconOrg">
                                        <i class="bi bi-check-lg fs-6"></i>
                                    </span>
                                </div>
                                <div class="mt-3">
                                    <h5 class="fw-bold text-dark fs-6 mb-1">Institución Social</h5>
                                    <p class="small text-secondary mb-2">Escuela pública, comedor comunitario, centro de formación o club barrial receptor.</p>
                                </div>
                                <input type="radio" asp-for="TipoOrganizacion" value="institucion" class="form-check-input visually-hidden" id="roleInstitucion" checked>
                            </div>
                        </div>

                        <!-- Card Empresa Donante -->
                        <div class="col-md-6">
                            <div class="card card-selectable p-3 h-100 rounded-3" id="typeOptionCorp" onclick="selectRole('empresa')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="p-2 rounded bg-white text-secondary">
                                        <i class="bi bi-briefcase fs-4"></i>
                                    </div>
                                    <span class="badge rounded-circle bg-secondary-subtle p-1 text-transparent" id="checkIconCorp">
                                        <i class="bi bi-check-lg fs-6 text-white opacity-0"></i>
                                    </span>
                                </div>
                                <div class="mt-3">
                                    <h5 class="fw-bold text-dark fs-6 mb-1">Empresa Donante</h5>
                                    <p class="small text-secondary mb-2">Corporaciones, pymes y estudios que disponen de parque informático para trazabilidad y cesión.</p>
                                </div>
                                <input type="radio" asp-for="TipoOrganizacion" value="empresa" class="form-check-input visually-hidden" id="roleEmpresa">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 1: Datos de la Organización -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="step-circle">1</span>
                        <div>
                            <h3 class="h5 fw-bold text-dark mb-0">Datos de la Organización</h3>
                            <small class="text-secondary">Información fiscal y datos de referencia operativa.</small>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="NombreRazonSocial" class="form-label fw-semibold small">Nombre o Razón Social <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="NombreRazonSocial" class="form-control" type="text" placeholder="Ej. Asociación Civil o Empresa S.A." required>
                                <span class="input-group-text bg-white text-primary"><i class="bi bi-patch-check-fill"></i></span>
                            </div>
                            <span asp-validation-for="NombreRazonSocial" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cuit" class="form-label fw-semibold small mb-1">CUIT <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Cuit" class="form-control font-tabular" type="text" placeholder="Sin guiones" required>
                                <span class="input-group-text bg-white text-secondary border-start-0"><i class="bi bi-hash"></i></span>
                            </div>
                            <span asp-validation-for="Cuit" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PersonaContacto" class="form-label fw-semibold small">Persona de Contacto Directo <span class="text-danger">*</span></label>
                            <input asp-for="PersonaContacto" class="form-control" type="text" required>
                            <span asp-validation-for="PersonaContacto" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label fw-semibold small">Teléfono de Contacto <span class="text-danger">*</span></label>
                            <input asp-for="Telefono" class="form-control font-tabular" type="tel" required>
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: Domicilio y Geolocalización -->
            <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="step-circle">2</span>
                            <div>
                                <h3 class="h5 fw-bold text-dark mb-0">Domicilio y Motor Geográfico</h3>
                                <small class="text-secondary">Requerido para cálculo de radio logístico de retiro y entrega.</small>
                            </div>
                        </div>
                        <i class="bi bi-compass text-secondary fs-4"></i>
                    </div>

                    <div class="row g-4">
                        <!-- Columna Izquierda: Formulario -->
                        <div class="col-12 col-xl-5">
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-8">
                                    <label asp-for="Calle" class="form-label small fw-semibold mb-1">Calle / Avenida <span class="text-danger">*</span></label>
                                    <input asp-for="Calle" id="Calle" class="form-control" type="text" required />
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label asp-for="Numero" class="form-label small fw-semibold mb-1">Número <span class="text-danger">*</span></label>
                                    <input asp-for="Numero" id="Numero" class="form-control font-tabular" type="text" required />
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-8">
                                    <label asp-for="Localidad" class="form-label small fw-semibold mb-1">Localidad <span class="text-danger">*</span></label>
                                    <input asp-for="Localidad" id="Localidad" class="form-control" type="text" required />
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label asp-for="CodigoPostal" class="form-label small fw-semibold mb-1">Cód. Postal <span class="text-danger">*</span></label>
                                    <input asp-for="CodigoPostal" id="CodigoPostal" class="form-control font-tabular text-uppercase" type="text" required />
                                </div>
                            </div>
                            <div class="mb-4">
                                <label asp-for="Provincia" class="form-label small fw-semibold mb-1">Provincia <span class="text-danger">*</span></label>
                                <select asp-for="Provincia" id="Provincia" class="form-select" required>
                                    <option value="CABA">Ciudad Autónoma de Buenos Aires</option>
                                    <option value="Buenos Aires">Buenos Aires</option>
                                    <option value="Córdoba">Córdoba</option>
                                    <option value="Santa Fe">Santa Fe</option>
                                    <option value="Mendoza">Mendoza</option>
                                </select>
                            </div>

                            <div class="d-flex flex-column flex-sm-row gap-2">
                                <button type="button" id="btnBuscarUbicacion" class="btn btn-sm px-3 d-flex align-items-center justify-content-center gap-1 text-white" style="background-color: #0E9AA7; border-color: #0E9AA7;">
                                    <i class="bi bi-search"></i> Validar Ubicación
                                </button>
                                <button type="button" id="btnMiUbicacion" class="btn btn-outline-secondary btn-sm px-3 d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-crosshair"></i> Usar mi GPS
                                </button>
                            </div>
                            <div id="mensajeUbicacion" class="alert d-none small mt-3 mb-0" role="alert"></div>
                        </div>

                        <!-- Columna Derecha: Mapa -->
                        <div class="col-12 col-xl-7">
                            <div class="bg-body-tertiary rounded-3 p-2 h-100 border border-light-subtle d-flex flex-column" style="min-height: 320px;">
                                <div id="mapaDomicilio" class="flex-grow-1"></div>
                                <p class="text-secondary small mt-2 mb-1 text-center"><i class="bi bi-arrows-move me-1"></i> Desplaza el marcador rojo para afinar las coordenadas de retiro logístico.</p>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="Latitud" id="Latitud" />
                    <input type="hidden" asp-for="Longitud" id="Longitud" />
                </div>
            </div>

            <!-- SECCIÓN 3: Credenciales de Acceso -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="step-circle">3</span>
                        <div>
                            <h3 class="h5 fw-bold text-dark mb-0">Credenciales de Acceso</h3>
                            <small class="text-secondary">Acceso al panel institucional y trazabilidad de donaciones.</small>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-semibold small">Correo Electrónico <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Email" class="form-control" type="email" placeholder="correo@organizacion.org.ar" required>
                                <span class="input-group-text bg-white text-secondary"><i class="bi bi-at"></i></span>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold small mb-1">Contraseña <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Password" class="form-control font-tabular" id="password" type="password" required>
                                <button class="btn btn-outline-secondary" onclick="togglePass('password', this)" type="button"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirmar Contraseña <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" class="form-control font-tabular" id="confirmPassword" type="password" required>
                                <button class="btn btn-outline-secondary" onclick="togglePass('confirmPassword', this)" type="button"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Términos y Envío -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="form-check mb-1">
                        <input asp-for="AceptaTerminos" class="form-check-input" type="checkbox" id="termsCheck" onchange="syncTermsCheck(this.checked)" required>
                        <label class="form-check-label small text-secondary" for="termsCheck">
                            He leído y acepto los <a class="text-primary fw-semibold text-decoration-underline" href="#" data-bs-toggle="modal" data-bs-target="#termsModal">Términos de Uso, Compromiso y Descargo de Responsabilidad</a> de la plataforma Vínculo.
                        </label>
                    </div>
                    <span asp-validation-for="AceptaTerminos" class="text-danger small d-block mb-3"></span>
                    <div id="mensajeTerminos" class="alert alert-danger d-none small py-2 mb-3" role="alert"></div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 mt-3">
                        <button class="btn btn-primary px-4 py-2 fw-semibold" id="btnSubmitRegistro" type="button" onclick="handleRegistration()">
                            <i class="bi bi-person-check-fill me-1"></i> Completar Registro
                        </button>

                        <div class="small text-secondary text-center text-sm-end">
                            ¿Ya tenés cuenta? <a class="text-primary fw-bold text-decoration-none" asp-controller="Usuario" asp-action="Login">Iniciar sesión</a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- MODAL DE TÉRMINOS Y CONDICIONES (Diseño Stitch adaptado a Bootstrap 5) -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 760px;">
        <div class="modal-content rounded-3 overflow-hidden bg-white border-0 shadow-lg">
            
            <!-- Modal Header -->
            <div class="modal-header bg-white border-bottom px-4 py-3 align-items-start">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-3 p-2 d-flex align-items-center justify-content-center mt-1 text-white" style="width: 42px; height: 42px; background-color: #0f2a47; box-shadow: 0 2px 6px rgba(15,42,71,0.25);">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <h5 class="modal-title fw-bold mb-0 fs-5" id="termsModalLabel" style="color: #0f2a47;">Términos de Uso, Compromiso y Descargo de Responsabilidad</h5>
                        </div>
                        <p class="small mb-0 lh-sm" style="color: #475569;">
                            Condiciones operativas e institucionales de la red solidaria <strong>Vínculo por Eisbaer</strong>.
                        </p>
                    </div>
                </div>
                <button type="button" class="btn-close ms-2 mt-1" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 py-3" style="max-height: 68vh; overflow-y: auto;">
                
                <!-- Lead notice -->
                <div class="alert border-0 rounded-2 p-2 px-3 mb-3 d-flex align-items-center gap-2" style="background-color: #eff6ff; border-left: 3px solid #0d8b99 !important;">
                    <i class="bi bi-info-circle-fill fs-5" style="color: #0d8b99;"></i>
                    <span class="small fw-medium" style="color: #1e3a5f;">
                        Al dar de alta su organización en <strong>Vínculo</strong>, usted declara que los datos suministrados son verídicos y acepta las siguientes condiciones operativas de la plataforma:
                    </span>
                </div>

                <!-- 4 Puntos de Compromiso -->
                <div class="d-flex flex-column gap-2 mb-3">
                    
                    <!-- 1. Rol de la Plataforma -->
                    <div class="compact-clause d-flex align-items-start gap-3" style="border-left: 3px solid #0d8b99;">
                        <div class="icon-box">
                            <i class="bi bi-diagram-3-fill fs-6"></i>
                        </div>
                        <div class="lh-sm">
                            <h6 class="fw-semibold mb-1" style="font-size: 0.875rem; color: #0f2a47;">1. Rol de la Plataforma (Alcance del Servicio)</h6>
                            <p class="mb-0" style="font-size: 0.8125rem; color: #475569;">
                                <strong>Vínculo</strong> (desarrollado por Eisbaer) funciona exclusivamente como un puente tecnológico y directorio de vinculación solidaria para conectar la oferta de equipamiento en desuso con necesidades sociales y educativas. Ni Vínculo ni Eisbaer participan en la entrega física, ni auditan presencialmente el equipamiento.
                            </p>
                        </div>
                    </div>

                    <!-- 2. Compromiso de las Empresas Donantes -->
                    <div class="compact-clause d-flex align-items-start gap-3" style="border-left: 3px solid #0d8b99;">
                        <div class="icon-box">
                            <i class="bi bi-laptop fs-6"></i>
                        </div>
                        <div class="lh-sm">
                            <h6 class="fw-semibold mb-1" style="font-size: 0.875rem; color: #0f2a47;">2. Compromiso de las Empresas Donantes</h6>
                            <p class="mb-1" style="font-size: 0.8125rem; color: #475569;">
                                En caso de registrarse como entidad donante, la organización se compromete a:
                            </p>
                            <ul class="mb-0 ps-3" style="font-size: 0.8125rem; color: #475569;">
                                <li class="mb-1">Publicar y entregar equipamiento que se encuentre en condiciones operativas aceptables y seguras para su uso.</li>
                                <li>Garantizar el borrado total y seguro de datos, asegurando que los dispositivos (computadoras, notebooks, etc.) se entreguen formateados, sin información corporativa o sensible, y libres de contraseñas, bloqueos o cuentas vinculadas.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- 3. Compromiso de las Instituciones Solicitantes -->
                    <div class="compact-clause d-flex align-items-start gap-3" style="border-left: 3px solid #0d8b99;">
                        <div class="icon-box">
                            <i class="bi bi-building-check fs-6"></i>
                        </div>
                        <div class="lh-sm">
                            <h6 class="fw-semibold mb-1" style="font-size: 0.875rem; color: #0f2a47;">3. Compromiso de las Instituciones Solicitantes</h6>
                            <p class="mb-1" style="font-size: 0.8125rem; color: #475569;">
                                En caso de registrarse como institución receptora (escuelas públicas, comedores, centros comunitarios), la entidad se compromete a:
                            </p>
                            <ul class="mb-0 ps-3" style="font-size: 0.8125rem; color: #475569;">
                                <li class="mb-1">Destinar el equipamiento recibido exclusivamente a los fines educativos, comunitarios o sociales declarados en sus solicitudes, prohibiéndose su comercialización.</li>
                                <li>Verificar el estado y funcionamiento de los dispositivos al momento de la recepción.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- 4. Logística, Traslado y Exención de Responsabilidad -->
                    <div class="compact-clause d-flex align-items-start gap-3" style="border-left: 3px solid #0d8b99;">
                        <div class="icon-box">
                            <i class="bi bi-truck fs-6"></i>
                        </div>
                        <div class="lh-sm">
                            <h6 class="fw-semibold mb-1" style="font-size: 0.875rem; color: #0f2a47;">4. Logística, Traslado y Exención de Responsabilidad</h6>
                            <p class="mb-0" style="font-size: 0.8125rem; color: #475569;">
                                Una vez generado el vínculo en el sistema, la coordinación, los costos y la responsabilidad del traslado físico corren por cuenta y mutuo acuerdo entre la Empresa Donante y la Institución Solicitante. <strong>Eisbaer y Vínculo</strong> quedan exentos de toda responsabilidad frente a fallas técnicas de los equipos, incidentes logísticos durante el retiro/entrega, o el uso posterior que se les dé a los bienes.
                            </p>
                        </div>
                    </div>

                </div>

                <!-- Casilla de Aceptación dentro del Modal -->
                <div class="card p-3 rounded-2 shadow-sm" style="background-color: #f0f7ff; border: 1.5px solid #0284c7;">
                    <div class="form-check m-0 d-flex align-items-center gap-2">
                        <input class="form-check-input mt-0" id="modalAcceptCheckbox" onchange="document.getElementById('btnConfirmTermsModal').disabled = !this.checked;" style="cursor: pointer; width: 1.15rem; height: 1.15rem;" type="checkbox">
                        <label class="form-check-label fw-semibold small mb-0" for="modalAcceptCheckbox" style="cursor: pointer; color: #0b1c30;">
                            Comprendo y acepto estos términos de uso y descargo de responsabilidad.
                        </label>
                    </div>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-between align-items-center">
                <div class="text-secondary d-none d-sm-flex align-items-center gap-1" style="font-size: 0.775rem;">
                    <i class="bi bi-shield-check text-success fs-6"></i>
                    <span>Plataforma de vinculación auditada</span>
                </div>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-medium rounded-2" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                    <button type="button" class="btn btn-teal-modal btn-sm px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm rounded-2" id="btnConfirmTermsModal" onclick="acceptTermsFromModal()" disabled>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Confirmar y Aceptar</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <script>
        // Sincronizar los checkboxes del formulario y del modal
        function syncTermsCheck(isChecked) {
            const modalCheck = document.getElementById('modalAcceptCheckbox');
            const modalBtn = document.getElementById('btnConfirmTermsModal');
            const msgTerminos = document.getElementById('mensajeTerminos');
            
            if (modalCheck) modalCheck.checked = isChecked;
            if (modalBtn) modalBtn.disabled = !isChecked;
            if (isChecked && msgTerminos) msgTerminos.classList.add('d-none');
        }

        function acceptTermsFromModal() {
            const mainCheck = document.getElementById('termsCheck');
            mainCheck.checked = true;
            syncTermsCheck(true);

            // Cerrar el modal usando la instancia de Bootstrap
            const modalEl = document.getElementById('termsModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();
        }

        // Lógica visual del Tipo de Organización
        function selectRole(type) {
            const orgCard = document.getElementById('typeOptionOrg');
            const corpCard = document.getElementById('typeOptionCorp');
            const checkOrg = document.getElementById('checkIconOrg');
            const checkCorp = document.getElementById('checkIconCorp');
            const radioOrg = document.getElementById('roleInstitucion');
            const radioCorp = document.getElementById('roleEmpresa');

            if (type === 'institucion') {
                orgCard.classList.add('active');
                corpCard.classList.remove('active');
                radioOrg.checked = true;

                checkOrg.className = 'badge rounded-circle bg-primary p-1 text-white';
                checkCorp.className = 'badge rounded-circle bg-secondary-subtle p-1 text-transparent';
            } else {
                corpCard.classList.add('active');
                orgCard.classList.remove('active');
                radioCorp.checked = true;

                checkCorp.className = 'badge rounded-circle bg-primary p-1 text-white';
                checkOrg.className = 'badge rounded-circle bg-secondary-subtle p-1 text-transparent';
            }
        }

        // Lógica de Mostrar/Ocultar contraseña
        function togglePass(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        // LÓGICA DEL MAPA Y GEOLOCALIZACIÓN
        let ubicacionValida = false;

        document.addEventListener("DOMContentLoaded", function () {
            const isEmpresa = document.getElementById('roleEmpresa').checked;
            selectRole(isEmpresa ? 'empresa' : 'institucion');

            // Sincronizar estado inicial del checkbox por si vuelve de un error del backend
            const termsCheck = document.getElementById('termsCheck');
            if (termsCheck) syncTermsCheck(termsCheck.checked);

            const mapa = L.map("mapaDomicilio").setView([-34.6037, -58.3816], 12);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "&copy; OSM" }).addTo(mapa);

            let marcador = null;
            const mensajeUbicacion = document.getElementById("mensajeUbicacion");

            function mostrarMensaje(texto, tipo) {
                mensajeUbicacion.className = `alert alert-${tipo} small mt-3 mb-0`;
                mensajeUbicacion.innerHTML = texto;
            }

            function actualizarCoordenadas(lat, lng) {
                document.getElementById("Latitud").value = lat.toString().replace('.', ',');
                document.getElementById("Longitud").value = lng.toString().replace('.', ',');
            }

            function colocarMarcador(lat, lng, zoom = 16) {
                if (marcador) mapa.removeLayer(marcador);
                marcador = L.marker([lat, lng], { draggable: true }).addTo(mapa);

                marcador.on("dragend", async function (e) {
                    const pos = e.target.getLatLng();
                    actualizarCoordenadas(pos.lat, pos.lng);
                    ubicacionValida = false;
                    await actualizarDireccionDesdeMapa(pos.lat, pos.lng);
                });

                mapa.setView([lat, lng], zoom);
                actualizarCoordenadas(lat, lng);
            }

            async function obtenerDireccionDesdeCoordenadas(lat, lng) {
                const url = `@Url.Action("ObtenerDireccion", "Usuario")?latitud=${encodeURIComponent(lat)}&longitud=${encodeURIComponent(lng)}`;
                const response = await fetch(url);
                if (!response.ok) throw new Error("No se pudo determinar la dirección.");
                return await response.json();
            }

            async function actualizarDireccionDesdeMapa(lat, lng) {
                mostrarMensaje('<span class="spinner-border spinner-border-sm me-1"></span>Sincronizando dirección...', "info");
                try {
                    const dir = await obtenerDireccionDesdeCoordenadas(lat, lng);
                    if (dir.calle) document.getElementById("Calle").value = dir.calle;
                    if (dir.numero) document.getElementById("Numero").value = dir.numero;
                    if (dir.localidad) document.getElementById("Localidad").value = dir.localidad;
                    if (dir.provincia) document.getElementById("Provincia").value = dir.provincia;
                    if (dir.codigoPostal) document.getElementById("CodigoPostal").value = dir.codigoPostal;

                    ubicacionValida = true;
                    mostrarMensaje("Dirección actualizada y vinculada al motor geográfico.", "success");
                } catch (error) {
                    mostrarMensaje(error.message, "warning");
                }
            }

            // Al escribir en los campos, invalidamos silenciosamente la ubicación y ocultamos alertas previas
            ["Calle", "Numero", "Localidad", "Provincia", "CodigoPostal"].forEach(id => {
                const campo = document.getElementById(id);
                if (campo) campo.addEventListener("input", () => {
                    ubicacionValida = false;
                    mensajeUbicacion.className = "alert d-none small mt-3 mb-0";
                });
            });

            document.getElementById("btnBuscarUbicacion").addEventListener("click", async function () {
                const calle = document.getElementById("Calle").value.trim();
                const numero = document.getElementById("Numero").value.trim();
                const localidad = document.getElementById("Localidad").value.trim();
                const provincia = document.getElementById("Provincia").value.trim();
                const codigoPostal = document.getElementById("CodigoPostal").value.trim();

                if (!calle || !numero || !localidad || !provincia) {
                    mostrarMensaje("Completa los campos principales para geolocalizar.", "danger");
                    return;
                }

                const btn = this;
                const originalHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>...';

                try {
                    const parametros = new URLSearchParams({ calle, numero, localidad, provincia, codigoPostal });
                    const response = await fetch(`@Url.Action("BuscarUbicacion", "Usuario")?${parametros.toString()}`);

                    if (!response.ok) throw new Error("No se pudo geolocalizar este domicilio.");
                    const resultado = await response.json();

                    colocarMarcador(resultado.latitud, resultado.longitud);
                    ubicacionValida = true;
                    mostrarMensaje("Ubicación enlazada correctamente.", "success");
                } catch (error) {
                    mostrarMensaje(error.message, "danger");
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            });

            document.getElementById("btnMiUbicacion").addEventListener("click", function () {
                if (!navigator.geolocation) {
                    mostrarMensaje("GPS no soportado en tu navegador.", "danger");
                    return;
                }
                mostrarMensaje("Obteniendo satélites...", "info");
                navigator.geolocation.getCurrentPosition(
                    async pos => {
                        colocarMarcador(pos.coords.latitude, pos.coords.longitude);
                        ubicacionValida = false;
                        await actualizarDireccionDesdeMapa(pos.coords.latitude, pos.coords.longitude);
                    },
                    () => mostrarMensaje("Permiso de ubicación denegado.", "danger"),
                    { enableHighAccuracy: true }
                );
            });

            setTimeout(() => mapa.invalidateSize(), 500);
        });

        // Interceptamos el evento de guardar para exigir validación del mapa y de los términos
        window.handleRegistration = function() {
            if (!ubicacionValida) {
                const msg = document.getElementById("mensajeUbicacion");
                msg.className = "alert alert-danger small mt-3 mb-0";
                msg.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> Por favor, valida la ubicación en el mapa antes de registrarte.';
                msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            const termsCheck = document.getElementById("termsCheck");
            if (!termsCheck.checked) {
                const msgTerminos = document.getElementById("mensajeTerminos");
                msgTerminos.className = "alert alert-danger small py-2 mb-3";
                msgTerminos.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> Debes leer y aceptar los Términos y Condiciones para poder continuar.';
                return;
            }

            const form = document.getElementById("registrationForm");
            if(!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const btn = document.getElementById("btnSubmitRegistro");
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';
            btn.disabled = true;

            setTimeout(() => { form.submit(); }, 800);
        };
    </script>
}