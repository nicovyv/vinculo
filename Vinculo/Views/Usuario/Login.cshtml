@model Vinculo.Models.ViewModels.LoginViewModel
@{
    //  ignora el Layout global 
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Vínculo by Eisbaer - Acceso Institucional</title>
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --bs-primary: #0F2A47;
            --vinculo-teal: #0E9AA7;
            --vinculo-bg: #F5F7FA;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--vinculo-bg);
            color: #0B1C30;
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        /*  CSS  */
        .role-pill.active { background-color: #0F2A47 !important; color: #FFFFFF !important; }
        .role-pill { color: #64748B; background-color: transparent; }
    </style>
</head>
<body>
    <main class="w-100 d-flex align-items-center justify-content-center py-5">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                    
                    <!-- Header  -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center p-2 mb-2 rounded-circle shadow-sm" style="background-color: #FFFFFF; width: 68px; height: 68px;">
                            <img alt="Eisbaer Logo" class="img-fluid" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAnbKY7cOgnCp60k6XqXCIv_LiiEYLrz1fgAm_E49hFMvttWDMSJ6KiIfnry1zYPhGRzTkTEJPDUoNlwejb1yzjJyLIAnfGAbQzTHFofMak4qHIM-We6mCZDTmJJ4Mch3fZ_ddWqVAhNMRtRLJ48e8QL3VxTs9QqDFdmYJPAtYXpwiTRCsos5LUM6wqTKWyRNxwFMMiXLVSri9WI4MULRfiYy1D8m80mk1QxfJghw9i9_2hY7uk25EQuyASGMbI8MZuxrc" style="max-height: 48px; object-fit: contain;">
                        </div>
                        <h1 class="h3 fw-bold mb-1 tracking-tight" style="color: #0F2A47; letter-spacing: -0.02em;">Vínculo</h1>
                        @* <p class="text-secondary small mb-0 fw-medium">Tecnología con Sentido Humano • Plataforma Institucional</p> *@
                    </div>

                    <!-- Card Principal de Login -->
                    <div class="card shadow-sm border-0 rounded-3" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                        <div class="card-body p-4 p-md-5">
                            
                            <div class="mb-4 text-center">
                                <h2 class="h5 fw-bold mb-1" style="color: #0F2A47;">Acceso al Portal</h2>
                                <p class="text-muted small mb-0">Ingresá tus credenciales para operar en la red</p>
                            </div>

                            <!-- FORMULARIO CONECTADO AL VIEWMODEL -->
                            <form asp-action="Login" method="post" id="institutionalLoginForm">
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                                <!-- Identificador visual  -->
                                <div class="alert alert-light border d-flex align-items-center py-2 px-3 mb-3 small" style="background-color: #F8FAFC; color: #475569;">
                                    <i class="bi bi-info-circle-fill me-2" style="color: #0E9AA7;"></i>
                                    <span>Ingresá con tu correo registrado y contraseña.</span>
                                </div>

                                <!-- Campo Email -->
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label small fw-semibold text-uppercase tracking-wider" style="color: #334155; font-size: 0.75rem;">Correo Electrónico</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-secondary" style="border-color: #CBD5E1;"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" class="form-control form-control-lg fs-6" placeholder="nombre@email.com" style="border-color: #CBD5E1; color: #0F2A47;" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- Campo Password -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label asp-for="Password" class="form-label small fw-semibold text-uppercase tracking-wider mb-0" style="color: #334155; font-size: 0.75rem;">Contraseña</label>
                                        @* <a class="text-decoration-none small fw-medium" href="#" style="color: #0E9AA7; font-size: 0.8125rem;">¿Olvidaste tu contraseña?</a> *@
                                    </div>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-secondary" style="border-color: #CBD5E1;"><i class="bi bi-lock"></i></span>
                                        <input asp-for="Password" class="form-control form-control-lg fs-6" placeholder="••••••••••••" style="border-color: #CBD5E1; color: #0F2A47;" />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

@*                                 <div class="mb-4 form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberSession">
                                    <label class="form-check-label small text-secondary" for="rememberSession" style="cursor: pointer;">Recordar sesión</label>
                                </div> *@

                                <!-- Botón Submit de ASP.NET -->
                                <button type="submit" class="btn btn-primary w-100 py-2 fs-6 fw-semibold d-flex align-items-center justify-content-center shadow-sm" style="background-color: #0F2A47; border-color: #0F2A47;">
                                    <span>Iniciar Sesión</span>
                                    <i class="bi bi-arrow-right ms-2"></i>
                                </button>
                            </form>
                            
                        </div>

                        <!-- Banner Inferior Original -->
                        <div class="card-footer py-3 px-4 border-0 rounded-bottom-3" style="background-color: #F8FAFC; border-top: 1px solid #E2E8F0 !important;">
                            <div class="d-flex align-items-start gap-2">
@*                                 <i class="bi bi-shield-lock-fill flex-shrink-0 mt-1" style="color: #0E9AA7; font-size: 1rem;"></i>
                                <p class="mb-0 text-muted" style="font-size: 0.75rem;"><strong>Acceso Seguro:</strong> Autenticación corporativa auditable y segura.</p> *@
                            </div>
                        </div>
                    </div>

                    <!-- Footer Original -->
                    <footer class="mt-4 text-center">
                        <p class="text-muted small mb-0" style="font-size: 0.75rem;">© 2026 Vínculo – Todos los derechos reservados.</p>
                    </footer>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>