@using Vinculo.Models.Enums
@model List<Vinculo.Models.ViewModels.SolicitudViewModel>

@{
    ViewData["Title"] = "Mis Solicitudes";

    var totalSolicitudes = Model.Count;
    var pendientes = Model.Count(s => s.Estado == EstadoSolicitud.Pendiente);
    var enCoordinacion = Model.Count(s => s.Estado == EstadoSolicitud.EnCoordinacion);
    var concretadas = Model.Count(s => s.Estado == EstadoSolicitud.Concretado);
    var totalUnidades = Model.Sum(s => s.Detalles.Sum(d => d.Cantidad));
}

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#0F2A47;">
                Mis Solicitudes
            </h2>
            <p class="text-muted mb-0">
                Consultá tus solicitudes y seguí el estado de cada una.
            </p>
        </div>

        <a asp-controller="Solicitud"
           asp-action="Create"
           class="btn text-white px-4"
           style="background-color:#0F2A47;">
            <i class="bi bi-plus-circle me-2"></i>
            Nueva solicitud
        </a>
    </div>

    <!-- Mensaje de resultado -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["MensajeExito"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["MensajeError"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <!-- Indicadores -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Total histórico</div>
                        <h3 class="fw-bold mb-0">@totalSolicitudes</h3>
                    </div>
                    <div class="rounded-3 p-3"
                         style="background:#E8EEF5;color:#0F2A47;">
                        <i class="bi bi-clipboard-data fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Pendientes</div>
                        <h3 class="fw-bold mb-0">@pendientes</h3>
                    </div>
                    <div class="rounded-3 p-3 bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">En coordinación</div>
                        <h3 class="fw-bold mb-0">@enCoordinacion</h3>
                    </div>
                    <div class="rounded-3 p-3 bg-info-subtle text-info-emphasis">
                        <i class="bi bi-arrow-left-right fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Unidades solicitadas</div>
                        <h3 class="fw-bold mb-0">@totalUnidades</h3>
                    </div>
                    <div class="rounded-3 p-3 bg-success-subtle text-success-emphasis">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Listado -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1" style="color:#0F2A47;">
                        Solicitudes registradas
                    </h5>
                    <p class="text-muted small mb-0">
                        Consultá el detalle y el historial de cada solicitud.
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-light border">
                    @totalSolicitudes solicitudes
                </span>
            </div>
        </div>

        <div class="card-body px-4 pb-4">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-clipboard-x display-4 text-muted"></i>
                    <h5 class="mt-3 fw-bold">Todavía no tenés solicitudes</h5>
                    <p class="text-muted">
                        Creá una solicitud para indicar qué equipamientos necesita tu institución.
                    </p>
                    <a asp-controller="Solicitud"
                       asp-action="Create"
                       class="btn text-white"
                       style="background-color:#0F2A47;">
                        Crear solicitud
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Referencia</th>
                                <th>Fecha</th>
                                <th>Equipamientos</th>
                                <th class="text-center">Unidades</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var solicitud in Model)
                            {
                                var unidades = solicitud.Detalles.Sum(d => d.Cantidad);

                                <tr>
                                    <td>
                                        <span class="fw-semibold" style="color:#0F2A47;">
                                            @(string.IsNullOrWhiteSpace(solicitud.NumeroReferencia)
                                                ? $"SOL-{solicitud.Id}"
                                                : solicitud.NumeroReferencia)
                                        </span>
                                    </td>

                                    <td class="text-nowrap">
                                        @solicitud.Fecha.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (solicitud.Detalles.Any())
                                        {
                                            <span>
                                                @string.Join(", ",
                                                    solicitud.Detalles
                                                        .Select(d => d.TipoEquipamiento.ToString())
                                                        .Distinct()
                                                        .Take(2))
                                            </span>

                                            @if (solicitud.Detalles
                                                .Select(d => d.TipoEquipamiento)
                                                .Distinct()
                                                .Count() > 2)
                                            {
                                                <span class="text-muted small"> y más</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin detalles</span>
                                        }
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @unidades
                                    </td>

                                    <td>
                                        @switch (solicitud.Estado)
                                        {
                                            case EstadoSolicitud.Pendiente:
                                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">
                                                    <i class="bi bi-hourglass-split me-1"></i>
                                                    Pendiente
                                                </span>
                                                break;

                                            case EstadoSolicitud.EnCoordinacion:
                                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis">
                                                    <i class="bi bi-arrow-left-right me-1"></i>
                                                    En coordinación
                                                </span>
                                                break;

                                            case EstadoSolicitud.Concretado:
                                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Concretada
                                                </span>
                                                break;

                                            case EstadoSolicitud.Cancelada:
                                                <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancelada
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-end align-items-center gap-2">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalSolicitud-@solicitud.Id">
                                                <i class="bi bi-eye me-1"></i>
                                                Detalle
                                            </button>

                                            @if (solicitud.Estado == EstadoSolicitud.Pendiente)
                                            {
                                                <a asp-controller="Solicitud"
                                                   asp-action="Edit"
                                                   asp-route-id="@solicitud.Id"
                                                   class="btn btn-sm btn-outline-secondary"
                                                   title="Editar solicitud">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <form asp-controller="Solicitud"
                                                      asp-action="Cancel"
                                                      asp-route-id="@solicitud.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('¿Estás seguro de que querés cancelar esta solicitud?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Cancelar solicitud">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Información de seguimiento -->
    <div class="alert alert-light border mt-4 mb-0">
        <div class="d-flex gap-3 align-items-start">
            <i class="bi bi-info-circle fs-5" style="color:#0F2A47;"></i>
            <div>
                <strong style="color:#0F2A47;">Seguimiento de solicitudes</strong>
                <p class="text-muted small mb-0 mt-1">
                    Podés consultar el estado y los movimientos de cada solicitud desde el botón Detalle.
                    Las solicitudes pendientes también pueden editarse o cancelarse.
                </p>
            </div>
        </div>
    </div>

</div>

<!-- Modales de detalle -->
@foreach (var solicitud in Model)
{
    <div class="modal fade"
         id="modalSolicitud-@solicitud.Id"
         tabindex="-1"
         aria-labelledby="tituloSolicitud-@solicitud.Id"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">

                <div class="modal-header text-white"
                     style="background-color:#0F2A47;">

                    <div>
                        <h5 class="modal-title fw-bold"
                            id="tituloSolicitud-@solicitud.Id">
                            <i class="bi bi-clipboard-check me-2"></i>
                            Detalle de solicitud
                        </h5>

                        <small>
                            @(string.IsNullOrWhiteSpace(solicitud.NumeroReferencia)
                                ? $"SOL-{solicitud.Id}"
                                : solicitud.NumeroReferencia)
                        </small>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body p-4">

                    <!-- Datos generales -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <small class="text-muted d-block mb-1">
                                    Fecha de creación
                                </small>
                                <strong>
                                    @solicitud.Fecha.ToString("dd/MM/yyyy HH:mm")
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <small class="text-muted d-block mb-1">
                                    Estado actual
                                </small>

                                @switch (solicitud.Estado)
                                {
                                    case EstadoSolicitud.Pendiente:
                                        <span class="badge bg-warning-subtle text-warning-emphasis">
                                            Pendiente
                                        </span>
                                        break;

                                    case EstadoSolicitud.EnCoordinacion:
                                        <span class="badge bg-info-subtle text-info-emphasis">
                                            En coordinación
                                        </span>
                                        break;

                                    case EstadoSolicitud.Concretado:
                                        <span class="badge bg-success-subtle text-success-emphasis">
                                            Concretada
                                        </span>
                                        break;

                                    case EstadoSolicitud.Cancelada:
                                        <span class="badge bg-danger-subtle text-danger-emphasis">
                                            Cancelada
                                        </span>
                                        break;
                                }
                            </div>
                        </div>

                    </div>

                    <!-- Equipamientos -->
                    <h6 class="fw-bold mb-3" style="color:#0F2A47;">
                        <i class="bi bi-box-seam me-2"></i>
                        Equipamientos solicitados
                    </h6>

                    @if (solicitud.Detalles.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Equipamiento</th>
                                        <th class="text-center" style="width:140px;">
                                            Cantidad
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var detalle in solicitud.Detalles)
                                    {
                                        <tr>
                                            <td>@detalle.TipoEquipamiento</td>
                                            <td class="text-center">
                                                @detalle.Cantidad
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                                <tfoot class="table-light">
                                    <tr>
                                        <th>Total de unidades</th>
                                        <th class="text-center">
                                            @solicitud.Detalles.Sum(d => d.Cantidad)
                                        </th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4">
                            Esta solicitud no tiene equipamientos registrados.
                        </p>
                    }

                    <hr class="my-4" />

                    <!-- Historial -->
                    <h6 class="fw-bold mb-3" style="color:#0F2A47;">
                        <i class="bi bi-clock-history me-2"></i>
                        Historial de movimientos
                    </h6>

                    @if (solicitud.Observaciones != null &&
                         solicitud.Observaciones.Any())
                    {
                        <div class="d-flex flex-column gap-3">

                            @foreach (var observacion in solicitud.Observaciones
                                .OrderByDescending(o => o.Fecha))
                            {
                                <div class="border rounded-3 p-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-circle-fill"
                                           style="font-size:0.5rem;color:#0E9AA7;">
                                        </i>

                                        <small class="text-muted">
                                            @observacion.Fecha.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>

                                    <p class="mb-0" style="white-space:pre-wrap;">@observacion.Mensaje</p>
                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted border rounded-3 p-4">
                            <i class="bi bi-clock-history fs-3 d-block mb-2"></i>
                            <p class="mb-0">
                                Todavía no hay movimientos registrados para esta solicitud.
                            </p>
                        </div>
                    }

                </div>

                <div class="modal-footer">
                    @if (solicitud.Estado == EstadoSolicitud.Pendiente)
                    {
                        <a asp-controller="Solicitud"
                           asp-action="Edit"
                           asp-route-id="@solicitud.Id"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-pencil me-1"></i>
                            Editar solicitud
                        </a>
                    }

                    <button type="button"
                            class="btn text-white"
                            style="background-color:#0F2A47;"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>

            </div>
        </div>
    </div>
}
