@model List<Vinculo.Models.ViewModels.SolicitudViewModel>

@using Vinculo.Models.Enums

@{
    ViewData["Title"] = "Mis Solicitudes";

    var pendientes = Model.Count(s => s.Estado == EstadoSolicitud.Pendiente);

    var enCoordinacion = Model.Count(
        s => s.Estado == EstadoSolicitud.EnCoordinacion);

    var concretadas = Model.Count(
        s => s.Estado == EstadoSolicitud.Concretado);

    var totalHistorico = Model.Count;

    var totalUnidades = Model
        .SelectMany(s => s.Detalles)
        .Sum(d => d.Cantidad);

    var mensajeExito = TempData["MensajeExito"] as string;
}

<div class="container-fluid p-0">

    <!-- =========================================================
         ENCABEZADO
         ========================================================= -->

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">

        <div>

            <nav aria-label="breadcrumb" class="mb-1">

                <ol class="breadcrumb mb-0" style="font-size:0.75rem;">

                    <li class="breadcrumb-item">
                        <a asp-controller="Institucion"
                           asp-action="Index"
                           class="text-decoration-none text-muted">
                            Inicio
                        </a>
                    </li>

                    <li class="breadcrumb-item active fw-semibold text-primary">
                        Mis Solicitudes
                    </li>

                </ol>

            </nav>

            <h1 class="h3 fw-bold text-dark mb-1"
                style="color:#0F2A47!important;">
                Mis Solicitudes de Donación
            </h1>

            <p class="text-muted mb-0 small">
                Historial, seguimiento y trazabilidad del equipamiento
                tecnológico solicitado.
            </p>

        </div>

        <div class="d-flex align-items-center gap-2">

            <button type="button"
                    class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm"
                    onclick="window.print()"
                    style="font-size:0.875rem;">

                <i class="bi bi-printer"></i>

                <span class="d-none d-sm-inline">
                    Imprimir
                </span>

            </button>

            <a asp-action="Create"
               class="btn btn-teal-primary d-inline-flex align-items-center gap-2 shadow-sm"
               style="text-decoration:none;">

                <i class="bi bi-plus-lg fw-bold"></i>

                <span>
                    Nueva Solicitud
                </span>

            </a>

        </div>

    </div>


    <!-- =========================================================
         MENSAJE DE ÉXITO
         ========================================================= -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center gap-2 mb-4"
             role="alert">

            <i class="bi bi-check-circle-fill fs-5"></i>

            <div>
                @mensajeExito
            </div>

        </div>
    }


    <!-- =========================================================
         MÉTRICAS
         ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Pendientes -->

        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm p-3 bg-white"
                 style="border-radius:0.5rem;border-left:4px solid #F59E0B!important;">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="text-muted text-uppercase fw-semibold"
                              style="font-size:0.7rem;letter-spacing:0.05em;">
                            Pendientes
                        </span>

                        <h4 class="fw-bold mb-0 text-dark mt-1">
                            @pendientes
                        </h4>

                    </div>

                    <div class="p-2 rounded-circle"
                         style="background-color:#FEF3C7;color:#92400E;">

                        <i class="bi bi-hourglass-split fs-5"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- En coordinación -->

        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm p-3 bg-white"
                 style="border-radius:0.5rem;border-left:4px solid #3B82F6!important;">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="text-muted text-uppercase fw-semibold"
                              style="font-size:0.7rem;letter-spacing:0.05em;">
                            En Coordinación
                        </span>

                        <h4 class="fw-bold mb-0 text-dark mt-1">
                            @enCoordinacion
                        </h4>

                    </div>

                    <div class="p-2 rounded-circle"
                         style="background-color:#DBEAFE;color:#1E40AF;">

                        <i class="bi bi-truck fs-5"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Concretadas -->

        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm p-3 bg-white"
                 style="border-radius:0.5rem;border-left:4px solid #10B981!important;">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="text-muted text-uppercase fw-semibold"
                              style="font-size:0.7rem;letter-spacing:0.05em;">
                            Concretadas
                        </span>

                        <h4 class="fw-bold mb-0 text-dark mt-1">
                            @concretadas
                        </h4>

                    </div>

                    <div class="p-2 rounded-circle"
                         style="background-color:#D1FAE5;color:#065F46;">

                        <i class="bi bi-check-circle-fill fs-5"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total -->

        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm p-3 bg-white"
                 style="border-radius:0.5rem;border-left:4px solid #64748B!important;">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="text-muted text-uppercase fw-semibold"
                              style="font-size:0.7rem;letter-spacing:0.05em;">
                            Total Histórico
                        </span>

                        <h4 class="fw-bold mb-0 text-dark mt-1">
                            @totalHistorico
                        </h4>

                    </div>

                    <div class="p-2 rounded-circle"
                         style="background-color:#F1F5F9;color:#475569;">

                        <i class="bi bi-archive-fill fs-5"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         RESUMEN DE EQUIPAMIENTO
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4 bg-white"
         style="border-radius:0.5rem;">

        <div class="card-body p-3 p-lg-4">

            <div class="d-flex align-items-center justify-content-between">

                <div class="d-flex align-items-center gap-3">

                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center"
                         style="background-color:#EFF4FF;color:#0F2A47;width:42px;height:42px;">

                        <i class="bi bi-box-seam fs-5"></i>

                    </div>

                    <div>

                        <span class="fw-bold text-dark d-block">
                            Equipamiento solicitado
                        </span>

                        <small class="text-muted">
                            Total de unidades incluidas en tus solicitudes.
                        </small>

                    </div>

                </div>

                <div class="text-end">

                    <span class="h4 fw-bold text-primary mb-0">
                        @totalUnidades
                    </span>

                    <small class="text-muted d-block">
                        unidades
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         TABLA
         ========================================================= -->

    <div class="card border-0 shadow-sm bg-white mb-4"
         style="border-radius:0.5rem;overflow:hidden;">

        <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center gap-2">

                <i class="bi bi-table text-primary"></i>

                <span class="fw-bold text-dark"
                      style="font-size:0.95rem;">
                    Registro de Solicitudes
                </span>

            </div>

            <span class="badge rounded-pill bg-light text-secondary border px-3 py-1"
                  style="font-size:0.75rem;">

                @totalHistorico solicitud(es)

            </span>

        </div>


        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       style="min-width:850px;">

                    <thead class="table-light text-secondary"
                           style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.04em;">

                        <tr>

                            <th class="ps-4 py-3">
                                N° Referencia
                            </th>

                            <th class="py-3">
                                Fecha
                            </th>

                            <th class="py-3">
                                Equipamiento
                            </th>

                            <th class="py-3 text-center">
                                Unidades
                            </th>

                            <th class="py-3">
                                Estado
                            </th>

                            <th class="text-end pe-4 py-3">
                                Acción
                            </th>

                        </tr>

                    </thead>


                    <tbody class="text-dark"
                           style="font-size:0.875rem;">

                        @foreach (var solicitud in Model)
                        {
                            var unidades = solicitud.Detalles.Sum(d => d.Cantidad);
                            var tipos = solicitud.Detalles.Count;

                            <tr>

                                <!-- REFERENCIA -->

                                <td class="ps-4">

                                    <span class="fw-bold font-monospace"
                                          style="color:#0F2A47;">

                                        @solicitud.NumeroReferencia

                                    </span>

                                </td>


                                <!-- FECHA -->

                                <td>

                                    <span class="text-secondary">

                                        @solicitud.Fecha.ToString("dd/MM/yyyy")

                                    </span>

                                </td>


                                <!-- EQUIPAMIENTO -->

                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        <span class="badge bg-light text-dark border px-2 py-1">

                                            @unidades x

                                        </span>

                                        <div class="d-flex flex-column">

                                            @if (tipos == 1)
                                            {
                                                <span class="fw-semibold text-dark">

                                                    @solicitud.Detalles.First().TipoEquipamiento

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold text-dark">

                                                    @tipos tipos de equipamiento

                                                </span>
                                            }

                                            <small class="text-muted"
                                                   style="font-size:0.72rem;">

                                                @unidades unidad(es) solicitada(s)

                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- UNIDADES -->

                                <td class="text-center">

                                    <span class="badge bg-light text-dark border px-3 py-2">

                                        @unidades

                                    </span>

                                </td>


                                <!-- ESTADO -->

                                <td>

                                    @if (solicitud.Estado == EstadoSolicitud.Pendiente)
                                    {
                                        <span class="badge rounded-pill d-inline-flex align-items-center gap-1"
                                              style="background-color:#FEF3C7;color:#92400E;border:1px solid #FDE68A;padding:0.35rem 0.65rem;">

                                            <i class="bi bi-clock-history"></i>

                                            <span>Pendiente</span>

                                        </span>
                                    }
                                    else if (solicitud.Estado == EstadoSolicitud.EnCoordinacion)
                                    {
                                        <span class="badge rounded-pill d-inline-flex align-items-center gap-1"
                                              style="background-color:#DBEAFE;color:#1E40AF;border:1px solid #BFDBFE;padding:0.35rem 0.65rem;">

                                            <i class="bi bi-truck"></i>

                                            <span>En Coordinación</span>

                                        </span>
                                    }
                                    else if (solicitud.Estado == EstadoSolicitud.Concretado)
                                    {
                                        <span class="badge rounded-pill d-inline-flex align-items-center gap-1"
                                              style="background-color:#D1FAE5;color:#065F46;border:1px solid #A7F3D0;padding:0.35rem 0.65rem;">

                                            <i class="bi bi-check2-circle"></i>

                                            <span>Concretado</span>

                                        </span>
                                    }
                                    else if (solicitud.Estado == EstadoSolicitud.Cancelada)
                                    {
                                        <span class="badge rounded-pill d-inline-flex align-items-center gap-1"
                                              style="background-color:#FEE2E2;color:#991B1B;border:1px solid #FECACA;padding:0.35rem 0.65rem;">

                                            <i class="bi bi-x-circle"></i>

                                            <span>Cancelada</span>

                                        </span>
                                    }

                                </td>


                                <!-- ACCIÓN -->

                                <td class="text-end pe-4">

                                    <a asp-action="Details"
                                       asp-route-id="@solicitud.Id"
                                       class="btn btn-sm btn-outline-primary py-1 px-2"
                                       style="font-size:0.75rem;border-color:#CBD5E1;color:#0F2A47;">

                                        <i class="bi bi-eye"></i>

                                        Detalle

                                    </a>
                                    @if (solicitud.Estado == EstadoSolicitud.Pendiente)
                                    {
                                        <form asp-controller="Solicitud"
                                              asp-action="Cancel"
                                              asp-route-id="@solicitud.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Está seguro de que desea cancelar esta solicitud?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger py-1 px-2"
                                                    style="font-size:0.75rem;">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Cancelar

                                            </button>

                                        </form>
                                    }


                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <div class="mb-3">

                    <i class="bi bi-inbox fs-1 text-secondary"></i>

                </div>

                <h5 class="fw-bold text-dark">
                    Todavía no tenés solicitudes
                </h5>

                <p class="text-muted small mb-4">
                    Creá tu primera solicitud de equipamiento
                    para comenzar el proceso.
                </p>

                <a asp-action="Create"
                   class="btn btn-teal-primary">

                    <i class="bi bi-plus-lg me-1"></i>

                    Nueva Solicitud

                </a>

            </div>
        }

    </div>


    <!-- =========================================================
         INFORMACIÓN
         ========================================================= -->

    <div class="alert border-0 shadow-sm d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between p-3 gap-3 mb-2"
         style="background-color:#EFF4FF;border-left:4px solid #0E9AA7!important;border-radius:0.5rem;">

        <div class="d-flex align-items-center gap-3">

            <div class="rounded-circle p-2 d-flex align-items-center justify-content-center"
                 style="background-color:rgba(14,154,167,0.15);color:#0E9AA7;width:36px;height:36px;flex-shrink:0;">

                <i class="bi bi-info-circle-fill"></i>

            </div>

            <div>

                <span class="fw-bold text-primary d-block"
                      style="color:#0F2A47!important;font-size:0.85rem;">

                    Seguimiento de solicitudes

                </span>

                <p class="text-muted mb-0 small"
                   style="line-height:1.35;">

                    Desde esta sección podés consultar las solicitudes
                    realizadas y acceder al detalle de cada una.

                </p>

            </div>

        </div>

        <div class="flex-shrink-0">

            <a asp-action="Create"
               class="btn btn-sm btn-outline-primary fw-semibold px-3"
               style="border-color:#0E9AA7;color:#0E9AA7;font-size:0.78rem;">

                Nueva solicitud

            </a>

        </div>

    </div>

</div>