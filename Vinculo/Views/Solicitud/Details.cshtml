@model Vinculo.Models.ViewModels.SolicitudViewModel

@{
    ViewData["Title"] = "Detalle de Solicitud";

    var totalUnidades = Model.Detalles?.Sum(d => d.Cantidad) ?? 0;

    string NombreEstado(Vinculo.Models.Enums.EstadoSolicitud estado)
    {
        return estado.ToString();
    }
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0 py-1 small">
        <li class="breadcrumb-item">
            <a asp-controller="Institucion"
               asp-action="Index"
               class="text-decoration-none fw-medium text-secondary">
                <i class="bi bi-house-door me-1"></i>Inicio
            </a>
        </li>

        <li class="breadcrumb-item">
            <a asp-controller="Solicitud"
               asp-action="Index"
               class="text-decoration-none fw-medium text-secondary">
                Mis Solicitudes
            </a>
        </li>

        <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">
            @Model.NumeroReferencia
        </li>
    </ol>
</nav>


<!-- Encabezado -->
<div class="bg-white rounded-3 p-4 shadow-sm border mb-4"
     style="border-color:#E2E8F0;">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

                <h1 class="h3 fw-bold mb-0 text-dark"
                    style="color:#0F2A47;">
                    Solicitud #@Model.NumeroReferencia
                </h1>

                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                    <i class="bi bi-clock-history me-1"></i>
                    @NombreEstado(Model.Estado)
                </span>
            </div>

            <p class="text-muted small mb-0 d-flex align-items-center gap-3 flex-wrap">

                <span>
                    <i class="bi bi-calendar3 me-1 text-primary"></i>
                    Fecha de registro:
                    <strong class="text-dark">
                        @Model.Fecha.ToString("dd/MM/yyyy")
                    </strong>
                </span>

                <span class="text-secondary">•</span>

                <span>
                    <i class="bi bi-box-seam me-1 text-primary"></i>
                    @Model.Detalles.Count tipo(s) de equipamiento
                </span>

                <span class="text-secondary">•</span>

                <span>
                    <i class="bi bi-hash me-1 text-primary"></i>
                    @totalUnidades unidad(es)
                </span>

            </p>
        </div>

        <div class="d-flex align-items-center gap-2">

            <a asp-controller="Solicitud"
               asp-action="Index"
               class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm">
                <i class="bi bi-arrow-left"></i>
                <span class="fw-semibold small">Volver a Mis Solicitudes</span>
            </a>

        </div>
    </div>
</div>


<!-- Resumen -->
<div class="row g-4 mb-4">

    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#EAF8FA;color:#0E9AA7;">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Equipamientos
                        </div>

                        <div class="h4 fw-bold mb-0"
                             style="color:#0F2A47;">
                            @Model.Detalles.Count
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>


    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#EFF4FF;color:#0F2A47;">
                        <i class="bi bi-stack fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Unidades solicitadas
                        </div>

                        <div class="h4 fw-bold mb-0"
                             style="color:#0F2A47;">
                            @totalUnidades
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>


    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#F1F5F9;color:#515F74;">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Fecha
                        </div>

                        <div class="fw-bold"
                             style="color:#0F2A47;">
                            @Model.Fecha.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>


<!-- Equipamiento solicitado -->
<div class="card shadow-sm border-0 mb-4"
     style="border:1px solid #E2E8F0 !important;">

    <div class="card-header bg-white py-3 border-bottom"
         style="border-color:#F1F5F9 !important;">

        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-pc-display-horizontal fs-5 text-primary"></i>

                <h6 class="mb-0 fw-bold text-dark">
                    Equipamiento Solicitado
                </h6>
            </div>

            <span class="badge bg-light text-secondary border">
                @totalUnidades unidad(es)
            </span>

        </div>
    </div>


    <div class="card-body p-0">

        @if (Model.Detalles != null && Model.Detalles.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light text-secondary small text-uppercase"
                           style="font-size:.72rem;letter-spacing:.03em;">

                        <tr>
                            <th class="ps-4 py-3">
                                Tipo de equipamiento
                            </th>

                            <th class="text-center py-3">
                                Cantidad solicitada
                            </th>

                            <th class="pe-4 py-3 text-end">
                                Estado
                            </th>
                        </tr>

                    </thead>

                    <tbody class="text-dark small">

                        @foreach (var detalle in Model.Detalles)
                        {
                            <tr>

                                <td class="ps-4 py-3">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="p-2 rounded bg-light border d-flex align-items-center justify-content-center"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-laptop text-primary fs-5"></i>

                                        </div>

                                        <div>
                                            <div class="fw-bold text-dark">
                                                @detalle.TipoEquipamiento
                                            </div>

                                            <div class="text-muted"
                                                 style="font-size:.75rem;">
                                                Equipamiento tecnológico solicitado
                                            </div>
                                        </div>

                                    </div>

                                </td>

                                <td class="text-center py-3">

                                    <span class="badge bg-light text-dark border px-3 py-2">
                                        @detalle.Cantidad u.
                                    </span>

                                </td>

                                <td class="pe-4 py-3 text-end">

                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        Pendiente de asignación
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">

                <i class="bi bi-inbox fs-1 d-block mb-3"></i>

                <div class="fw-semibold">
                    No hay equipamientos registrados.
                </div>

            </div>
        }

    </div>
</div>


<!-- Trazabilidad -->
<div class="card shadow-sm border-0 mb-4"
     style="border:1px solid #E2E8F0 !important;">

    <div class="card-header bg-white py-3 border-bottom"
         style="border-color:#F1F5F9 !important;">

        <div class="d-flex align-items-center gap-2">

            <i class="bi bi-diagram-3-fill fs-5 text-primary"></i>

            <div>
                <h6 class="mb-0 fw-bold text-dark">
                    Seguimiento de la Solicitud
                </h6>

                <small class="text-muted">
                    Estado actual de la solicitud
                </small>
            </div>

        </div>

    </div>

    <div class="card-body p-4">

        <div class="d-flex align-items-start gap-3">

            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:42px;height:42px;background:#EAF8FA;color:#0E9AA7;">

                <i class="bi bi-check-lg"></i>

            </div>

            <div>

                <div class="fw-bold text-dark">
                    Solicitud registrada
                </div>

                <div class="text-muted small mt-1">
                    La solicitud fue registrada correctamente en el sistema.
                </div>

                <div class="text-muted small mt-1">
                    @Model.Fecha.ToString("dd/MM/yyyy")
                </div>

            </div>

        </div>


        <div class="ms-3 my-2"
             style="height:30px;border-left:2px solid #E2E8F0;">
        </div>


        <div class="d-flex align-items-start gap-3">

            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:42px;height:42px;background:#F1F5F9;color:#64748B;">

                <i class="bi bi-hourglass-split"></i>

            </div>

            <div>

                <div class="fw-bold text-dark">
                    Asignación de equipamiento
                </div>

                <div class="text-muted small mt-1">
                    La información sobre donaciones y asignaciones estará disponible próximamente.
                </div>

                <span class="badge bg-light text-secondary border mt-2">
                    Próximamente
                </span>

            </div>

        </div>


        <div class="ms-3 my-2"
             style="height:30px;border-left:2px solid #E2E8F0;">
        </div>


        <div class="d-flex align-items-start gap-3">

            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:42px;height:42px;background:#F1F5F9;color:#64748B;">

                <i class="bi bi-truck"></i>

            </div>

            <div>

                <div class="fw-bold text-secondary">
                    Logística y entrega
                </div>

                <div class="text-muted small mt-1">
                    El seguimiento de la entrega estará disponible cuando se implemente la gestión de asignaciones.
                </div>

                <span class="badge bg-light text-secondary border mt-2">
                    Próximamente
                </span>

            </div>

        </div>

    </div>
</div>


<!-- Secciones futuras -->
<div class="row g-4 mb-4">

    <div class="col-12 col-lg-6">

        <div class="card shadow-sm border-0 h-100"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3 mb-3">

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:44px;height:44px;background:#F1F5F9;color:#64748B;">

                        <i class="bi bi-building fs-5"></i>

                    </div>

                    <div>
                        <h6 class="fw-bold mb-0 text-dark">
                            Empresa Donante
                        </h6>

                        <small class="text-muted">
                            Información de la asignación
                        </small>
                    </div>

                </div>

                <div class="p-3 rounded-3 bg-light border">

                    <div class="d-flex align-items-center gap-2 text-secondary">

                        <i class="bi bi-hourglass-split"></i>

                        <span class="small fw-semibold">
                            Próximamente
                        </span>

                    </div>

                    <p class="text-muted small mb-0 mt-2">
                        Esta información se mostrará cuando una donación sea vinculada a esta solicitud.
                    </p>

                </div>

            </div>
        </div>

    </div>


    <div class="col-12 col-lg-6">

        <div class="card shadow-sm border-0 h-100"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3 mb-3">

                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:44px;height:44px;background:#F1F5F9;color:#64748B;">

                        <i class="bi bi-truck fs-5"></i>

                    </div>

                    <div>
                        <h6 class="fw-bold mb-0 text-dark">
                            Logística y Entrega
                        </h6>

                        <small class="text-muted">
                            Seguimiento del despacho
                        </small>
                    </div>

                </div>

                <div class="p-3 rounded-3 bg-light border">

                    <div class="d-flex align-items-center gap-2 text-secondary">

                        <i class="bi bi-hourglass-split"></i>

                        <span class="small fw-semibold">
                            Próximamente
                        </span>

                    </div>

                    <p class="text-muted small mb-0 mt-2">
                        La fecha de entrega y los datos de transporte estarán disponibles cuando exista una asignación.
                    </p>

                </div>

            </div>
        </div>

    </div>

</div>


<!-- Ayuda -->
<div class="p-4 rounded-3 border bg-white mb-2"
     style="border-color:#E2E8F0 !important;">

    <div class="d-flex align-items-center gap-2 mb-2">

        <i class="bi bi-info-circle-fill text-primary"></i>

        <span class="fw-semibold text-dark">
            Información sobre tu solicitud
        </span>

    </div>

    <p class="text-muted small mb-0">
        Podés consultar en cualquier momento el estado y el equipamiento
        solicitado. Las etapas de donación, asignación y logística estarán
        disponibles próximamente a medida que se incorporen nuevas
        funcionalidades al sistema.
    </p>

</div>
