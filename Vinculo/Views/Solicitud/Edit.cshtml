@model Vinculo.Models.ViewModels.SolicitudViewModel

@{
    ViewData["Title"] = "Editar Solicitud";
}

<div class="container-fluid p-0">

    <!-- =========================================================
         BREADCRUMB
         ========================================================= -->

    <nav aria-label="breadcrumb" class="mb-3">

        <ol class="breadcrumb mb-0 py-1 small">

            <li class="breadcrumb-item">

                <a asp-controller="Institucion"
                   asp-action="Index"
                   class="text-decoration-none fw-medium text-secondary">

                    <i class="bi bi-house-door me-1"></i>
                    Inicio

                </a>

            </li>

            <li class="breadcrumb-item">

                <a asp-controller="Solicitud"
                   asp-action="Index"
                   class="text-decoration-none fw-medium text-secondary">

                    Mis Solicitudes

                </a>

            </li>

            <li class="breadcrumb-item active text-dark fw-semibold">

                Editar solicitud

            </li>

        </ol>

    </nav>


    <!-- =========================================================
         ENCABEZADO
         ========================================================= -->

    <div class="bg-white rounded-3 p-4 shadow-sm border mb-4"
         style="border-color:#E2E8F0;">

        <div class="d-flex flex-column flex-lg-row
            justify-content-between align-items-lg-center gap-3">

            <div>

                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

                    <h1 class="h3 fw-bold mb-0"
                        style="color:#0F2A47;">

                        Editar Solicitud
                        #@Model.NumeroReferencia

                    </h1>

                    <span class="badge rounded-pill
                        bg-warning-subtle text-warning-emphasis
                        border border-warning-subtle px-3 py-2">

                        <i class="bi bi-clock-history me-1"></i>

                        @Model.Estado

                    </span>

                </div>

                <p class="text-muted small mb-0">

                    Modificá los equipamientos y cantidades de esta solicitud
                    mientras todavía se encuentre pendiente.

                </p>

            </div>


            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary
                d-inline-flex align-items-center gap-2
                px-3 py-2 shadow-sm">

                <i class="bi bi-arrow-left"></i>

                <span class="fw-semibold small">
                    Volver al detalle
                </span>

            </a>

        </div>

    </div>


    <!-- =========================================================
         FORMULARIO
         ========================================================= -->

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          id="editSolicitudForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="Id" />

        <input type="hidden"
               asp-for="NumeroReferencia" />

        <input type="hidden"
               asp-for="Fecha" />

        <input type="hidden"
               asp-for="Estado" />


        <!-- =====================================================
             EQUIPAMIENTO
             ===================================================== -->

        <div class="card shadow-sm border-0 mb-4"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-header bg-white py-3 border-bottom"
                 style="border-color:#F1F5F9 !important;">

                <div class="d-flex align-items-center gap-2">

                    <i class="bi bi-pc-display-horizontal
                    fs-5 text-primary"></i>

                    <div>

                        <h6 class="mb-0 fw-bold text-dark">

                            Equipamiento solicitado

                        </h6>

                        <small class="text-muted">

                            Modificá los tipos y cantidades necesarias.

                        </small>

                    </div>

                </div>

            </div>


            <div class="card-body p-4">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <!-- =================================================
                     EQUIPAMIENTOS EXISTENTES
                     ================================================= -->

                <div id="detalles-container">

                    @foreach (var detalle in Model.Detalles)
                    {
                        <div class="detalle-row border rounded-3 p-3 mb-3"
                             style="border-color:#E2E8F0 !important;">

                            <div class="row g-3 align-items-end">

                                <!-- TIPO -->

                                <div class="col-12 col-md-7">

                                    <label class="form-label fw-semibold text-dark">

                                        Tipo de equipamiento

                                    </label>

                                    <select class="form-select tipo-equipamiento">

                                        @foreach (var tipo in Enum.GetValues<Vinculo.Models.Enums.TipoEquipamiento>())
                                        {
                                            if (tipo == detalle.TipoEquipamiento)
                                            {
                                                <option value="@tipo"
                                                        selected>

                                                    @tipo

                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@tipo">

                                                    @tipo

                                                </option>
                                            }
                                        }

                                    </select>

                                </div>


                                <!-- CANTIDAD -->

                                <div class="col-12 col-md-3">

                                    <label class="form-label fw-semibold text-dark">

                                        Cantidad

                                    </label>

                                    <input type="number"
                                           min="1"
                                           class="form-control cantidad-equipamiento"
                                           value="@detalle.Cantidad" />

                                </div>


                                <!-- ELIMINAR -->

                                <div class="col-12 col-md-2">

                                    <button type="button"
                                            class="btn btn-outline-danger w-100 btn-eliminar">

                                        <i class="bi bi-trash"></i>

                                        <span class="d-md-none ms-1">

                                            Eliminar

                                        </span>

                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>


                <!-- =================================================
                     AGREGAR EQUIPAMIENTO
                     ================================================= -->

                <div class="bg-light rounded-3 border p-3 mt-4">

                    <div class="d-flex align-items-center gap-2
                        mb-3">

                        <i class="bi bi-plus-circle text-primary"></i>

                        <span class="fw-semibold text-primary">

                            Agregar equipamiento

                        </span>

                    </div>


                    <div class="row g-2 align-items-end">

                        <!-- TIPO -->

                        <div class="col-12 col-md-6">

                            <label for="nuevoTipoEquipamiento"
                                   class="form-label small
                                fw-semibold text-secondary">

                                Tipo de equipamiento

                            </label>

                            <select id="nuevoTipoEquipamiento"
                                    class="form-select">

                                <option value="">

                                    Seleccione equipamiento...

                                </option>

                                @foreach (var tipo in Enum.GetValues<Vinculo.Models.Enums.TipoEquipamiento>())
                                {
                                    <option value="@tipo">

                                        @tipo

                                    </option>
                                }

                            </select>

                        </div>


                        <!-- CANTIDAD -->

                        <div class="col-12 col-md-3">

                            <label for="nuevaCantidadEquipamiento"
                                   class="form-label small
                                fw-semibold text-secondary">

                                Cantidad

                            </label>

                            <input id="nuevaCantidadEquipamiento"
                                   type="number"
                                   min="1"
                                   value="1"
                                   class="form-control" />

                        </div>


                        <!-- BOTÓN -->

                        <div class="col-12 col-md-3">

                            <button type="button"
                                    id="btnAgregarEquipamiento"
                                    class="btn btn-primary w-100">

                                <i class="bi bi-plus-lg me-1"></i>

                                Agregar

                            </button>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     RESUMEN
                     ================================================= -->

                <div class="d-flex flex-column flex-sm-row
                    justify-content-between
                    align-items-sm-center
                    gap-2 mt-4 pt-3 border-top">

                    <span class="small text-secondary">

                        <strong id="totalTipos">0</strong>
                        tipo(s) de equipamiento

                    </span>

                    <strong class="text-primary">

                        Total:
                        <span id="totalUnidades">0</span>
                        unidades

                    </strong>

                </div>

            </div>

        </div>


        <!-- =========================================================
             INFORMACIÓN
             ========================================================= -->

        <div class="alert border-0 shadow-sm d-flex
            align-items-start gap-3 mb-4"
             style="background:#EFF4FF;
            border-left:4px solid #0E9AA7 !important;">

            <div class="rounded-circle p-2
                d-flex align-items-center justify-content-center"
                 style="background:rgba(14,154,167,.15);
                color:#0E9AA7;
                width:36px;
                height:36px;
                flex-shrink:0;">

                <i class="bi bi-info-circle-fill"></i>

            </div>

            <div>

                <span class="fw-bold d-block"
                      style="color:#0F2A47;">

                    Importante

                </span>

                <p class="text-muted mb-0 small">

                    Solo podés modificar una solicitud mientras permanezca
                    pendiente y antes de que sea asignada.

                </p>

            </div>

        </div>


        <!-- =========================================================
             ACCIONES
             ========================================================= -->

        <div class="d-flex flex-column flex-sm-row
            justify-content-end gap-2 mb-4">

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary px-4">

                <i class="bi bi-x-lg me-1"></i>

                Cancelar

            </a>

            <button type="submit"
                    class="btn btn-teal-primary px-4">

                <i class="bi bi-check-lg me-1"></i>

                Guardar cambios

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const container =
                document.getElementById("detalles-container");

            const tipoNuevo =
                document.getElementById("nuevoTipoEquipamiento");

            const cantidadNueva =
                document.getElementById("nuevaCantidadEquipamiento");

            const btnAgregar =
                document.getElementById("btnAgregarEquipamiento");

            const form =
                document.getElementById("editSolicitudForm");


            // =====================================================
            // ACTUALIZAR RESUMEN
            // =====================================================

            function actualizarResumen() {

                const filas =
                    container.querySelectorAll(".detalle-row");

                let tipos = 0;
                let unidades = 0;


                filas.forEach(function(fila) {

                    const select =
                        fila.querySelector(".tipo-equipamiento");

                    const cantidad =
                        fila.querySelector(".cantidad-equipamiento");


                    if (!select || !cantidad) {
                        return;
                    }


                    if (!select.value) {
                        return;
                    }


                    const valor =
                        parseInt(cantidad.value, 10) || 0;


                    if (valor <= 0) {
                        return;
                    }


                    tipos++;

                    unidades += valor;

                });


                document.getElementById("totalTipos")
                    .textContent = tipos;

                document.getElementById("totalUnidades")
                    .textContent = unidades;

            }


            // =====================================================
            // BUSCAR FILA POR TIPO
            // =====================================================

            function buscarFilaPorTipo(tipo) {

                const filas =
                    container.querySelectorAll(".detalle-row");


                for (const fila of filas) {

                    const select =
                        fila.querySelector(".tipo-equipamiento");


                    if (select &&
                        select.value === tipo) {

                        return fila;

                    }

                }


                return null;

            }


            // =====================================================
            // AGREGAR EQUIPAMIENTO
            // =====================================================

            btnAgregar.addEventListener("click", function() {

                const tipo =
                    tipoNuevo.value;

                const cantidad =
                    parseInt(cantidadNueva.value, 10);


                // Validar tipo

                if (!tipo) {

                    alert(
                        "Debe seleccionar un tipo de equipamiento."
                    );

                    tipoNuevo.focus();

                    return;

                }


                // Validar cantidad

                if (!cantidad || cantidad <= 0) {

                    alert(
                        "La cantidad debe ser mayor a 0."
                    );

                    cantidadNueva.focus();

                    return;

                }


                // Buscar si ya existe

                const filaExistente =
                    buscarFilaPorTipo(tipo);


                // =================================================
                // SI EXISTE → SUMAR
                // =================================================

                if (filaExistente) {

                    const inputCantidad =
                        filaExistente.querySelector(
                            ".cantidad-equipamiento"
                        );


                    const cantidadActual =
                        parseInt(
                            inputCantidad.value,
                            10
                        ) || 0;


                    inputCantidad.value =
                        cantidadActual + cantidad;


                }

                // =================================================
                // SI NO EXISTE → CREAR
                // =================================================

                else {

                    const fila =
                        document.createElement("div");

                    fila.className =
                        "detalle-row border rounded-3 p-3 mb-3";

                    fila.style.borderColor =
                        "#E2E8F0";


                    fila.innerHTML = `

                                <div class="row g-3 align-items-end">

                                    <div class="col-12 col-md-7">

                                        <label class="form-label fw-semibold text-dark">

                                            Tipo de equipamiento

                                        </label>

                                        <select class="form-select tipo-equipamiento">

                                            @foreach (var tipo in Enum.GetValues<Vinculo.Models.Enums.TipoEquipamiento>())
                                            {
                                                    <option value="@tipo">

                                                            @tipo

                                                    </option>
                                            }

                                        </select>

                                    </div>


                                    <div class="col-12 col-md-3">

                                        <label class="form-label fw-semibold text-dark">

                                            Cantidad

                                        </label>

                                        <input type="number"
                                               min="1"
                                               value="${cantidad}"
                                               class="form-control cantidad-equipamiento" />

                                    </div>


                                    <div class="col-12 col-md-2">

                                        <button type="button"
                                                class="btn btn-outline-danger w-100 btn-eliminar">

                                            <i class="bi bi-trash"></i>

                                            <span class="d-md-none ms-1">

                                                Eliminar

                                            </span>

                                        </button>

                                    </div>

                                </div>

                            `;


                    container.appendChild(fila);


                    fila.querySelector(
                        ".tipo-equipamiento"
                    ).value = tipo;

                }


                // Limpiar controles

                tipoNuevo.value = "";

                cantidadNueva.value = "1";


                actualizarResumen();

                tipoNuevo.focus();

            });


            // =====================================================
            // ELIMINAR
            // =====================================================

            container.addEventListener(
                "click",
                function(event) {

                    const boton =
                        event.target.closest(".btn-eliminar");


                    if (!boton) {
                        return;
                    }


                    const filas =
                        container.querySelectorAll(
                            ".detalle-row"
                        );


                    if (filas.length <= 1) {

                        alert(
                            "Debe existir al menos un equipamiento."
                        );

                        return;

                    }


                    boton.closest(".detalle-row").remove();


                    actualizarResumen();

                }
            );


            // =====================================================
            // CAMBIO DE TIPO EN UNA FILA
            // =====================================================

            container.addEventListener(
                "change",
                function(event) {

                    if (!event.target.classList.contains(
                        "tipo-equipamiento"
                    )) {

                        return;

                    }


                    const select =
                        event.target;

                    const filaActual =
                        select.closest(".detalle-row");

                    const tipo =
                        select.value;


                    if (!tipo) {
                        return;
                    }


                    const filas =
                        container.querySelectorAll(
                            ".detalle-row"
                        );


                    for (const fila of filas) {

                        if (fila === filaActual) {
                            continue;
                        }


                        const otroSelect =
                            fila.querySelector(
                                ".tipo-equipamiento"
                            );


                        if (!otroSelect) {
                            continue;
                        }


                        if (otroSelect.value === tipo) {

                            const cantidadActual =
                                filaActual.querySelector(
                                    ".cantidad-equipamiento"
                                );


                            const cantidadExistente =
                                fila.querySelector(
                                    ".cantidad-equipamiento"
                                );


                            const cantidad1 =
                                parseInt(
                                    cantidadActual.value,
                                    10
                                ) || 0;


                            const cantidad2 =
                                parseInt(
                                    cantidadExistente.value,
                                    10
                                ) || 0;


                            cantidadExistente.value =
                                cantidad1 + cantidad2;


                            filaActual.remove();


                            break;

                        }

                    }


                    actualizarResumen();

                }
            );


            // =====================================================
            // CAMBIO DE CANTIDAD
            // =====================================================

            container.addEventListener(
                "input",
                function(event) {

                    if (
                        event.target.classList.contains(
                            "cantidad-equipamiento"
                        )
                    ) {

                        actualizarResumen();

                    }

                }
            );


            // =====================================================
            // ENTER EN CANTIDAD
            // =====================================================

            cantidadNueva.addEventListener(
                "keydown",
                function(event) {

                    if (event.key === "Enter") {

                        event.preventDefault();

                        btnAgregar.click();

                    }

                }
            );


            // =====================================================
            // SUBMIT
            // =====================================================

            form.addEventListener(
                "submit",
                function(event) {

                    const filas =
                        container.querySelectorAll(
                            ".detalle-row"
                        );


                    const consolidados = {};


                    // =============================================
                    // LEER FILAS
                    // =============================================

                    filas.forEach(function(fila) {

                        const select =
                            fila.querySelector(
                                ".tipo-equipamiento"
                            );

                        const input =
                            fila.querySelector(
                                ".cantidad-equipamiento"
                            );


                        if (!select || !input) {
                            return;
                        }


                        const tipo =
                            select.value;


                        const cantidad =
                            parseInt(
                                input.value,
                                10
                            );


                        if (!tipo) {
                            return;
                        }


                        if (!cantidad || cantidad <= 0) {
                            return;
                        }


                        if (
                            Object.prototype.hasOwnProperty.call(
                                consolidados,
                                tipo
                            )
                        ) {

                            consolidados[tipo] += cantidad;

                        }
                        else {

                            consolidados[tipo] =
                                cantidad;

                        }

                    });


                    const tipos =
                        Object.keys(consolidados);


                    // =============================================
                    // VALIDAR
                    // =============================================

                    if (tipos.length === 0) {

                        event.preventDefault();

                        alert(
                            "Debe existir al menos un equipamiento."
                        );

                        return;

                    }


                    // =============================================
                    // CREAR HIDDEN
                    // =============================================

                    let hidden =
                        document.getElementById(
                            "detalles-hidden"
                        );


                    if (!hidden) {

                        hidden =
                            document.createElement("div");

                        hidden.id =
                            "detalles-hidden";

                        form.appendChild(hidden);

                    }


                    hidden.innerHTML = "";


                    // =============================================
                    // GENERAR DETALLES
                    // =============================================

                    tipos.forEach(function(tipo, index) {

                        const tipoInput =
                            document.createElement("input");

                        tipoInput.type = "hidden";

                        tipoInput.name =
                            `Detalles[${index}].TipoEquipamiento`;

                        tipoInput.value =
                            tipo;


                        const cantidadInput =
                            document.createElement("input");

                        cantidadInput.type = "hidden";

                        cantidadInput.name =
                            `Detalles[${index}].Cantidad`;

                        cantidadInput.value =
                            consolidados[tipo];


                        hidden.appendChild(
                            tipoInput
                        );

                        hidden.appendChild(
                            cantidadInput
                        );

                    });

                }
            );


            // =====================================================
            // INICIALIZAR
            // =====================================================

            actualizarResumen();

        });

    </script>
}