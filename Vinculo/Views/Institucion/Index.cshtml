@model Vinculo.Models.ViewModels.InstitucionDashboardViewModel

@{
    ViewData["Title"] = "Principal";
}

<div class="container-fluid px-0">
    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-secondary">
                    <li class="breadcrumb-item">
                        <a asp-controller="Institucion"
                           asp-action="Index"
                           class="text-decoration-none text-secondary">
                            Inicio
                        </a>
                    </li>
                    <li aria-current="page"
                        class="breadcrumb-item active text-dark fw-semibold">
                        Principal
                    </li>
                </ol>
            </nav>

            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <h1 class="h3 fw-bold text-corporate-primary mb-0">
                    Panel de la Institución
                </h1>

                <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-1 px-2">
                    <i class="bi bi-building me-1"></i>
                    @Model.NombreInstitucion
                </span>
            </div>

            <p class="text-secondary mb-0 small">
                Desde este panel podés consultar el estado de tus solicitudes
                y realizar el seguimiento de los equipamientos solicitados.
            </p>
        </div>

        <div class="text-nowrap">
            <a asp-controller="Solicitud"
               asp-action="Create"
               class="btn btn-teal d-inline-flex align-items-center gap-2 px-3 py-2 fw-medium shadow-sm">
                <i class="bi bi-plus-circle"></i>
                <span>Nueva Solicitud</span>
            </a>
        </div>
    </div>


    <!-- KPIs -->
    <div class="row g-3 mb-4">

        <!-- Total solicitudes -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary text-uppercase fw-semibold"
                              style="font-size: 0.72rem; letter-spacing: 0.05em;">
                            Solicitudes
                        </span>

                        <div class="h3 fw-bold text-corporate-primary mb-0 mt-1 font-monospace">
                            @Model.TotalSolicitudes
                        </div>
                    </div>

                    <div class="kpi-icon-box bg-body-tertiary text-corporate-primary">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1 text-secondary small pt-2 border-top border-light-subtle">
                    <i class="bi bi-collection"></i>
                    <span>Total de solicitudes realizadas</span>
                </div>
            </div>
        </div>


        <!-- Pendientes -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary text-uppercase fw-semibold"
                              style="font-size: 0.72rem; letter-spacing: 0.05em;">
                            Pendientes
                        </span>

                        <div class="h3 fw-bold text-corporate-primary mb-0 mt-1 font-monospace">
                            @Model.SolicitudesPendientes
                        </div>
                    </div>

                    <div class="kpi-icon-box bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1 text-secondary small pt-2 border-top border-light-subtle">
                    <i class="bi bi-hourglass-split"></i>
                    <span>Esperando coordinación</span>
                </div>
            </div>
        </div>


        <!-- En coordinación -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary text-uppercase fw-semibold"
                              style="font-size: 0.72rem; letter-spacing: 0.05em;">
                            En coordinación
                        </span>

                        <div class="h3 fw-bold text-corporate-primary mb-0 mt-1 font-monospace">
                            @Model.SolicitudesEnCoordinacion
                        </div>
                    </div>

                    <div class="kpi-icon-box bg-info-subtle text-info">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1 text-secondary small pt-2 border-top border-light-subtle">
                    <i class="bi bi-truck"></i>
                    <span>Solicitudes en gestión</span>
                </div>
            </div>
        </div>


        <!-- Concretadas -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary text-uppercase fw-semibold"
                              style="font-size: 0.72rem; letter-spacing: 0.05em;">
                            Concretadas
                        </span>

                        <div class="h3 fw-bold text-corporate-primary mb-0 mt-1 font-monospace">
                            @Model.SolicitudesConcretadas
                        </div>
                    </div>

                    <div class="kpi-icon-box bg-success-subtle text-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1 text-success small pt-2 border-top border-light-subtle">
                    <i class="bi bi-check2-circle"></i>
                    <span>Solicitudes completadas</span>
                </div>
            </div>
        </div>

    </div>


    <!-- Resumen + Equipamiento -->
    <div class="row g-4 mb-4">

        <!-- Equipamientos -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h5 class="fw-bold text-corporate-primary mb-1">
                            Equipamiento solicitado
                        </h5>
                        <small class="text-secondary">
                            Unidades solicitadas en total
                        </small>
                    </div>

                    <div class="kpi-icon-box bg-teal-subtle-custom text-teal">
                        <i class="bi bi-pc-display"></i>
                    </div>
                </div>

                <div class="display-5 fw-bold text-corporate-primary font-monospace">
                    @Model.EquipamientosSolicitados
                </div>

                <div class="text-secondary small mt-2">
                    <i class="bi bi-box-seam me-1"></i>
                    Equipamientos incluidos en tus solicitudes.
                </div>
            </div>
        </div>


        <!-- Acciones rápidas -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-corporate-primary mb-1">
                        Acciones rápidas
                    </h5>

                    <p class="text-secondary small mb-4">
                        Accedé rápidamente a las operaciones principales de tu institución.
                    </p>

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <a asp-controller="Solicitud"
                               asp-action="Create"
                               class="text-decoration-none">
                                <div class="border rounded-3 p-3 h-100 d-flex align-items-center gap-3 hover-shadow">
                                    <div class="kpi-icon-box bg-teal-subtle-custom text-teal flex-shrink-0">
                                        <i class="bi bi-plus-lg"></i>
                                    </div>

                                    <div>
                                        <div class="fw-semibold text-corporate-primary">
                                            Nueva Solicitud
                                        </div>
                                        <div class="small text-secondary">
                                            Solicitar equipamiento para la institución.
                                        </div>
                                    </div>

                                    <i class="bi bi-chevron-right ms-auto text-secondary"></i>
                                </div>
                            </a>
                        </div>

                        <div class="col-12 col-md-6">
                            <a asp-controller="Solicitud"
                               asp-action="Index"
                               class="text-decoration-none">
                                <div class="border rounded-3 p-3 h-100 d-flex align-items-center gap-3 hover-shadow">
                                    <div class="kpi-icon-box bg-primary-subtle text-primary flex-shrink-0">
                                        <i class="bi bi-list-check"></i>
                                    </div>

                                    <div>
                                        <div class="fw-semibold text-corporate-primary">
                                            Mis Solicitudes
                                        </div>
                                        <div class="small text-secondary">
                                            Consultar y seguir tus solicitudes.
                                        </div>
                                    </div>

                                    <i class="bi bi-chevron-right ms-auto text-secondary"></i>
                                </div>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Solicitudes recientes -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-header bg-white border-0 pt-3 px-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
            <div>
                <h5 class="fw-bold text-corporate-primary mb-0">
                    Solicitudes recientes
                </h5>

                <small class="text-secondary">
                    Últimas solicitudes realizadas por la institución
                </small>
            </div>

            <a asp-controller="Solicitud"
               asp-action="Index"
               class="btn btn-sm btn-outline-teal">
                Ver todas
                <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="card-body p-0">

            @if (Model.SolicitudesRecientes != null &&
                 Model.SolicitudesRecientes.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light small text-uppercase text-secondary">
                            <tr>
                                <th class="ps-3 py-2">Referencia</th>
                                <th class="py-2">Fecha</th>
                                <th class="py-2">Equipamiento</th>
                                <th class="py-2">Cantidad</th>
                                <th class="py-2">Estado</th>
                                <th class="pe-3 py-2 text-end">Acción</th>
                            </tr>
                        </thead>

                        <tbody class="small">

                            @foreach (var solicitud in Model.SolicitudesRecientes)
                            {
                                var cantidadTotal = solicitud.Detalles?
                                    .Sum(d => d.Cantidad) ?? 0;

                                <tr>

                                    <td class="ps-3">
                                        <span class="fw-bold font-monospace text-corporate-primary">
                                            @solicitud.NumeroReferencia
                                        </span>
                                    </td>

                                    <td class="text-secondary font-monospace">
                                        @solicitud.Fecha.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (solicitud.Detalles != null &&
                                             solicitud.Detalles.Any())
                                        {
                                            <div class="fw-medium text-dark">
                                                @solicitud.Detalles.Count tipo(s)
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">
                                                Sin detalle
                                            </span>
                                        }
                                    </td>

                                    <td class="font-monospace fw-semibold">
                                        @cantidadTotal
                                    </td>

                                    <td>
                                        @switch (solicitud.Estado)
                                        {
                                            case Vinculo.Models.Enums.EstadoSolicitud.Pendiente:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                    <i class="bi bi-clock me-1"></i>
                                                    Pendiente
                                                </span>
                                                break;

                                            case Vinculo.Models.Enums.EstadoSolicitud.EnCoordinacion:
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                                    <i class="bi bi-arrow-left-right me-1"></i>
                                                    En coordinación
                                                </span>
                                                break;

                                            case Vinculo.Models.Enums.EstadoSolicitud.Concretado:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Concretado
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td class="pe-3 text-end">
                                        <a asp-controller="Solicitud"
                                           asp-action="Details"
                                           asp-route-id="@solicitud.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Ver detalle
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5 px-3">
                    <div class="kpi-icon-box bg-body-tertiary text-secondary mx-auto mb-3">
                        <i class="bi bi-inbox"></i>
                    </div>

                    <h6 class="fw-semibold text-corporate-primary">
                        Todavía no tenés solicitudes
                    </h6>

                    <p class="text-secondary small mb-3">
                        Cuando realices una solicitud de equipamiento,
                        aparecerá aquí su estado y seguimiento.
                    </p>

                    <a asp-controller="Solicitud"
                       asp-action="Create"
                       class="btn btn-teal btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>
                        Crear primera solicitud
                    </a>
                </div>
            }

        </div>

    </div>


    <!-- Pie informativo -->
    <div class="mt-4 pt-4 border-top border-light-subtle
        d-flex flex-column flex-md-row
        align-items-center justify-content-between
        gap-3 text-secondary small">

        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-teal fs-5"></i>

            <div>
                <div class="fw-semibold text-corporate-primary">
                    Vínculo · Portal de Instituciones
                </div>

                <div>
                    Seguimiento de solicitudes y asignación de equipamiento.
                </div>
            </div>
        </div>

        <div class="font-monospace">
            ID Institución: @Model.InstitucionId
        </div>

    </div>
</div>

<style>
    .hover-shadow {
        transition: all 0.15s ease-in-out;
    }

        .hover-shadow:hover {
            background-color: #f8f9fa;
            border-color: #0e9aa7 !important;
            box-shadow: 0 0.25rem 0.75rem rgba(15, 42, 71, 0.08);
        }
</style>
