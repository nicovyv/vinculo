@model Vinculo.Models.ViewModels.PerfilInstitucionViewModel

@{
ViewData["Title"] = "Mis Datos";
}

<div class="container-fluid px-0">

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small text-secondary">
            <li class="breadcrumb-item">
                <a asp-controller="Institucion"
                   asp-action="Index"
                   class="text-decoration-none text-secondary">
                    Inicio
                </a>
            </li>

            <li aria-current="page"
                class="breadcrumb-item active text-dark fw-semibold">
                Mis Datos
            </li>
        </ol>
    </nav>

    <h1 class="h3 fw-bold text-corporate-primary mb-1">
        Mis Datos
    </h1>

    <p class="text-secondary small mb-0">
        Información de la institución y domicilio registrado.
    </p>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 border-0 shadow-sm"
         role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["MensajeExito"]</span>
    </div>
}

<div class="row g-4">

    <!-- DATOS DE LA INSTITUCIÓN -->

    <div class="col-12 col-xl-8">

        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-header bg-white border-0 p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="kpi-icon-box bg-primary-subtle text-corporate-primary">
                        <i class="bi bi-building"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold text-corporate-primary mb-1">
                            Datos de la Institución
                        </h5>

                        <small class="text-secondary">
                            Información identificatoria y de contacto.
                        </small>
                    </div>

                </div>

            </div>

            <div class="card-body px-4 pb-4">

                <form asp-controller="Institucion"
                      asp-action="MisDatos"
                      method="post"
                      id="formMisDatos">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <!-- DATOS -->

                    <div class="mb-3">

                        <label asp-for="Nombre"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               placeholder="Nombre de la institución" />

                        <span asp-validation-for="Nombre"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Cuit"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Cuit"
                                   class="form-control"
                                   placeholder="CUIT" />

                            <span asp-validation-for="Cuit"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Telefono"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Telefono"
                                   class="form-control"
                                   placeholder="Teléfono" />

                            <span asp-validation-for="Telefono"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                    <div class="mb-4">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="correo@institucion.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <hr class="border-light-subtle my-4" />

                    <!-- DOMICILIO -->

                    <div class="d-flex align-items-center gap-2 mb-3">

                        <i class="bi bi-geo-alt text-teal fs-5"></i>

                        <div>

                            <h6 class="fw-bold text-corporate-primary mb-0">
                                Domicilio
                            </h6>

                            <small class="text-secondary">
                                Dirección física registrada de la institución.
                            </small>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-8 mb-3">

                            <label asp-for="Calle"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Calle"
                                   class="form-control"
                                   id="Calle"
                                   placeholder="Calle" />

                            <span asp-validation-for="Calle"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label asp-for="Numero"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Numero"
                                   class="form-control"
                                   id="Numero"
                                   placeholder="Número" />

                            <span asp-validation-for="Numero"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-5 mb-3">

                            <label asp-for="Localidad"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Localidad"
                                   class="form-control"
                                   id="Localidad"
                                   placeholder="Localidad" />

                            <span asp-validation-for="Localidad"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label asp-for="Provincia"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Provincia"
                                   class="form-control"
                                   id="Provincia"
                                   placeholder="Provincia" />

                            <span asp-validation-for="Provincia"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-md-3 mb-3">

                            <label asp-for="CodigoPostal"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="CodigoPostal"
                                   class="form-control"
                                   id="CodigoPostal"
                                   placeholder="CP" />

                            <span asp-validation-for="CodigoPostal"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                    <!-- MAPA -->

                    <div class="card bg-body-tertiary border-0 rounded-3 mb-4">

                        <div class="card-body p-3">

                            <div class="d-flex align-items-start gap-3 mb-3">

                                <div class="kpi-icon-box bg-teal-subtle-custom text-teal">
                                    <i class="bi bi-map"></i>
                                </div>

                                <div>

                                    <h6 class="fw-bold text-corporate-primary mb-1">
                                        Ubicación en el mapa
                                    </h6>

                                    <small class="text-secondary">
                                        Buscá el domicilio y verificá la ubicación.
                                        También podés mover el marcador manualmente.
                                    </small>

                                </div>

                            </div>

                            <div class="d-flex flex-column flex-md-row gap-2 mb-3">

                                <button type="button"
                                        id="btnBuscarUbicacion"
                                        class="btn btn-teal">

                                    <i class="bi bi-search me-1"></i>
                                    Buscar ubicación

                                </button>

                                <button type="button"
                                        id="btnMiUbicacion"
                                        class="btn btn-outline-secondary">

                                    <i class="bi bi-crosshair me-1"></i>
                                    Usar mi ubicación

                                </button>

                            </div>

                            <div id="mensajeUbicacion"
                                 class="alert d-none small mb-3"
                                 role="alert">
                            </div>

                            <div id="mapaDomicilio"></div>

                            <div class="mt-2">

                                <small class="text-secondary">

                                    <i class="bi bi-arrows-move me-1"></i>

                                    Al mover el marcador se actualizarán
                                    automáticamente los datos del domicilio.

                                </small>

                            </div>

                        </div>

                    </div>

                    <!-- COORDENADAS -->

                    <input asp-for="Latitud"
                           type="hidden"
                           id="Latitud" />

                    <input asp-for="Longitud"
                           type="hidden"
                           id="Longitud" />

                    <!-- GUARDAR -->

                    <div class="d-flex flex-column align-items-end mt-3">

                        <small id="mensajeGuardar"
                               class="text-danger mb-2 d-none">

                            <i class="bi bi-exclamation-triangle me-1"></i>

                            Actualizá la ubicación en el mapa antes de guardar.

                        </small>

                        <button type="submit"
                                id="btnGuardar"
                                class="btn btn-teal px-4 d-flex align-items-center gap-2">

                            <i class="bi bi-check-lg"></i>
                            Guardar Cambios

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- INFORMACIÓN LATERAL -->

    <div class="col-12 col-xl-4">

        <div class="card border-0 shadow-sm rounded-3 mb-4">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3 mb-3">

                    <div class="kpi-icon-box bg-teal-subtle-custom text-teal">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>

                        <h6 class="fw-bold text-corporate-primary mb-0">
                            Institución registrada
                        </h6>

                        <small class="text-secondary">
                            Datos asociados a tu cuenta.
                        </small>

                    </div>

                </div>

                <div class="bg-body-tertiary rounded-3 p-3">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-secondary small">
                            ID Institución
                        </span>

                        <strong class="font-monospace small">
                            #@Model.Id
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between">

                        <span class="text-secondary small">
                            CUIT
                        </span>

                        <strong class="font-monospace small">
                            @Model.Cuit
                        </strong>

                    </div>

                </div>

            </div>

        </div>

        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-4">

                <h6 class="fw-bold text-corporate-primary mb-3">

                    <i class="bi bi-info-circle me-2 text-teal"></i>
                    Sobre estos datos

                </h6>

                <p class="text-secondary small mb-0">

                    Estos datos identifican a la institución dentro de
                    Vínculo y se utilizan para gestionar las solicitudes
                    de equipamiento y coordinar las entregas.

                </p>

            </div>

        </div>

    </div>

</div>

</div>

<!-- LEAFLET -->

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      crossorigin="anonymous" />

<style>

    #mapaDomicilio {
        width: 100%;
        height: 380px;
        border-radius: 12px;
        overflow: hidden;
        z-index: 1;
    }

    .leaflet-container {
        font-family: inherit;
    }

    .leaflet-control-attribution {
        font-size: 10px;
    }

</style>

@section Scripts {

<partial name="_ValidationScriptsPartial" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        crossorigin="anonymous"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // COORDENADAS INICIALES
        // =====================================================

        const latitudInicial =
            @(Model.Latitud.HasValue
                ? Model.Latitud.Value.ToString(
                    System.Globalization.CultureInfo.InvariantCulture)
                : "null");

        const longitudInicial =
            @(Model.Longitud.HasValue
                ? Model.Longitud.Value.ToString(
                    System.Globalization.CultureInfo.InvariantCulture)
                : "null");


        // =====================================================
        // MAPA
        // =====================================================

        const mapa = L.map("mapaDomicilio").setView(
            [-34.6037, -58.3816],
            12
        );


        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap contributors"
            }
        ).addTo(mapa);


        let marcador = null;


        // =====================================================
        // ESTADO
        // =====================================================

        let ubicacionValida =
            latitudInicial !== null &&
            longitudInicial !== null;


        // =====================================================
        // ELEMENTOS
        // =====================================================

        const btnGuardar =
            document.getElementById("btnGuardar");

        const mensajeGuardar =
            document.getElementById("mensajeGuardar");

        const mensajeUbicacion =
            document.getElementById("mensajeUbicacion");


        // =====================================================
        // MENSAJES
        // =====================================================

        function mostrarMensaje(texto, tipo) {

            mensajeUbicacion.className =
                "alert alert-" + tipo + " small mb-3";

            mensajeUbicacion.innerHTML = texto;

        }


        // =====================================================
        // ESTADO DEL BOTÓN GUARDAR
        // =====================================================

        function actualizarEstadoGuardar() {

            if (ubicacionValida) {

                btnGuardar.disabled = false;

                mensajeGuardar.classList.add("d-none");

            }
            else {

                btnGuardar.disabled = true;

                mensajeGuardar.classList.remove("d-none");

            }

        }


        // =====================================================
        // COORDENADAS
        // =====================================================

        function actualizarCoordenadas(latitud, longitud) {

            document.getElementById("Latitud").value =
                latitud.toString();

            document.getElementById("Longitud").value =
                longitud.toString();

        }


        // =====================================================
        // INVALIDAR
        // =====================================================

        function invalidarUbicacion() {

            ubicacionValida = false;

            actualizarEstadoGuardar();

        }


        // =====================================================
        // OBTENER DIRECCIÓN DESDE COORDENADAS
        // =====================================================

        async function obtenerDireccionDesdeCoordenadas(
            latitud,
            longitud
        ) {

            const url =
                '@Url.Action("ObtenerDireccion", "Institucion")' +
                "?latitud=" +
                encodeURIComponent(latitud) +
                "&longitud=" +
                encodeURIComponent(longitud);

            const response =
                await fetch(url);

            if (!response.ok) {

                throw new Error(
                    "No se pudo determinar la dirección de esta ubicación."
                );

            }

            return await response.json();

        }


        // =====================================================
        // COMPLETAR FORMULARIO
        // =====================================================

        function completarFormulario(direccion) {

            if (direccion.calle) {

                document.getElementById("Calle").value =
                    direccion.calle;

            }

            if (direccion.numero) {

                document.getElementById("Numero").value =
                    direccion.numero;

            }
            else {

                document.getElementById("Numero").value = "";

            }

            if (direccion.localidad) {

                document.getElementById("Localidad").value =
                    direccion.localidad;

            }

            if (direccion.provincia) {

                document.getElementById("Provincia").value =
                    direccion.provincia;

            }

            if (direccion.codigoPostal) {

                document.getElementById("CodigoPostal").value =
                    direccion.codigoPostal;

            }

        }


        // =====================================================
        // REVERSE GEOCODING
        // =====================================================

        async function actualizarDireccionDesdeMapa(
            latitud,
            longitud
        ) {

            mostrarMensaje(
                '<span class="spinner-border spinner-border-sm me-1"></span>' +
                "Buscando la dirección de la ubicación...",
                "info"
            );

            try {

                const direccion =
                    await obtenerDireccionDesdeCoordenadas(
                        latitud,
                        longitud
                    );

                completarFormulario(direccion);

                actualizarCoordenadas(
                    latitud,
                    longitud
                );

                ubicacionValida = true;

                actualizarEstadoGuardar();

                mostrarMensaje(
                    "Dirección actualizada automáticamente a partir de la ubicación seleccionada.",
                    "success"
                );

            }
            catch (error) {

                invalidarUbicacion();

                mostrarMensaje(
                    error.message ||
                    "No se pudo obtener la dirección.",
                    "danger"
                );

            }

        }


        // =====================================================
        // COLOCAR MARCADOR
        // =====================================================

        function colocarMarcador(
            latitud,
            longitud,
            zoom = 16,
            actualizarDireccion = false
        ) {

            if (marcador !== null) {

                mapa.removeLayer(marcador);

            }


            marcador = L.marker(
                [latitud, longitud],
                {
                    draggable: true
                }
            ).addTo(mapa);


            marcador.bindPopup(
                "Ubicación de la institución"
            );


            // =================================================
            // MARCADOR MOVIDO
            // =================================================

            marcador.on(
                "dragend",
                async function (evento) {

                    const posicion =
                        evento.target.getLatLng();


                    actualizarCoordenadas(
                        posicion.lat,
                        posicion.lng
                    );


                    ubicacionValida = false;

                    actualizarEstadoGuardar();


                    await actualizarDireccionDesdeMapa(
                        posicion.lat,
                        posicion.lng
                    );

                }
            );


            mapa.setView(
                [latitud, longitud],
                zoom
            );


            actualizarCoordenadas(
                latitud,
                longitud
            );


            if (!actualizarDireccion) {

                ubicacionValida = true;

                actualizarEstadoGuardar();

            }

        }


        // =====================================================
        // CAMBIOS MANUALES EN DOMICILIO
        // =====================================================

        const camposDomicilio = [
            "Calle",
            "Numero",
            "Localidad",
            "Provincia",
            "CodigoPostal"
        ];


        camposDomicilio.forEach(function (id) {

            const campo =
                document.getElementById(id);


            if (!campo) {
                return;
            }


            campo.addEventListener(
                "input",
                function () {

                    invalidarUbicacion();

                    mostrarMensaje(
                        "El domicilio fue modificado. Presioná \"Buscar ubicación\" para actualizar el mapa.",
                        "warning"
                    );

                }
            );

        });


        // =====================================================
        // UBICACIÓN EXISTENTE
        // =====================================================

        if (
            latitudInicial !== null &&
            longitudInicial !== null
        ) {

            colocarMarcador(
                latitudInicial,
                longitudInicial
            );

        }
        else {

            invalidarUbicacion();

        }


        // =====================================================
        // BUSCAR UBICACIÓN POR DIRECCIÓN
        // =====================================================

        document
            .getElementById("btnBuscarUbicacion")
            .addEventListener(
                "click",
                async function () {

                    const calle =
                        document.getElementById("Calle")
                            .value.trim();

                    const numero =
                        document.getElementById("Numero")
                            .value.trim();

                    const localidad =
                        document.getElementById("Localidad")
                            .value.trim();

                    const provincia =
                        document.getElementById("Provincia")
                            .value.trim();

                    const codigoPostal =
                        document.getElementById("CodigoPostal")
                            .value.trim();


                    if (
                        !calle ||
                        !numero ||
                        !localidad ||
                        !provincia
                    ) {

                        mostrarMensaje(
                            "Completá calle, número, localidad y provincia antes de buscar.",
                            "warning"
                        );

                        return;

                    }


                    const boton =
                        document.getElementById(
                            "btnBuscarUbicacion"
                        );


                    const textoOriginal =
                        boton.innerHTML;


                    boton.disabled = true;

                    boton.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-1"></span>' +
                        "Buscando...";


                    try {

                        const parametros =
                            new URLSearchParams({

                                calle: calle,
                                numero: numero,
                                localidad: localidad,
                                provincia: provincia,
                                codigoPostal: codigoPostal

                            });


                        const url =
                            '@Url.Action("BuscarUbicacion", "Institucion")';


                        const response =
                            await fetch(
                                url +
                                "?" +
                                parametros.toString()
                            );


                        if (!response.ok) {

                            let mensaje =
                                "No se encontró la ubicación.";

                            try {

                                const error =
                                    await response.json();

                                if (error.mensaje) {

                                    mensaje =
                                        error.mensaje;

                                }

                            }
                            catch {
                            }

                            throw new Error(mensaje);

                        }


                        const resultado =
                            await response.json();


                        colocarMarcador(
                            resultado.latitud,
                            resultado.longitud
                        );


                        ubicacionValida = true;

                        actualizarEstadoGuardar();


                        mostrarMensaje(
                            "Ubicación encontrada. Verificá que el marcador corresponda con la institución.",
                            "success"
                        );

                    }
                    catch (error) {

                        invalidarUbicacion();

                        mostrarMensaje(
                            error.message ||
                            "Ocurrió un error al buscar la ubicación.",
                            "danger"
                        );

                    }
                    finally {

                        boton.disabled = false;

                        boton.innerHTML =
                            textoOriginal;

                    }

                }
            );


        // =====================================================
        // USAR MI UBICACIÓN
        // =====================================================

        document
            .getElementById("btnMiUbicacion")
            .addEventListener(
                "click",
                function () {

                    if (!navigator.geolocation) {

                        mostrarMensaje(
                            "Tu navegador no permite obtener la ubicación actual.",
                            "warning"
                        );

                        return;

                    }


                    mostrarMensaje(
                        "Solicitando ubicación del dispositivo...",
                        "info"
                    );


                    navigator.geolocation.getCurrentPosition(

                        async function (posicion) {

                            const latitud =
                                posicion.coords.latitude;

                            const longitud =
                                posicion.coords.longitude;


                            colocarMarcador(
                                latitud,
                                longitud
                            );


                            ubicacionValida = false;

                            actualizarEstadoGuardar();


                            await actualizarDireccionDesdeMapa(
                                latitud,
                                longitud
                            );

                        },


                        function () {

                            invalidarUbicacion();

                            mostrarMensaje(
                                "No se pudo obtener la ubicación. Verificá los permisos del navegador.",
                                "danger"
                            );

                        },

                        {
                            enableHighAccuracy: true,
                            timeout: 10000,
                            maximumAge: 0
                        }

                    );

                }
            );


        // =====================================================
        // SEGURIDAD AL ENVIAR
        // =====================================================

        document
            .getElementById("formMisDatos")
            .addEventListener(
                "submit",
                function (evento) {

                    if (!ubicacionValida) {

                        evento.preventDefault();

                        mostrarMensaje(
                            "No podés guardar los cambios hasta actualizar la ubicación en el mapa.",
                            "danger"
                        );

                        actualizarEstadoGuardar();

                    }

                }
            );


        // =====================================================
        // TAMAÑO DEL MAPA
        // =====================================================

        setTimeout(function () {

            mapa.invalidateSize();

        }, 300);


        // =====================================================
        // ESTADO INICIAL
        // =====================================================

        actualizarEstadoGuardar();

    });

</script>

}
