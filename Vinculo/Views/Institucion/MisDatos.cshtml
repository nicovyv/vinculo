@model Vinculo.Models.ViewModels.PerfilInstitucionViewModel

@{
    ViewData["Title"] = "Mis Datos";
}

<div class="container-fluid px-0">
    <!-- Encabezado -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-secondary">
                <li class="breadcrumb-item">
                    <a asp-controller="Institucion"
                       asp-action="Index"
                       class="text-decoration-none text-secondary">
                        Inicio
                    </a>
                </li>
                <li aria-current="page"
                    class="breadcrumb-item active text-dark fw-semibold">
                    Mis Datos
                </li>
            </ol>
        </nav>

        <h1 class="h3 fw-bold text-corporate-primary mb-1">
            Mis Datos
        </h1>

        <p class="text-secondary small mb-0">
            Información de la institución y domicilio registrado.
        </p>
    </div>

    <!-- Mensaje de éxito -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 border-0 shadow-sm"
             role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["MensajeExito"]</span>
        </div>
    }

    <div class="row g-4">

        <!-- Datos de la institución -->
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="kpi-icon-box bg-primary-subtle text-corporate-primary">
                            <i class="bi bi-building"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold text-corporate-primary mb-1">
                                Datos de la Institución
                            </h5>
                            <small class="text-secondary">
                                Información identificatoria y de contacto.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card-body px-4 pb-4">

                    <form asp-controller="Institucion"
                          asp-action="MisDatos"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Nombre de la institución" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Cuit"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Cuit"
                                       class="form-control"
                                       placeholder="CUIT" />

                                <span asp-validation-for="Cuit"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Telefono"
                                       class="form-control"
                                       placeholder="Teléfono" />

                                <span asp-validation-for="Telefono"
                                      class="text-danger small">
                                </span>
                            </div>

                        </div>

                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="correo@institucion.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>
                        </div>

                        <hr class="border-light-subtle my-4" />

                        <!-- Domicilio -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-geo-alt text-teal fs-5"></i>

                            <div>
                                <h6 class="fw-bold text-corporate-primary mb-0">
                                    Domicilio
                                </h6>

                                <small class="text-secondary">
                                    Dirección física registrada de la institución.
                                </small>
                            </div>
                        </div>

                        <div class="row">

                            <div class="col-md-8 mb-3">
                                <label asp-for="Calle"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Calle"
                                       class="form-control"
                                       placeholder="Calle" />

                                <span asp-validation-for="Calle"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Numero"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Numero"
                                       class="form-control"
                                       placeholder="Número" />

                                <span asp-validation-for="Numero"
                                      class="text-danger small">
                                </span>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-5 mb-3">
                                <label asp-for="Localidad"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Localidad"
                                       class="form-control"
                                       placeholder="Localidad" />

                                <span asp-validation-for="Localidad"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Provincia"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Provincia"
                                       class="form-control"
                                       placeholder="Provincia" />

                                <span asp-validation-for="Provincia"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="CodigoPostal"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="CodigoPostal"
                                       class="form-control"
                                       placeholder="CP" />

                                <span asp-validation-for="CodigoPostal"
                                      class="text-danger small">
                                </span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit"
                                    class="btn btn-teal px-4 d-flex align-items-center gap-2">
                                <i class="bi bi-check-lg"></i>
                                Guardar Cambios
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>

        <!-- Información lateral -->
        <div class="col-12 col-xl-4">

            <div class="card border-0 shadow-sm rounded-3 mb-4">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="kpi-icon-box bg-teal-subtle-custom text-teal">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <h6 class="fw-bold text-corporate-primary mb-0">
                                Institución registrada
                            </h6>

                            <small class="text-secondary">
                                Datos asociados a tu cuenta.
                            </small>
                        </div>
                    </div>

                    <div class="bg-body-tertiary rounded-3 p-3">

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary small">
                                ID Institución
                            </span>

                            <strong class="font-monospace small">
                                #@Model.Id
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span class="text-secondary small">
                                CUIT
                            </span>

                            <strong class="font-monospace small">
                                @Model.Cuit
                            </strong>
                        </div>

                    </div>

                </div>

            </div>

            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-body p-4">

                    <h6 class="fw-bold text-corporate-primary mb-3">
                        <i class="bi bi-info-circle me-2 text-teal"></i>
                        Sobre estos datos
                    </h6>

                    <p class="text-secondary small mb-0">
                        Estos datos identifican a la institución dentro de
                        Vínculo y se utilizan para gestionar las solicitudes
                        de equipamiento y coordinar las entregas.
                    </p>

                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}