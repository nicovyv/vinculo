@model Vinculo.Models.ViewModels.CoincidenciasViewModel
@{
    ViewData["Title"] = "Coincidencias Geográficas";
}

<!-- Estilos específicos del mapa -->
<style>
    .font-tabular { font-variant-numeric: tabular-nums; }
    .badge-teal { background-color: rgba(14, 154, 167, 0.12); color: #007782; border: 1px solid rgba(14, 154, 167, 0.25); }
    .text-teal { color: #0E9AA7 !important; }
    .bg-teal { background-color: #0E9AA7 !important; }
    .map-container {
        position: relative; width: 100%; height: 480px;
        background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC_F2kMXWi_RrxLb64t5PmoxWryVFBta5wCNElbR2D2LnmnU3uENyoyU1DLLYjqxh9bYEj-acVk2TUPIM96DcuGxcNAIio6A5WZOnb5kfpCMpn9mmjNE_XHO17qukwUzouBVkENL9BlbCR8CNTVeWQTFdhlJGrW4JTolDWRynE3mhV0bX5dDzx7TwLmpxG34NkxINQvh7xSqfda6UONOB3yEHgfnD3Dst12Yt8lBSlYYM7ZUPUEiCm17g');
        background-size: cover; background-position: center; border-radius: 0.5rem; overflow: hidden;
    }
    .map-pin {
        position: absolute; transform: translate(-50%, -50%); cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .map-pin:hover { transform: translate(-50%, -50%) scale(1.15); z-index: 30; }
</style>

<div class="container-fluid p-4">
    <!-- Header Overview Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-3 bg-primary text-white d-flex align-items-center justify-content-center p-3 shadow-sm" style="width: 52px; height: 52px;">
                        <i class="bi bi-handshake fs-3 text-info"></i>
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 text-muted small text-uppercase fw-semibold mb-1">
                            <span>@Model.Empresa.RazonSocial</span>
                            <span>•</span>
                            <span class="font-tabular fw-bold text-primary">CUIT @Model.Empresa.Cuit</span>
                        </div>
                        <h1 class="h4 fw-bold text-primary mb-1">Coincidencias Geográficas — Donación #DON-@Model.Donacion.Id</h1>
                        <p class="text-secondary small mb-0">Se encontraron @Model.SolicitudesCompatibles.Count instituciones compatibles con tu donación de @Model.Donacion.Cantidad @Model.Donacion.Tipo.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultados -->
    <div class="row g-4" id="results-container">
        <!-- Columna de Tarjetas -->
<div class="col-lg-7" id="cards-column">
    <div class="d-flex flex-column gap-3">
        @if(Model.SolicitudesCompatibles.Any())
        {
            int index = 1;
            foreach (var item in Model.SolicitudesCompatibles)
            {
                var solicitud = item.Solicitud;
                var detalleCompatible = solicitud.Equipamientos.FirstOrDefault(e => e.TipoEquipamiento == Model.Donacion.Tipo);
                
                // Formateo visual: Si no hay datos de GPS muestra "N/D", sino muestra con 1 decimal
                var distanciaVisual = item.DistanciaKm == double.MaxValue ? "N/D" : item.DistanciaKm.ToString("0.0");
                
                <div class="card shadow-sm border-0 border-top border-4 border-info">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="d-flex gap-3">
                                <span class="rounded bg-light border fw-bold fs-5 text-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                    @index
                                </span>
                                <div>
                                    <h2 class="h5 fw-bold text-primary mb-1">@solicitud.Institucion.Nombre</h2>
                                    <p class="text-secondary small mb-0">
                                        <i class="bi bi-geo-alt-fill text-muted me-1"></i>
                                        @(solicitud.Institucion.Domicilio?.Calle) @(solicitud.Institucion.Domicilio?.Numero), @(solicitud.Institucion.Domicilio?.Localidad)
                                    </p>
                                </div>
                            </div>
                            <div class="bg-light p-2 rounded text-end border" style="min-width: 100px;">
                                <span class="font-tabular fs-5 fw-bold text-teal d-block">@distanciaVisual km</span>
                                <span class="text-muted text-uppercase" style="font-size: 0.65rem;">Distancia Directa</span>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 mt-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-2 small text-secondary">
                                <span>Solicitud compatible:</span>
                                <span class="font-tabular fw-semibold text-primary">@solicitud.NumeroReferencia</span>
                            </div>
                            <div class="p-2 bg-white rounded border d-flex justify-content-between align-items-center small">
                                <span><i class="bi bi-check-circle-fill text-teal me-1"></i>Requiere: @detalleCompatible?.Cantidad @detalleCompatible?.TipoEquipamiento</span>
                                <span class="fw-bold text-teal">Ofreces: @Model.Donacion.Cantidad</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                            <div class="small text-secondary">
                                <span>CUIT: <strong class="text-dark">@solicitud.Institucion.Cuit</strong></span>
                            </div>
                            <button class="btn btn-primary btn-sm fw-semibold" type="button">
                                <i class="bi bi-check2-all me-1"></i>Asignar
                            </button>
                        </div>
                    </div>
                </div>
                index++;
            }
        }
        else
        {
            <div class="alert alert-info">No se encontraron instituciones que requieran este equipamiento en este momento.</div>
        }
    </div>
</div>

        <!-- Columna del Mapa (Estático por ahora, como lo hizo Stitch) -->
        <div class="col-lg-5" id="map-column">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-map text-primary fs-5"></i>
                        <span class="fw-bold text-primary">Mapa de Distribución</span>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="map-container border">
                        <div class="map-pin" style="top: 50%; left: 50%;">
                            <div class="badge rounded-circle bg-primary text-white p-2 shadow d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                <i class="bi bi-building"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>