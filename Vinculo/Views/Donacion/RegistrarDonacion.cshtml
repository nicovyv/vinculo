@model Vinculo.Models.ViewModels.RegistrarDonacionViewModel
@{
    ViewData["Title"] = "Registrar Donación";
}

<div class="d-flex flex-column w-100 pb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a class="text-decoration-none fw-semibold" asp-controller="Empresa" asp-action="Index" style="color: #0e9aa7;"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
            <li class="breadcrumb-item"><a class="text-decoration-none text-secondary" href="#">Mis Donaciones</a></li>
            <li aria-current="page" class="breadcrumb-item active text-dark fw-semibold">Registrar Donación</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-3 p-md-4 rounded-3 shadow-sm border border-light-subtle">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0 text-dark" style="letter-spacing: -0.02em;">Registrar Donación de Equipamiento</h1>
                <span class="badge rounded-pill bg-light text-primary border border-primary-subtle fw-semibold px-3 py-2 font-monospace">
                    #DON-NUEVA <span class="badge bg-secondary ms-1">Borrador</span>
                </span>
            </div>
            <p class="text-secondary small mb-0">Cargue el inventario tecnológico para iniciar el motor de georreferenciación y remito institucional.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill d-inline-flex align-items-center gap-2 px-3 py-2 text-success-emphasis border" style="background-color: #d1fae5; border-color: #a7f3d0 !important;">
                <i class="bi bi-shield-check fs-6 text-success"></i>
                <span>Cumplimiento AFIP: <strong>RG 2681</strong></span>
            </span>
        </div>
    </div>

    <!-- INICIO DEL FORMULARIO -->
    <form asp-action="CrearDonacion" method="post" enctype="multipart/form-data" id="formDonacion">
        <div class="row g-4">

            <!-- COLUMNA IZQUIERDA: DATOS -->
            <div class="col-lg-8">

                <!-- Tarjeta 1: Empresa (Estática visualmente para el despachante) -->
                <div class="card border border-light-subtle shadow-sm mb-4 rounded-3">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom border-light-subtle">
                        <div class="d-flex align-items-center gap-2">
                            <span class="d-inline-flex align-items-center justify-content-center text-white rounded-circle fw-bold" style="width: 28px; height: 28px; background-color: #0f2a47;">1</span>
                            <h2 class="h6 fw-bold mb-0 text-dark">Centro de Despacho Logístico</h2>
                        </div>
                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2.5 py-1 small">
                            <i class="bi bi-check2-circle me-1"></i>Verificado
                        </span>
                    </div>
                    <div class="card-body p-4">
                        <div class="p-3 rounded-3" style="background-color: #f8f9ff; border: 1px solid #d5e3fc;">
                            <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                                <label class="form-label small fw-bold text-dark mb-0">
                                    <i class="bi bi-geo-alt-fill me-1" style="color: #0e9aa7;"></i>Ubicación de Retiro
                                </label>
                            </div>
                            <div class="row g-2 align-items-center bg-white p-2 rounded-2 border border-light-subtle">
                                <div class="col-auto">
                                    <span class="badge py-2 px-3 text-white rounded-2" style="background-color: #0f2a47;">
                                        <i class="bi bi-radar me-1"></i> Nodo Activo
                                    </span>
                                </div>
                                <div class="col">
                                    <p class="small text-secondary mb-0">
                                        Se utilizará el domicilio corporativo registrado en tu perfil para calcular las distancias.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta 2: Formulario del Equipo (Conectado al ViewModel) -->
                <div class="card border border-light-subtle shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom border-light-subtle">
                        <div class="d-flex align-items-center gap-2">
                            <span class="d-inline-flex align-items-center justify-content-center text-white rounded-circle fw-bold" style="width: 28px; height: 28px; background-color: #0f2a47;">2</span>
                            <h2 class="h6 fw-bold mb-0 text-dark">Detalles del Equipamiento a Donar</h2>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Tipo" class="form-label small fw-semibold text-secondary mb-1">Tipo de Equipamiento *</label>
                                <select asp-for="Tipo" class="form-select fw-semibold text-dark" asp-items="Html.GetEnumSelectList<Vinculo.Models.Enums.TipoEquipamiento>()">
                                    <option value="">Seleccione categoría...</option>
                                </select>
                                <span asp-validation-for="Tipo" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FotoArchivo" class="form-label small fw-semibold text-secondary mb-1">Fotografía del equipo (Opcional)</label>
                                <input asp-for="FotoArchivo" type="file" class="form-control" accept="image/*" />
                                <span asp-validation-for="FotoArchivo" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Descripcion" class="form-label small fw-semibold text-secondary mb-1">Descripción y Estado Técnico *</label>
                                <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Ej: Notebook Lenovo T490. Funcional 100%. Incluye cargador original y borrado seguro Blancco OK." required></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: PANELES LATERALES -->
            <div class="col-lg-4">

                <!-- Tarjeta GeoNode -->
                <div class="card border-0 shadow-sm mb-4 rounded-3 text-white overflow-hidden" style="background: linear-gradient(145deg, #0f2a47 0%, #00181b 100%);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge rounded-pill text-white border border-light-subtle px-3 py-1" style="background-color: rgba(14, 154, 167, 0.35);">
                                <i class="bi bi-radar me-1"></i> Motor Eisbaer GeoNode
                            </span>
                            <span class="spinner-grow spinner-grow-sm text-info" role="status"></span>
                        </div>
                        <h3 class="h5 fw-bold mb-2">Matching Preventivo</h3>
                        <p class="small text-light-emphasis mb-3">
                            Al publicar, el algoritmo notificará automáticamente a las instituciones educativas dentro del radio operativo.
                        </p>
                    </div>
                </div>

                <!-- Tarjeta Protocolos -->
                <div class="card border border-light-subtle shadow-sm mb-4 rounded-3">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h3 class="h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-file-earmark-check me-2" style="color: #0e9aa7;"></i>Compromiso Eisbaer
                        </h3>
                    </div>
                    <div class="card-body p-3">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="checkDoD" required checked>
                            <label class="form-check-label small text-dark" for="checkDoD">
                                <strong>Borrado Seguro de Datos Certificado</strong>
                                <div class="text-secondary" style="font-size: 11px;">Garantizo que el equipo no posee información confidencial.</div>
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="checkTitularidad" required checked>
                            <label class="form-check-label small text-dark" for="checkTitularidad">
                                <strong>Titularidad Dominial de Activos</strong>
                                <div class="text-secondary" style="font-size: 11px;">Baja patrimonial legítima.</div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Submit -->
                <div class="card border border-light-subtle shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <button type="submit" id="btnSubmit" class="btn text-white w-100 py-3 fw-bold shadow mb-3 d-flex align-items-center justify-content-center gap-2" style="background-color: #0e9aa7; border: none; font-size: 15px;">
                            <i class="bi bi-broadcast fs-5"></i>
                            <span>Publicar Donación</span>
                        </button>
                        <div class="text-center">
                            <a class="text-decoration-none small text-danger hover-underline" asp-controller="Empresa" asp-action="Index">
                                <i class="bi bi-x-circle me-1"></i>Descartar y cancelar
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('formDonacion').addEventListener('submit', function (e) {
            if (this.checkValidity()) {
                const btn = document.getElementById('btnSubmit');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Registrando activo...';
                btn.classList.add('disabled');
            }
        });
    </script>
}