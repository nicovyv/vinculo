@using Vinculo.Models.Enums
@model IEnumerable<Vinculo.Models.Donacion>

@{
    ViewData["Title"] = "Mis Donaciones";

    var donaciones = Model.ToList();

    var totalDonaciones = donaciones.Count;
    var disponibles = donaciones.Count(d => d.Estado == EstadoDonacion.Disponible);
    var enLogistica = donaciones.Count(d => d.Estado == EstadoDonacion.Asignada);
    var totalUnidades = donaciones
        .Where(d => d.Estado != EstadoDonacion.Cancelada)
        .Sum(d => d.Equipamientos?.Sum(e => e.Cantidad) ?? 0);
}

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#0F2A47;">
                Mis Donaciones
            </h2>
            <p class="text-muted mb-0">
                Consultá tus lotes de donación, asignalos a instituciones y seguí el estado de cada entrega.
            </p>
        </div>

        <a asp-controller="Donacion"
           asp-action="RegistrarDonacion"
           class="btn text-white px-4"
           style="background-color:#0F2A47;">
            <i class="bi bi-plus-circle me-2"></i>
            Nueva donación
        </a>
    </div>

    <!-- Mensajes de resultado -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <!-- Indicadores -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Total histórico</div>
                        <h3 class="fw-bold mb-0">@totalDonaciones</h3>
                    </div>
                    <div class="rounded-3 p-3"
                         style="background:#E8EEF5;color:#0F2A47;">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Disponibles</div>
                        <h3 class="fw-bold mb-0">@disponibles</h3>
                    </div>
                    <div class="rounded-3 p-3 bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-broadcast fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">En logística</div>
                        <h3 class="fw-bold mb-0">@enLogistica</h3>
                    </div>
                    <div class="rounded-3 p-3 bg-info-subtle text-info-emphasis">
                        <i class="bi bi-truck fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Unidades donadas</div>
                        <h3 class="fw-bold mb-0">@totalUnidades</h3>
                    </div>
                    <div class="rounded-3 p-3 bg-success-subtle text-success-emphasis">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Listado -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1" style="color:#0F2A47;">
                        Donaciones registradas
                    </h5>
                    <p class="text-muted small mb-0">
                        Consultá el detalle, asigná lotes disponibles y gestioná las entregas de cada donación.
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-light border">
                    @totalDonaciones donaciones
                </span>
            </div>
        </div>

        <div class="card-body px-4 pb-4">

            @if (!donaciones.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-4 text-muted"></i>
                    <h5 class="mt-3 fw-bold">Todavía no tenés donaciones</h5>
                    <p class="text-muted">
                        Registrá un lote de donación para encontrar instituciones que necesiten equipamiento.
                    </p>
                    <a asp-controller="Donacion"
                       asp-action="RegistrarDonacion"
                       class="btn text-white"
                       style="background-color:#0F2A47;">
                        Registrar donación
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Referencia</th>
                                <th>Fecha</th>
                                <th>Equipamientos</th>
                                <th class="text-center">Unidades</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var donacion in donaciones)
                            {
                                var unidades = donacion.Equipamientos?.Sum(e => e.Cantidad) ?? 0;

                                <tr>
                                    <td>
                                        <span class="fw-semibold" style="color:#0F2A47;">
                                            @(string.IsNullOrWhiteSpace(donacion.NumeroReferencia)
                                                ? $"DON-{donacion.Id}"
                                                : donacion.NumeroReferencia)
                                        </span>
                                    </td>

                                    <td class="text-nowrap">
                                        @donacion.Fecha.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (donacion.Equipamientos != null && donacion.Equipamientos.Any())
                                        {
                                            <span>
                                                @string.Join(", ",
                                                    donacion.Equipamientos
                                                        .Select(d => d.TipoEquipamiento.ToString())
                                                        .Distinct()
                                                        .Take(2))
                                            </span>

                                            @if (donacion.Equipamientos
                                                .Select(d => d.TipoEquipamiento)
                                                .Distinct()
                                                .Count() > 2)
                                            {
                                                <span class="text-muted small"> y más</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin detalles</span>
                                        }
                                    </td>

                                    <td class="text-center fw-semibold">
                                        @unidades
                                    </td>

                                    <td>
                                        <div class="text-muted text-truncate"
                                             style="max-width: 220px;"
                                             title="@donacion.Descripcion">
                                            @donacion.Descripcion
                                        </div>
                                    </td>

                                    <td>
                                        @switch (donacion.Estado)
                                        {
                                            case EstadoDonacion.Disponible:
                                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">
                                                    <i class="bi bi-broadcast me-1"></i>
                                                    Disponible
                                                </span>
                                                break;

                                            case EstadoDonacion.Asignada:
                                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis">
                                                    <i class="bi bi-truck me-1"></i>
                                                    En logística
                                                </span>
                                                break;

                                            case EstadoDonacion.Entregada:
                                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Entregada
                                                </span>
                                                break;

                                            case EstadoDonacion.Cancelada:
                                                <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancelada
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-end align-items-center gap-2">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalDonacion-@donacion.Id">
                                                <i class="bi bi-eye me-1"></i>
                                                Detalle
                                            </button>

                                            @if (donacion.Estado == EstadoDonacion.Disponible)
                                            {
                                                <a asp-controller="Donacion"
                                                   asp-action="Coincidencias"
                                                   asp-route-id="@donacion.Id"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Buscar coincidencias y asignar">
                                                    <i class="bi bi-link-45deg"></i>
                                                </a>

                                                <a asp-controller="Donacion"
                                                   asp-action="Edit"
                                                   asp-route-id="@donacion.Id"
                                                   class="btn btn-sm btn-outline-secondary"
                                                   title="Editar donación">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <form asp-controller="Donacion"
                                                      asp-action="Cancelar"
                                                      asp-route-id="@donacion.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('¿Estás seguro de que querés cancelar esta donación?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Cancelar donación">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Información de seguimiento -->
    <div class="alert alert-light border mt-4 mb-0">
        <div class="d-flex gap-3 align-items-start">
            <i class="bi bi-info-circle fs-5" style="color:#0F2A47;"></i>
            <div>
                <strong style="color:#0F2A47;">Seguimiento de donaciones</strong>
                <p class="text-muted small mb-0 mt-1">
                    Podés consultar el estado, la institución asignada y los movimientos de cada donación desde el botón Detalle.
                    Las donaciones disponibles pueden asignarse, editarse o cancelarse; las asignaciones en logística pueden concretarse o cancelarse desde el modal de detalle.
                </p>
            </div>
        </div>
    </div>

</div>

<!-- Modales de detalle -->
@foreach (var donacion in donaciones)
{
    var asignacionActiva = donacion.Asignaciones?
        .OrderByDescending(a => a.Id)
        .FirstOrDefault(a => a.Estado == EstadoAsignacion.Activa)
        ?? donacion.Asignaciones?
            .OrderByDescending(a => a.Id)
            .FirstOrDefault();

    var institucion = asignacionActiva?.Solicitud?.Institucion;

    var domicilio = institucion?.Domicilio == null
        ? "Sin datos"
        : $"{institucion.Domicilio.Calle} {institucion.Domicilio.Numero}, {institucion.Domicilio.Localidad}";

    <div class="modal fade"
         id="modalDonacion-@donacion.Id"
         tabindex="-1"
         aria-labelledby="tituloDonacion-@donacion.Id"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">

                <div class="modal-header text-white"
                     style="background-color:#0F2A47;">

                    <div>
                        <h5 class="modal-title fw-bold"
                            id="tituloDonacion-@donacion.Id">
                            <i class="bi bi-box-seam me-2"></i>
                            Detalle de donación
                        </h5>

                        <small>
                            @(string.IsNullOrWhiteSpace(donacion.NumeroReferencia)
                                ? $"DON-{donacion.Id}"
                                : donacion.NumeroReferencia)
                        </small>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body p-4">

                    <!-- Datos generales -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <small class="text-muted d-block mb-1">
                                    Fecha de publicación
                                </small>
                                <strong>
                                    @donacion.Fecha.ToString("dd/MM/yyyy HH:mm")
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <small class="text-muted d-block mb-1">
                                    Estado actual
                                </small>

                                @switch (donacion.Estado)
                                {
                                    case EstadoDonacion.Disponible:
                                        <span class="badge bg-warning-subtle text-warning-emphasis">
                                            Disponible
                                        </span>
                                        break;

                                    case EstadoDonacion.Asignada:
                                        <span class="badge bg-info-subtle text-info-emphasis">
                                            En logística
                                        </span>
                                        break;

                                    case EstadoDonacion.Entregada:
                                        <span class="badge bg-success-subtle text-success-emphasis">
                                            Entregada
                                        </span>
                                        break;

                                    case EstadoDonacion.Cancelada:
                                        <span class="badge bg-danger-subtle text-danger-emphasis">
                                            Cancelada
                                        </span>
                                        break;
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="border rounded-3 p-3">
                                <small class="text-muted d-block mb-1">
                                    Descripción técnica
                                </small>
                                <span class="text-dark">
                                    @donacion.Descripcion
                                </span>
                            </div>
                        </div>

                    </div>

                    <!-- Equipamientos -->
                    <h6 class="fw-bold mb-3" style="color:#0F2A47;">
                        <i class="bi bi-pc-display me-2"></i>
                        Equipamientos del lote
                    </h6>

                    @if (donacion.Equipamientos != null && donacion.Equipamientos.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Equipamiento</th>
                                        <th class="text-center" style="width:140px;">
                                            Cantidad
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var detalle in donacion.Equipamientos)
                                    {
                                        <tr>
                                            <td>@detalle.TipoEquipamiento</td>
                                            <td class="text-center">
                                                @detalle.Cantidad
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                                <tfoot class="table-light">
                                    <tr>
                                        <th>Total de unidades</th>
                                        <th class="text-center">
                                            @donacion.Equipamientos.Sum(d => d.Cantidad)
                                        </th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4">
                            Esta donación no tiene equipamientos registrados.
                        </p>
                    }

                    <!-- Institución Asignada (si existe asignación) -->
                    @if (institucion != null &&
                         (donacion.Estado == EstadoDonacion.Asignada || donacion.Estado == EstadoDonacion.Entregada))
                    {
                        <hr class="my-4" />

                        <h6 class="fw-bold mb-3" style="color:#0F2A47;">
                            <i class="bi bi-building-check me-2"></i>
                            Institución asignada
                            @if (!string.IsNullOrWhiteSpace(asignacionActiva?.NumeroReferencia))
                            {
                                <span class="badge bg-light text-dark border ms-2 fw-normal">
                                    @asignacionActiva.NumeroReferencia
                                </span>
                            }
                        </h6>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="border rounded-3 p-3 h-100">
                                    <small class="text-muted d-block mb-1">Institución</small>
                                    <strong>@institucion.Nombre</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded-3 p-3 h-100">
                                    <small class="text-muted d-block mb-1">Persona de contacto</small>
                                    <strong>@(string.IsNullOrWhiteSpace(institucion.PersonaContacto) ? "Sin datos" : institucion.PersonaContacto)</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded-3 p-3 h-100">
                                    <small class="text-muted d-block mb-1">Correo electrónico</small>
                                    <span>@institucion.Email</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded-3 p-3 h-100">
                                    <small class="text-muted d-block mb-1">Teléfono</small>
                                    <span>@institucion.Telefono</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="border rounded-3 p-3">
                                    <small class="text-muted d-block mb-1">Domicilio de entrega</small>
                                    <span>@domicilio</span>
                                </div>
                            </div>
                        </div>
                    }

                    <hr class="my-4" />

                    <!-- Historial -->
                    <h6 class="fw-bold mb-3" style="color:#0F2A47;">
                        <i class="bi bi-clock-history me-2"></i>
                        Historial de movimientos
                    </h6>

                    @if (donacion.Observaciones != null &&
                         donacion.Observaciones.Any())
                    {
                        <div class="d-flex flex-column gap-3">

                            @foreach (var observacion in donacion.Observaciones
                                .OrderByDescending(o => o.Fecha))
                            {
                                <div class="border rounded-3 p-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-circle-fill"
                                           style="font-size:0.5rem;color:#0E9AA7;">
                                        </i>

                                        <small class="text-muted">
                                            @observacion.Fecha.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>

                                    <p class="mb-0" style="white-space:pre-wrap;">@observacion.Mensaje</p>
                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted border rounded-3 p-4">
                            <i class="bi bi-clock-history fs-3 d-block mb-2"></i>
                            <p class="mb-0">
                                Todavía no hay movimientos registrados para esta donación.
                            </p>
                        </div>
                    }

                </div>

                <div class="modal-footer d-flex flex-wrap justify-content-end gap-2">

                    @if (donacion.Estado == EstadoDonacion.Disponible)
                    {
                        <a asp-controller="Donacion"
                           asp-action="Coincidencias"
                           asp-route-id="@donacion.Id"
                           class="btn btn-success">
                            <i class="bi bi-link-45deg me-1"></i>
                            Asignar
                        </a>

                        <a asp-controller="Donacion"
                           asp-action="Edit"
                           asp-route-id="@donacion.Id"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-pencil me-1"></i>
                            Editar donación
                        </a>
                    }

                    @if (donacion.Estado == EstadoDonacion.Asignada &&
                         asignacionActiva != null &&
                         asignacionActiva.Estado == EstadoAsignacion.Activa)
                    {
                        <form asp-controller="Donacion"
                              asp-action="CancelarAsignacion"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('¿Estás seguro de que querés cancelar la asignación? La donación volverá a estar disponible y la solicitud de la institución volverá a pendiente.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="asignacionId" value="@asignacionActiva.Id" />
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancelar asignación
                            </button>
                        </form>

                        <form asp-controller="Donacion"
                              asp-action="ConfirmarEntrega"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('¿Confirmás que la donación fue entregada a la institución?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="asignacionId" value="@asignacionActiva.Id" />
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Confirmar entrega
                            </button>
                        </form>
                    }

                    <button type="button"
                            class="btn text-white"
                            style="background-color:#0F2A47;"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>

            </div>
        </div>
    </div>
}