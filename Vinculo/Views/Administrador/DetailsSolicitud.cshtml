@model Vinculo.Models.ViewModels.AdminSolicitudDetalleViewModel

@{
    ViewData["Title"] = "Detalle de Solicitud";

    var totalUnidades = Model.Equipamientos?.Sum(e => e.Cantidad) ?? 0;
    var totalTipos = Model.Equipamientos?.Count ?? 0;

    string NombreEstado(Vinculo.Models.Enums.EstadoSolicitud estado)
    {
        return estado switch
        {
            Vinculo.Models.Enums.EstadoSolicitud.Pendiente => "Pendiente",
            Vinculo.Models.Enums.EstadoSolicitud.EnCoordinacion => "En coordinación",
            Vinculo.Models.Enums.EstadoSolicitud.Concretado => "Concretada",
            Vinculo.Models.Enums.EstadoSolicitud.Cancelada => "Cancelada",
            _ => estado.ToString()
        };
    }

    string ClaseEstado(Vinculo.Models.Enums.EstadoSolicitud estado)
    {
        return estado switch
        {
            Vinculo.Models.Enums.EstadoSolicitud.Pendiente =>
                "bg-warning-subtle text-warning-emphasis border-warning-subtle",

            Vinculo.Models.Enums.EstadoSolicitud.EnCoordinacion =>
                "bg-info-subtle text-info-emphasis border-info-subtle",

            Vinculo.Models.Enums.EstadoSolicitud.Concretado =>
                "bg-success-subtle text-success border-success-subtle",

            Vinculo.Models.Enums.EstadoSolicitud.Cancelada =>
                "bg-danger-subtle text-danger border-danger-subtle",

            _ =>
                "bg-light text-secondary border-secondary-subtle"
        };
    }

    string IconoEstado(Vinculo.Models.Enums.EstadoSolicitud estado)
    {
        return estado switch
        {
            Vinculo.Models.Enums.EstadoSolicitud.Pendiente =>
                "bi-clock-history",

            Vinculo.Models.Enums.EstadoSolicitud.EnCoordinacion =>
                "bi-arrow-left-right",

            Vinculo.Models.Enums.EstadoSolicitud.Concretado =>
                "bi-check-circle",

            Vinculo.Models.Enums.EstadoSolicitud.Cancelada =>
                "bi-x-circle",

            _ =>
                "bi-info-circle"
        };
    }
}


<!-- ========================================================= -->
<!-- BREADCRUMB -->
<!-- ========================================================= -->

<nav aria-label="breadcrumb" class="mb-3">

    <ol class="breadcrumb mb-0 py-1 small">

        <li class="breadcrumb-item">

            <a asp-controller="Administrador"
               asp-action="Index"
               class="text-decoration-none fw-medium text-secondary">

                <i class="bi bi-house-door me-1"></i>
                Panel de Control

            </a>

        </li>

        <li class="breadcrumb-item">

            <a asp-controller="Administrador"
               asp-action="Solicitudes"
               class="text-decoration-none fw-medium text-secondary">

                Solicitudes

            </a>

        </li>

        <li class="breadcrumb-item active text-dark fw-semibold"
            aria-current="page">

            @Model.NumeroReferencia

        </li>

    </ol>

</nav>


<!-- ========================================================= -->
<!-- ENCABEZADO -->
<!-- ========================================================= -->

<div class="bg-white rounded-3 p-4 shadow-sm border mb-4"
     style="border-color:#E2E8F0;">

    <div class="d-flex flex-column flex-lg-row
        justify-content-between align-items-lg-center gap-3">

        <div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

                <h1 class="h3 fw-bold mb-0 text-dark"
                    style="color:#0F2A47;">

                    Solicitud #@Model.NumeroReferencia

                </h1>


                <span class="badge rounded-pill @ClaseEstado(Model.Estado) px-3 py-2">

                    <i class="bi @IconoEstado(Model.Estado) me-1"></i>

                    @NombreEstado(Model.Estado)

                </span>

            </div>


            <p class="text-muted small mb-0 d-flex align-items-center gap-3 flex-wrap">

                <span>

                    <i class="bi bi-calendar3 me-1 text-primary"></i>

                    Fecha de registro:

                    <strong class="text-dark">
                        @Model.Fecha.ToString("dd/MM/yyyy")
                    </strong>

                </span>


                <span class="text-secondary">
                    •
                </span>


                <span>

                    <i class="bi bi-box-seam me-1 text-primary"></i>

                    @totalTipos tipo@(totalTipos == 1 ? "" : "s")
                    de equipamiento

                </span>


                <span class="text-secondary">
                    •
                </span>


                <span>

                    <i class="bi bi-hash me-1 text-primary"></i>

                    @totalUnidades unidad@(totalUnidades == 1 ? "" : "es")

                </span>

            </p>

        </div>


        <div class="d-flex align-items-center gap-2">

            <a asp-controller="Administrador"
               asp-action="Solicitudes"
               class="btn btn-outline-secondary d-inline-flex
                align-items-center gap-2 px-3 py-2 shadow-sm">

                <i class="bi bi-arrow-left"></i>

                <span class="fw-semibold small">
                    Volver a Solicitudes
                </span>

            </a>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- RESUMEN -->
<!-- ========================================================= -->

<div class="row g-4 mb-4">


    <!-- EQUIPAMIENTOS -->

    <div class="col-12 col-md-4">

        <div class="card border-0 shadow-sm h-100"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="rounded-3 d-flex align-items-center
                        justify-content-center"
                         style="width:48px;height:48px;
                        background:#EAF8FA;color:#0E9AA7;">

                        <i class="bi bi-box-seam fs-4"></i>

                    </div>


                    <div>

                        <div class="text-muted small">
                            Tipos de equipamiento
                        </div>

                        <div class="h4 fw-bold mb-0"
                             style="color:#0F2A47;">

                            @totalTipos

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- UNIDADES -->

    <div class="col-12 col-md-4">

        <div class="card border-0 shadow-sm h-100"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="rounded-3 d-flex align-items-center
                        justify-content-center"
                         style="width:48px;height:48px;
                        background:#EFF4FF;color:#0F2A47;">

                        <i class="bi bi-stack fs-4"></i>

                    </div>


                    <div>

                        <div class="text-muted small">
                            Unidades solicitadas
                        </div>

                        <div class="h4 fw-bold mb-0"
                             style="color:#0F2A47;">

                            @totalUnidades

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- FECHA -->

    <div class="col-12 col-md-4">

        <div class="card border-0 shadow-sm h-100"
             style="border:1px solid #E2E8F0 !important;">

            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="rounded-3 d-flex align-items-center
                        justify-content-center"
                         style="width:48px;height:48px;
                        background:#F1F5F9;color:#515F74;">

                        <i class="bi bi-calendar-check fs-4"></i>

                    </div>


                    <div>

                        <div class="text-muted small">
                            Fecha
                        </div>

                        <div class="fw-bold"
                             style="color:#0F2A47;">

                            @Model.Fecha.ToString("dd/MM/yyyy")

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- INFORMACIÓN DE LA SOLICITUD -->
<!-- ========================================================= -->

<div class="card shadow-sm border-0 mb-4"
     style="border:1px solid #E2E8F0 !important;">

    <div class="card-header bg-white py-3 border-bottom"
         style="border-color:#F1F5F9 !important;">

        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center gap-2">

                <i class="bi bi-file-earmark-text fs-5 text-primary"></i>

                <h6 class="mb-0 fw-bold text-dark">
                    Información de la Solicitud
                </h6>

            </div>

            <span class="small text-muted">
                Datos generales
            </span>

        </div>

    </div>


    <div class="card-body p-4">

        <div class="row g-4">

            <div class="col-12 col-md-4">

                <div class="text-muted small mb-1">
                    Número de referencia
                </div>

                <div class="fw-bold text-dark">
                    @Model.NumeroReferencia
                </div>

            </div>


            <div class="col-12 col-md-4">

                <div class="text-muted small mb-1">
                    Fecha de registro
                </div>

                <div class="fw-semibold text-dark">
                    @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                </div>

            </div>


            <div class="col-12 col-md-4">

                <div class="text-muted small mb-1">
                    Estado actual
                </div>

                <span class="badge rounded-pill @ClaseEstado(Model.Estado) px-3 py-2">

                    <i class="bi @IconoEstado(Model.Estado) me-1"></i>

                    @NombreEstado(Model.Estado)

                </span>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- INSTITUCIÓN -->
<!-- ========================================================= -->

<div class="card shadow-sm border-0 mb-4"
     style="border:1px solid #E2E8F0 !important;">

    <div class="card-header bg-white py-3 border-bottom"
         style="border-color:#F1F5F9 !important;">

        <div class="d-flex align-items-center gap-2">

            <i class="bi bi-building fs-5 text-primary"></i>

            <div>

                <h6 class="mb-0 fw-bold text-dark">
                    Institución Solicitante
                </h6>

                <small class="text-muted">
                    Datos de la institución que realizó la solicitud
                </small>

            </div>

        </div>

    </div>


    <div class="card-body p-4">

        <div class="row g-4">

            <!-- Nombre -->

            <div class="col-12 col-md-6">

                <div class="text-muted small mb-1">
                    Institución
                </div>

                <div class="d-flex align-items-center gap-3">

                    <div class="rounded-3 d-flex align-items-center
                        justify-content-center"
                         style="width:44px;height:44px;
                        background:#EFF4FF;color:#0F2A47;">

                        <i class="bi bi-building fs-5"></i>

                    </div>

                    <div>

                        <div class="fw-bold text-dark">
                            @Model.Institucion
                        </div>

                        <small class="text-muted">
                            Institución registrada
                        </small>

                    </div>

                </div>

            </div>


            <!-- CUIT -->

            <div class="col-12 col-md-6">

                <div class="text-muted small mb-1">
                    CUIT
                </div>

                <div class="fw-semibold text-dark">

                    <i class="bi bi-card-text me-1 text-primary"></i>

                    @Model.Cuit

                </div>

            </div>


            <!-- EMAIL -->

            <div class="col-12 col-md-6">

                <div class="text-muted small mb-1">
                    Email
                </div>

                <div class="fw-semibold text-dark">

                    <i class="bi bi-envelope me-1 text-primary"></i>

                    @Model.Email

                </div>

            </div>


            <!-- TELÉFONO -->

            <div class="col-12 col-md-6">

                <div class="text-muted small mb-1">
                    Teléfono
                </div>

                <div class="fw-semibold text-dark">

                    <i class="bi bi-telephone me-1 text-primary"></i>

                    @Model.Telefono

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- DOMICILIO -->
<!-- ========================================================= -->

<div class="card shadow-sm border-0 mb-4"
     style="border:1px solid #E2E8F0 !important;">

    <div class="card-header bg-white py-3 border-bottom"
         style="border-color:#F1F5F9 !important;">

        <div class="d-flex align-items-center gap-2">

            <i class="bi bi-geo-alt fs-5 text-primary"></i>

            <div>

                <h6 class="mb-0 fw-bold text-dark">
                    Domicilio de la Institución
                </h6>

                <small class="text-muted">
                    Ubicación registrada
                </small>

            </div>

        </div>

    </div>


    <div class="card-body p-4">

        <div class="row g-4">

            <!-- CALLE -->

            <div class="col-12 col-md-6">

                <div class="text-muted small mb-1">
                    Calle
                </div>

                <div class="fw-semibold text-dark">
                    @Model.Calle @Model.Numero
                </div>

            </div>


            <!-- LOCALIDAD -->

            <div class="col-12 col-md-3">

                <div class="text-muted small mb-1">
                    Localidad
                </div>

                <div class="fw-semibold text-dark">
                    @Model.Localidad
                </div>

            </div>


            <!-- CP -->

            <div class="col-12 col-md-3">

                <div class="text-muted small mb-1">
                    Código postal
                </div>

                <div class="fw-semibold text-dark">
                    @Model.CodigoPostal
                </div>

            </div>


            <!-- PROVINCIA -->

            <div class="col-12 col-md-6">

                <div class="text-muted small mb-1">
                    Provincia
                </div>

                <div class="fw-semibold text-dark">
                    @Model.Provincia
                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- EQUIPAMIENTO -->
<!-- ========================================================= -->

<div class="card shadow-sm border-0 mb-4"
     style="border:1px solid #E2E8F0 !important;">

    <div class="card-header bg-white py-3 border-bottom"
         style="border-color:#F1F5F9 !important;">

        <div class="d-flex flex-column flex-md-row
            align-items-md-center justify-content-between gap-2">

            <div class="d-flex align-items-center gap-2">

                <i class="bi bi-pc-display-horizontal fs-5 text-primary"></i>

                <div>

                    <h6 class="mb-0 fw-bold text-dark">
                        Equipamiento Solicitado
                    </h6>

                    <small class="text-muted">
                        Detalle de los equipos requeridos
                    </small>

                </div>

            </div>


            <div class="d-flex gap-2">

                <span class="badge bg-light text-secondary border">

                    @totalTipos
                    tipo@(totalTipos == 1 ? "" : "s")

                </span>


                <span class="badge bg-primary-subtle text-primary-emphasis">

                    @totalUnidades
                    unidad@(totalUnidades == 1 ? "" : "es")

                </span>

            </div>

        </div>

    </div>


    <div class="card-body p-0">

        @if (Model.Equipamientos != null && Model.Equipamientos.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light text-secondary small text-uppercase"
                           style="font-size:.72rem;letter-spacing:.03em;">

                        <tr>

                            <th class="ps-4 py-3">
                                Tipo de equipamiento
                            </th>

                            <th class="text-center py-3">
                                Cantidad solicitada
                            </th>

                            <th class="pe-4 py-3 text-end">
                                Estado
                            </th>

                        </tr>

                    </thead>


                    <tbody class="text-dark small">

                        @foreach (var detalle in Model.Equipamientos)
                        {
                            <tr>

                                <td class="ps-4 py-3">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="p-2 rounded bg-light border
                                            d-flex align-items-center
                                            justify-content-center"
                                             style="width:42px;height:42px;">

                                            <i class="bi bi-laptop text-primary fs-5"></i>

                                        </div>


                                        <div>

                                            <div class="fw-bold text-dark">
                                                @detalle.TipoEquipamiento
                                            </div>

                                            <div class="text-muted"
                                                 style="font-size:.75rem;">

                                                Equipamiento tecnológico solicitado

                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <td class="text-center py-3">

                                    <span class="badge bg-light text-dark border px-3 py-2">

                                        @detalle.Cantidad
                                        u.

                                    </span>

                                </td>


                                <td class="pe-4 py-3 text-end">

                                    @switch (Model.Estado)
                                    {
                                        case Vinculo.Models.Enums.EstadoSolicitud.Pendiente:

                                            <span class="badge rounded-pill
                                                bg-warning-subtle
                                                text-warning-emphasis
                                                border border-warning-subtle">

                                                <i class="bi bi-clock me-1"></i>
                                                Pendiente

                                            </span>

                                            break;


                                        case Vinculo.Models.Enums.EstadoSolicitud.EnCoordinacion:

                                            <span class="badge rounded-pill
                                                bg-info-subtle
                                                text-info-emphasis
                                                border border-info-subtle">

                                                <i class="bi bi-arrow-left-right me-1"></i>
                                                En coordinación

                                            </span>

                                            break;


                                        case Vinculo.Models.Enums.EstadoSolicitud.Concretado:

                                            <span class="badge rounded-pill
                                                bg-success-subtle
                                                text-success
                                                border border-success-subtle">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Concretado

                                            </span>

                                            break;


                                        case Vinculo.Models.Enums.EstadoSolicitud.Cancelada:

                                            <span class="badge rounded-pill
                                                bg-danger-subtle
                                                text-danger
                                                border border-danger-subtle">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Solicitud cancelada

                                            </span>

                                            break;
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>


                    <tfoot class="table-light">

                        <tr>

                            <th class="ps-4 py-3">
                                Total solicitado
                            </th>

                            <th class="text-center py-3">

                                <span class="fw-bold"
                                      style="color:#0F2A47;">

                                    @totalUnidades

                                </span>

                            </th>

                            <th class="pe-4 py-3 text-end">

                                <span class="small text-muted">
                                    @totalTipos tipo@(totalTipos == 1 ? "" : "s")
                                </span>

                            </th>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">

                <i class="bi bi-inbox fs-1 d-block mb-3"></i>

                <div class="fw-semibold">
                    No hay equipamientos registrados.
                </div>

                <div class="small mt-1">
                    Esta solicitud no tiene detalles asociados.
                </div>

            </div>
        }

    </div>

</div>


<!-- ========================================================= -->
<!-- TRAZABILIDAD -->
<!-- ========================================================= -->

<div class="card shadow-sm border-0 mb-4"
     style="border:1px solid #E2E8F0 !important;">

    <div class="card-header bg-white py-3 border-bottom"
         style="border-color:#F1F5F9 !important;">

        <div class="d-flex align-items-center gap-2">

            <i class="bi bi-diagram-3-fill fs-5 text-primary"></i>

            <div>

                <h6 class="mb-0 fw-bold text-dark">
                    Seguimiento de la Solicitud
                </h6>

                <small class="text-muted">
                    Evolución del proceso
                </small>

            </div>

        </div>

    </div>


    <div class="card-body p-4">


        <!-- REGISTRADA -->

        <div class="d-flex align-items-start gap-3">

            <div class="rounded-circle d-flex align-items-center
                justify-content-center flex-shrink-0"
                 style="width:42px;height:42px;
                background:#EAF8FA;color:#0E9AA7;">

                <i class="bi bi-check-lg"></i>

            </div>


            <div>

                <div class="fw-bold text-dark">
                    Solicitud registrada
                </div>

                <div class="text-muted small mt-1">
                    La solicitud fue registrada correctamente en el sistema.
                </div>

                <div class="text-muted small mt-1">
                    @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                </div>

            </div>

        </div>


        <div class="ms-3 my-2"
             style="height:30px;border-left:2px solid #E2E8F0;">
        </div>


        <!-- ESTADO ACTUAL -->

        <div class="d-flex align-items-start gap-3">

            <div class="rounded-circle d-flex align-items-center
                justify-content-center flex-shrink-0"
                 style="width:42px;height:42px;
                background:#EFF4FF;color:#0F2A47;">

                <i class="bi @IconoEstado(Model.Estado)"></i>

            </div>


            <div>

                <div class="fw-bold text-dark">
                    @NombreEstado(Model.Estado)
                </div>

                <div class="text-muted small mt-1">

                    @switch (Model.Estado)
                    {
                        case Vinculo.Models.Enums.EstadoSolicitud.Pendiente:

                            <text>
                                La solicitud se encuentra pendiente de asignación de equipamiento.
                            </text>

                            break;


                        case Vinculo.Models.Enums.EstadoSolicitud.EnCoordinacion:

                            <text>
                                La solicitud se encuentra en proceso de coordinación.
                            </text>

                            break;


                        case Vinculo.Models.Enums.EstadoSolicitud.Concretado:

                            <text>
                                La solicitud fue concretada.
                            </text>

                            break;


                        case Vinculo.Models.Enums.EstadoSolicitud.Cancelada:

                            <text>
                                La solicitud fue cancelada y permanece registrada en el historial.
                            </text>

                            break;
                    }

                </div>


                <span class="badge rounded-pill @ClaseEstado(Model.Estado) mt-2">

                    <i class="bi @IconoEstado(Model.Estado) me-1"></i>

                    @NombreEstado(Model.Estado)

                </span>

            </div>

        </div>


        <div class="ms-3 my-2"
             style="height:30px;border-left:2px solid #E2E8F0;">
        </div>


        <!-- ASIGNACIÓN -->

        <div class="d-flex align-items-start gap-3">

            <div class="rounded-circle d-flex align-items-center
                justify-content-center flex-shrink-0"
                 style="width:42px;height:42px;
                background:#F1F5F9;color:#64748B;">

                <i class="bi bi-link-45deg"></i>

            </div>


            <div>

                <div class="fw-bold text-secondary">
                    Donación y asignación
                </div>

                <div class="text-muted small mt-1">
                    La información sobre donaciones y asignaciones
                    estará disponible cuando se incorpore esa funcionalidad.
                </div>

                <span class="badge bg-light text-secondary border mt-2">
                    Próximamente
                </span>

            </div>

        </div>


        <div class="ms-3 my-2"
             style="height:30px;border-left:2px solid #E2E8F0;">
        </div>


        <!-- LOGÍSTICA -->

        <div class="d-flex align-items-start gap-3">

            <div class="rounded-circle d-flex align-items-center
                justify-content-center flex-shrink-0"
                 style="width:42px;height:42px;
                background:#F1F5F9;color:#64748B;">

                <i class="bi bi-truck"></i>

            </div>


            <div>

                <div class="fw-bold text-secondary">
                    Logística y entrega
                </div>

                <div class="text-muted small mt-1">
                    El seguimiento de la entrega estará disponible
                    cuando se implemente la gestión logística.
                </div>

                <span class="badge bg-light text-secondary border mt-2">
                    Próximamente
                </span>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- SECCIONES FUTURAS -->
<!-- ========================================================= -->

<div class="row g-4 mb-4">


    <!-- DONACIÓN -->

    <div class="col-12 col-lg-6">

