@model Vinculo.Models.ViewModels.AdminSolicitudViewModel

@{
    ViewData["Title"] = "Solicitudes";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold text-corporate-primary mb-1">
                Solicitudes
            </h1>

            <p class="text-secondary mb-0">
                Administración y seguimiento de las solicitudes de equipamiento.
            </p>
        </div>

        <div>
            <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-2">
                @Model.Solicitudes.Count solicitud@(Model.Solicitudes.Count == 1 ? "" : "es")
            </span>
        </div>

    </div>


    <!-- Mensajes -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-3">

            <form asp-controller="Administrador"
                  asp-action="Solicitudes"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Búsqueda -->
                    <div class="col-12 col-lg-7">

                        <label for="busqueda"
                               class="form-label small fw-semibold text-secondary">
                            Buscar solicitud
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="busqueda"
                                   name="busqueda"
                                   value="@Model.Busqueda"
                                   class="form-control"
                                   placeholder="Número de referencia o institución..." />

                        </div>

                    </div>


                    <!-- Estado -->
                    <div class="col-12 col-md-6 col-lg-3">

                        <label for="estado"
                               class="form-label small fw-semibold text-secondary">
                            Estado
                        </label>

                        <select id="estado"
                                name="estado"
                                class="form-select">

                            <option value="">Todos los estados</option>

                            @foreach (var estado in Enum.GetValues<Vinculo.Models.Enums.EstadoSolicitud>())
                            {
                                <option value="@estado"
                                        selected="@(Model.EstadoFiltro == estado.ToString() ? "selected" : null)">
                                    @estado
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Botones -->
                    <div class="col-12 col-md-6 col-lg-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">

                            <i class="bi bi-funnel me-1"></i>
                            Filtrar

                        </button>

                        <a asp-controller="Administrador"
                           asp-action="Solicitudes"
                           class="btn btn-outline-secondary"
                           title="Limpiar filtros">

                            <i class="bi bi-x-lg"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Tabla -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex align-items-center justify-content-between">

                <div>

                    <h2 class="h6 fw-bold mb-0">
                        Solicitudes registradas
                    </h2>

                    <small class="text-secondary">
                        Solicitudes realizadas por las instituciones.
                    </small>

                </div>

                <i class="bi bi-card-checklist text-secondary fs-4"></i>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Solicitudes.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4" style="min-width: 150px;">
                                    Referencia
                                </th>

                                <th style="min-width: 220px;">
                                    Institución
                                </th>

                                <th style="min-width: 120px;">
                                    Fecha
                                </th>

                                <th class="text-center" style="min-width: 160px;">
                                    Equipamientos
                                </th>

                                <th class="text-center" style="min-width: 140px;">
                                    Estado
                                </th>

                                <th class="text-end pe-4" style="min-width: 130px;">
                                    Acción
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var solicitud in Model.Solicitudes)
                            {
                                <tr>

                                    <!-- Referencia -->
                                    <td class="ps-4">

                                        <div class="fw-semibold text-corporate-primary">
                                            @solicitud.NumeroReferencia
                                        </div>

                                        <small class="text-secondary">
                                            ID #@solicitud.Id
                                        </small>

                                    </td>


                                    <!-- Institución -->
                                    <td>

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="rounded-circle bg-primary-subtle text-primary
                                                d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width: 36px; height: 36px;">

                                                <i class="bi bi-building"></i>

                                            </div>

                                            <span class="fw-semibold">
                                                @solicitud.Institucion
                                            </span>

                                        </div>

                                    </td>


                                    <!-- Fecha -->
                                    <td>

                                        <span class="small">
                                            @solicitud.Fecha.ToString("dd/MM/yyyy")
                                        </span>

                                    </td>


                                    <!-- Equipamientos -->
                                    <td class="text-center">

                                        <div class="fw-bold text-corporate-primary">
                                            @solicitud.CantidadEquipamientos
                                            @(solicitud.CantidadEquipamientos == 1 ? "unidad" : "unidades")
                                        </div>

                                        <small class="text-secondary">
                                            @solicitud.CantidadTipos
                                            @(solicitud.CantidadTipos == 1 ? "tipo" : "tipos")
                                        </small>

                                    </td>


                                    <!-- Estado -->
                                    <td class="text-center">

                                        @switch (solicitud.Estado)
                                        {
                                            case Vinculo.Models.Enums.EstadoSolicitud.Pendiente:

                                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">

                                                    <i class="bi bi-clock me-1"></i>
                                                    Pendiente

                                                </span>

                                                break;


                                            case Vinculo.Models.Enums.EstadoSolicitud.EnCoordinacion:

                                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis">

                                                    <i class="bi bi-arrow-repeat me-1"></i>
                                                    En coordinación

                                                </span>

                                                break;


                                            case Vinculo.Models.Enums.EstadoSolicitud.Concretado:

                                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis">

                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Concretada

                                                </span>

                                                break;


                                            default:

                                                <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">
                                                    @solicitud.Estado
                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- Acción -->
                                    <td class="text-end pe-4">

                                        <a asp-controller="Administrador"
                                           asp-action="DetailsSolicitud"
                                           asp-route-id="@solicitud.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            Ver detalle

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Sin resultados -->

                <div class="text-center py-5 px-3">

                    <div class="rounded-circle bg-primary-subtle text-primary
                        d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px;">

                        <i class="bi bi-card-checklist fs-3"></i>

                    </div>

                    <h3 class="h5 fw-bold">
                        No se encontraron solicitudes
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda) ||
                         !string.IsNullOrWhiteSpace(Model.EstadoFiltro))
                    {
                        <p class="text-secondary mb-3">
                            No hay solicitudes que coincidan con los filtros seleccionados.
                        </p>

                        <a asp-controller="Administrador"
                           asp-action="Solicitudes"
                           class="btn btn-outline-secondary btn-sm">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Ver todas

                        </a>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">
                            Todavía no hay solicitudes registradas.
                        </p>
                    }

                </div>
            }

        </div>

    </div>

</div>
