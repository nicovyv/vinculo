@model Vinculo.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-teal-subtle-custom rounded-pill px-3 py-2">
                    <i class="bi bi-shield-check me-1"></i>
                    Consola Administrativa
                </span>
            </div>

            <h1 class="h3 fw-bold text-corporate-primary mb-1">
                Panel de Control
            </h1>

            <p class="text-secondary mb-0">
                Supervisión general de usuarios, instituciones, empresas y solicitudes.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-white border text-secondary px-3 py-2">
                <i class="bi bi-calendar3 me-1"></i>
                @DateTime.Now.ToString("dd/MM/yyyy")
            </span>

            <button type="button"
                    class="btn btn-teal d-flex align-items-center gap-2"
                    onclick="window.print()">
                <i class="bi bi-printer"></i>
                Imprimir
            </button>
        </div>
    </div>


    <!-- ========================= -->
    <!-- KPIs PRINCIPALES -->
    <!-- ========================= -->

    <div class="row g-3 mb-4">

        <!-- Instituciones -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <span class="text-uppercase text-secondary fw-semibold"
                                  style="font-size: .72rem; letter-spacing: .05em;">
                                Instituciones
                            </span>

                            <div class="display-6 fw-bold text-corporate-primary mt-1">
                                @Model.TotalInstituciones
                            </div>

                            <small class="text-secondary">
                                Registradas en Vínculo
                            </small>
                        </div>

                        <div class="kpi-icon-box bg-teal-subtle-custom">
                            <i class="bi bi-building"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Empresas -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <span class="text-uppercase text-secondary fw-semibold"
                                  style="font-size: .72rem; letter-spacing: .05em;">
                                Empresas
                            </span>

                            <div class="display-6 fw-bold text-corporate-primary mt-1">
                                @Model.TotalEmpresas
                            </div>

                            <small class="text-secondary">
                                Empresas registradas
                            </small>
                        </div>

                        <div class="kpi-icon-box"
                             style="background-color:#e9eff7; color:#0f2a47;">
                            <i class="bi bi-briefcase"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Solicitudes -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <span class="text-uppercase text-secondary fw-semibold"
                                  style="font-size: .72rem; letter-spacing: .05em;">
                                Solicitudes
                            </span>

                            <div class="display-6 fw-bold text-corporate-primary mt-1">
                                @Model.TotalSolicitudes
                            </div>

                            <small class="text-secondary">
                                Solicitudes recibidas
                            </small>
                        </div>

                        <div class="kpi-icon-box bg-teal-subtle-custom">
                            <i class="bi bi-card-checklist"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Usuarios -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <span class="text-uppercase text-secondary fw-semibold"
                                  style="font-size: .72rem; letter-spacing: .05em;">
                                Usuarios
                            </span>

                            <div class="display-6 fw-bold text-corporate-primary mt-1">
                                @Model.TotalUsuarios
                            </div>

                            <small class="text-secondary">
                                Cuentas registradas
                            </small>
                        </div>

                        <div class="kpi-icon-box"
                             style="background-color:#e9eff7; color:#0f2a47;">
                            <i class="bi bi-people"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- ========================= -->
    <!-- ESTADO DE SOLICITUDES -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="h5 fw-bold text-corporate-primary mb-1">
                                Estado de Solicitudes
                            </h2>

                            <p class="small text-secondary mb-0">
                                Situación actual de las solicitudes recibidas.
                            </p>
                        </div>

                        <i class="bi bi-bar-chart-line fs-4 text-secondary"></i>
                    </div>


                    <div class="row g-3">

                        <!-- Pendientes -->
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 border bg-light h-100">

                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="rounded-circle bg-warning"
                                          style="width:10px;height:10px;">
                                    </span>

                                    <span class="small fw-semibold text-secondary">
                                        Pendientes
                                    </span>
                                </div>

                                <div class="fs-2 fw-bold text-dark">
                                    @Model.SolicitudesPendientes
                                </div>

                            </div>
                        </div>


                        <!-- Coordinación -->
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 border bg-light h-100">

                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="rounded-circle"
                                          style="width:10px;height:10px;background-color:#0e9aa7;">
                                    </span>

                                    <span class="small fw-semibold text-secondary">
                                        En coordinación
                                    </span>
                                </div>

                                <div class="fs-2 fw-bold text-dark">
                                    @Model.SolicitudesEnCoordinacion
                                </div>

                            </div>
                        </div>


                        <!-- Concretadas -->
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 border bg-light h-100">

                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="rounded-circle bg-success"
                                          style="width:10px;height:10px;">
                                    </span>

                                    <span class="small fw-semibold text-secondary">
                                        Concretadas
                                    </span>
                                </div>

                                <div class="fs-2 fw-bold text-dark">
                                    @Model.SolicitudesConcretadas
                                </div>

                            </div>
                        </div>

                    </div>


                    <!-- Barra de progreso -->
                    @{
                        var porcentajeConcretadas =
                            Model.TotalSolicitudes > 0
                            ? (Model.SolicitudesConcretadas * 100.0 / Model.TotalSolicitudes)
                            : 0;

                        var porcentajeCoordinacion =
                            Model.TotalSolicitudes > 0
                            ? (Model.SolicitudesEnCoordinacion * 100.0 / Model.TotalSolicitudes)
                            : 0;

                        var porcentajePendientes =
                            Model.TotalSolicitudes > 0
                            ? (Model.SolicitudesPendientes * 100.0 / Model.TotalSolicitudes)
                            : 0;
                    }

                    <div class="mt-4">

                        <div class="d-flex justify-content-between small mb-2">
                            <span class="text-secondary">
                                Distribución
                            </span>

                            <span class="fw-semibold text-corporate-primary">
                                @Model.TotalSolicitudes total
                            </span>
                        </div>

                        <div class="progress"
                             style="height:10px;">

                            <div class="progress-bar bg-success"
                                 style="width:@porcentajeConcretadas.ToString("0.##")%">
                            </div>

                            <div class="progress-bar"
                                 style="width:@porcentajeCoordinacion.ToString("0.##")%; background-color:#0e9aa7;">
                            </div>

                            <div class="progress-bar bg-warning"
                                 style="width:@porcentajePendientes.ToString("0.##")%">
                            </div>

                        </div>

                        <div class="d-flex flex-wrap gap-3 mt-2 small text-secondary">

                            <span>
                                <i class="bi bi-circle-fill text-success me-1"
                                   style="font-size:.5rem;"></i>
                                Concretadas
                            </span>

                            <span>
                                <i class="bi bi-circle-fill text-teal me-1"
                                   style="font-size:.5rem;"></i>
                                En coordinación
                            </span>

                            <span>
                                <i class="bi bi-circle-fill text-warning me-1"
                                   style="font-size:.5rem;"></i>
                                Pendientes
                            </span>

                        </div>

                    </div>

                </div>
            </div>

        </div>


        <!-- ========================= -->
        <!-- USUARIOS -->
        <!-- ========================= -->

        <div class="col-12 col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>
                            <h2 class="h5 fw-bold text-corporate-primary mb-1">
                                Usuarios
                            </h2>

                            <p class="small text-secondary mb-0">
                                Estado de las cuentas.
                            </p>
                        </div>

                        <i class="bi bi-person-check fs-4 text-secondary"></i>

                    </div>


                    <div class="d-flex align-items-center gap-3 mb-3">

                        <div class="rounded-circle bg-teal-subtle-custom d-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;">

                            <i class="bi bi-people fs-4"></i>

                        </div>

                        <div>
                            <div class="fs-3 fw-bold text-corporate-primary">
                                @Model.TotalUsuarios
                            </div>

                            <div class="small text-secondary">
                                usuarios totales
                            </div>
                        </div>

                    </div>


                    <div class="d-flex justify-content-between align-items-center border-top pt-3">

                        <div>
                            <div class="small text-secondary">
                                Activos
                            </div>

                            <div class="fw-bold text-success">
                                @Model.UsuariosActivos
                            </div>
                        </div>

                        <div class="text-end">
                            <div class="small text-secondary">
                                Inactivos
                            </div>

                            <div class="fw-bold text-danger">
                                @Model.UsuariosInactivos
                            </div>
                        </div>

                    </div>


                    <hr />

                    <div class="small text-secondary">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Instituciones</span>
                            <strong class="text-dark">
                                @Model.TotalInstituciones
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Empresas</span>
                            <strong class="text-dark">
                                @Model.TotalEmpresas
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span>Administradores</span>
                            <strong class="text-dark">
                                @Model.TotalAdministradores
                            </strong>
                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- DONACIONES -->
    <!-- ========================= -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>
                            <div class="small text-uppercase text-secondary fw-semibold">
                                Donaciones disponibles
                            </div>

                            <div class="fs-3 fw-bold text-corporate-primary mt-1">
                                @Model.DonacionesDisponibles
                            </div>
                        </div>

                        <i class="bi bi-box-seam fs-3 text-teal"></i>

                    </div>

                </div>
            </div>
        </div>


        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>
                            <div class="small text-uppercase text-secondary fw-semibold">
                                Donaciones asignadas
                            </div>

                            <div class="fs-3 fw-bold text-corporate-primary mt-1">
                                @Model.DonacionesAsignadas
                            </div>
                        </div>

                        <i class="bi bi-arrow-left-right fs-3 text-teal"></i>

                    </div>

                </div>
            </div>
        </div>


        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between">

                        <div>
                            <div class="small text-uppercase text-secondary fw-semibold">
                                Donaciones entregadas
                            </div>

                            <div class="fs-3 fw-bold text-corporate-primary mt-1">
                                @Model.DonacionesEntregadas
                            </div>
                        </div>

                        <i class="bi bi-check2-circle fs-3 text-success"></i>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- ========================= -->
    <!-- SOLICITUDES RECIENTES -->
    <!-- ========================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">

                <div>
                    <h2 class="h5 fw-bold text-corporate-primary mb-1">
                        Solicitudes recientes
                    </h2>

                    <p class="small text-secondary mb-0">
                        Últimas solicitudes registradas en el sistema.
                    </p>
                </div>

                <span class="badge bg-teal-subtle-custom rounded-pill">
                    @Model.TotalSolicitudes solicitudes
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.SolicitudesRecientes != null &&
                 Model.SolicitudesRecientes.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>

                                <th class="ps-4">
                                    Referencia
                                </th>

                                <th>
                                    Institución
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th class="text-center">
                                    Equipamientos
                                </th>

                                <th class="text-center">
                                    Estado
                                </th>

                                <th class="text-end pe-4">
                                    Acción
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var solicitud in Model.SolicitudesRecientes)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <span class="font-monospace fw-semibold text-corporate-primary">
                                            @solicitud.NumeroReferencia
                                        </span>

                                    </td>


                                    <td>

                                        <div class="fw-semibold text-dark">
                                            @solicitud.Institucion
                                        </div>

                                    </td>


                                    <td>

                                        <span class="small text-secondary">
                                            @solicitud.Fecha.ToString("dd/MM/yyyy")
                                        </span>

                                    </td>


                                    <td class="text-center">

                                        <span class="badge bg-light text-dark border">
                                            @solicitud.CantidadEquipamientos
                                        </span>

                                    </td>


                                    <td class="text-center">

                                        @if (solicitud.Estado == "Pendiente")
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">
                                                Pendiente
                                            </span>
                                        }
                                        else if (solicitud.Estado == "EnCoordinacion")
                                        {
                                            <span class="badge rounded-pill bg-teal-subtle-custom">
                                                En coordinación
                                            </span>
                                        }
                                        else if (solicitud.Estado == "Concretado")
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success">
                                                Concretado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                                @solicitud.Estado
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end pe-4">

                                        <a asp-controller="Solicitud"
                                           asp-action="Details"
                                           asp-route-id="@solicitud.Id"
                                           class="btn btn-sm btn-outline-secondary">

                                            <i class="bi bi-eye me-1"></i>
                                            Ver

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-inbox fs-1 text-secondary"></i>
                    </div>

                    <h3 class="h6 fw-semibold text-dark">
                        No hay solicitudes registradas
                    </h3>

                    <p class="small text-secondary mb-0">
                        Cuando existan solicitudes aparecerán aquí.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ========================= -->
    <!-- ESTADO DEL SISTEMA -->
    <!-- ========================= -->

    <div class="card border-0 shadow-sm bg-corporate-primary text-white">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <div class="d-flex align-items-center gap-2 mb-2">

                        <i class="bi bi-shield-check fs-4 text-info"></i>

                        <span class="text-uppercase fw-semibold small">
                            Estado del sistema
                        </span>

                    </div>

                    <h2 class="h5 fw-bold mb-2">
                        Vínculo funcionando correctamente
                    </h2>

                    <p class="small mb-0"
                       style="color:#dce9ff;">
                        El panel administrativo está conectado a la base de datos
                        y mostrando información actualizada de usuarios y solicitudes.
                    </p>

                </div>


                <div class="col-lg-4 mt-3 mt-lg-0">

                    <div class="d-flex justify-content-lg-end">

                        <span class="badge rounded-pill px-3 py-2"
                              style="background-color:#eaf8fa;color:#086b75;">

                            <i class="bi bi-circle-fill me-1"
                               style="font-size:.55rem;"></i>

                            Sistema operativo

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
