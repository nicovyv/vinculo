@model Vinculo.Models.ViewModels.AdminEmpresaViewModel

@{
    ViewData["Title"] = "Empresas";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-building fs-4 text-teal"></i>
                <h1 class="h3 fw-bold mb-0 text-corporate-primary">Empresas</h1>
            </div>
            <p class="text-secondary mb-0 small">
                Administración y seguimiento de las empresas registradas.
            </p>
        </div>

        <span class="badge bg-teal-subtle-custom border px-3 py-2">
            @Model.Empresas.Count empresa@(Model.Empresas.Count == 1 ? "" : "s")
        </span>
    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel text-teal"></i>
                <h2 class="h6 fw-bold mb-0 text-corporate-primary">Filtros</h2>
            </div>
        </div>

        <div class="card-body p-3">
            <form asp-controller="Administrador" asp-action="Empresas" method="get">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-10">
                        <label for="busqueda" class="form-label small fw-semibold text-secondary">
                            Buscar empresa
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="busqueda"
                                   name="busqueda"
                                   value="@Model.Busqueda"
                                   class="form-control"
                                   placeholder="Razón social o CUIT..." />
                        </div>
                    </div>

                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-teal flex-grow-1">
                            <i class="bi bi-search me-1"></i>
                            Filtrar
                        </button>

                        <a asp-controller="Administrador"
                           asp-action="Empresas"
                           class="btn btn-outline-secondary"
                           title="Limpiar filtros"
                           aria-label="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-buildings text-teal fs-5"></i>
                    <div>
                        <h2 class="h6 fw-bold mb-0 text-corporate-primary">
                            Empresas registradas
                        </h2>
                        <small class="text-secondary">
                            Información general de las empresas.
                        </small>
                    </div>
                </div>

                <span class="badge bg-light text-secondary border">
                    @Model.Empresas.Count empresa@(Model.Empresas.Count == 1 ? "" : "s")
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.Empresas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase"
                               style="font-size: .72rem; letter-spacing: .03em;">
                            <tr>
                                <th class="ps-4 py-3" style="min-width: 230px;">Empresa</th>
                                <th class="py-3" style="min-width: 150px;">CUIT</th>
                                <th class="py-3" style="min-width: 160px;">Teléfono</th>
                                <th class="py-3" style="min-width: 220px;">Email</th>
                                <th class="pe-4 py-3 text-end" style="min-width: 140px;">Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var empresa in Model.Empresas)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-teal-subtle-custom text-teal d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width: 42px; height: 42px;">
                                                <i class="bi bi-building fs-5"></i>
                                            </div>

                                            <div class="fw-semibold text-dark">
                                                @empresa.RazonSocial
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="font-monospace small">
                                            @empresa.Cuit
                                        </span>
                                    </td>

                                    <td>
                                        <span class="small text-secondary">
                                            <i class="bi bi-telephone me-1"></i>
                                            @empresa.Telefono
                                        </span>
                                    </td>

                                    <td>
                                        <span class="small text-truncate d-inline-block"
                                              style="max-width: 220px;"
                                              title="@empresa.Email">
                                            <i class="bi bi-envelope me-1 text-secondary"></i>
                                            @empresa.Email
                                        </span>
                                    </td>

                                    <td class="pe-4 py-3 text-end">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detalleEmpresaModal"
                                                data-id="@empresa.Id">
                                            <i class="bi bi-eye me-1"></i>
                                            Ver detalle
                                        </button>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px;">
                        <i class="bi bi-buildings fs-2 text-secondary"></i>
                    </div>

                    <h6 class="fw-bold text-dark">No se encontraron empresas</h6>

                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
                    {
                        <p class="text-muted small mb-3">
                            No hay empresas que coincidan con
                            <strong>@Model.Busqueda</strong>.
                        </p>

                        <a asp-controller="Administrador"
                           asp-action="Empresas"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Ver todas
                        </a>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            Todavía no hay empresas registradas.
                        </p>
                    }
                </div>
            }
        </div>
    </div>
</div>


<!-- Modal: detalle de empresa -->
<div class="modal fade"
     id="detalleEmpresaModal"
     tabindex="-1"
     aria-labelledby="detalleEmpresaLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <!-- Encabezado -->
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold text-corporate-primary"
                        id="detalleEmpresaLabel">
                        <i class="bi bi-building me-2 text-teal"></i>
                        Detalle de empresa
                    </h5>
                    <small class="text-secondary">
                        Información general y datos de contacto.
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <!-- Contenido -->
            <div class="modal-body">

                <!-- Identificación -->
                <h6 class="fw-bold mb-3 text-corporate-primary">
                    <i class="bi bi-card-text me-2 text-teal"></i>
                    Identificación de la empresa
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="small text-secondary">Razón social</div>
                        <div id="detalleRazon" class="fw-semibold text-dark"></div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-secondary">CUIT</div>
                        <div id="detalleCuit" class="fw-semibold"></div>
                    </div>
                </div>

                <hr />

                

                <!-- Domicilio -->
                <h6 class="fw-bold mb-3 text-corporate-primary">
                    <i class="bi bi-geo-alt me-2 text-teal"></i>
                    Domicilio
                </h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="small text-secondary">Calle y número</div>
                        <div id="detalleDomicilio" class="fw-semibold">-</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-secondary">Localidad y provincia</div>
                        <div id="detalleLocalidad" class="fw-semibold">-</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-secondary">Código postal</div>
                        <div id="detalleCodigoPostal" class="fw-semibold">-</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-secondary">Estado de la cuenta</div>
                        <span id="detalleEstado" class="badge bg-secondary">-</span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Dashboard de donaciones -->
                <h6 class="fw-bold mb-3 text-corporate-primary">
                    <i class="bi bi-graph-up me-2 text-teal"></i>
                    Actividad de donaciones
                </h6>

                <div class="row g-3">
                    <div class="col-6 col-lg-3">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-body">
                                <div class="small text-secondary mb-2">Total</div>
                                <div id="detalleTotalDonaciones"
                                     class="fs-3 fw-bold text-corporate-primary">
                                    0
                                </div>
                                <div class="small text-secondary">Donaciones</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-body">
                                <div class="small text-secondary mb-2">Disponibles</div>
                                <div id="detalleDisponibles"
                                     class="fs-3 fw-bold text-success">
                                    0
                                </div>
                                <div class="small text-secondary">Sin asignar</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-body">
                                <div class="small text-secondary mb-2">Asignadas</div>
                                <div id="detalleAsignadas"
                                     class="fs-3 fw-bold text-primary">
                                    0
                                </div>
                                <div class="small text-secondary">En proceso</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-body">
                                <div class="small text-secondary mb-2">Entregadas</div>
                                <div id="detalleEntregadas"
                                     class="fs-3 fw-bold text-teal">
                                    0
                                </div>
                                <div class="small text-secondary">Completadas</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="detalleEmpresaError"
                     class="alert alert-danger mt-3 d-none"
                     role="alert">
                    No se pudo cargar el detalle de la empresa.
                </div>
                <hr class="my-4" />
                <!-- Contacto -->
                <h6 class="fw-bold mb-3 text-corporate-primary">
                    <i class="bi bi-person-lines-fill me-2 text-teal"></i>
                    Datos de contacto
                </h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="small text-secondary">Teléfono</div>
                        <div class="fw-semibold">
                            <i class="bi bi-telephone me-2 text-teal"></i>
                            <span id="detalleTelefono"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-secondary">Email</div>
                        <div class="fw-semibold text-break">
                            <i class="bi bi-envelope me-2 text-teal"></i>
                            <span id="detalleEmail"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="small text-secondary">Persona de contacto</div>
                        <div class="fw-semibold">
                            <i class="bi bi-person me-2 text-teal"></i>
                            <span id="detalleContacto"></span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Pie -->
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>
</div>

@section Scripts {
    <script>
        const modalEmpresa = document.getElementById('detalleEmpresaModal');

        modalEmpresa.addEventListener('show.bs.modal', async function(event) {
            const boton = event.relatedTarget;
            const id = boton?.dataset.id;
            const error = document.getElementById('detalleEmpresaError');

            const campos = [
                'detalleRazon',
                'detalleCuit',
                'detalleTelefono',
                'detalleEmail',
                'detalleContacto',
                'detalleDomicilio',
                'detalleLocalidad',
                'detalleCodigoPostal',
                'detalleTotalDonaciones',
                'detalleDisponibles',
                'detalleAsignadas',
                'detalleEntregadas'
            ];

            campos.forEach(campo => {
                document.getElementById(campo).textContent = '-';
            });

            document.getElementById('detalleEstado').textContent = 'Cargando...';
            document.getElementById('detalleEstado').className =
                'badge bg-secondary';

            error.classList.add('d-none');

            if (!id) {
                error.textContent = 'No se pudo identificar la empresa seleccionada.';
                error.classList.remove('d-none');
                return;
            }

            try {
                const url = '@Url.Action("ObtenerDetalleEmpresa", "Administrador")'
                    + '?id=' + encodeURIComponent(id);

                const respuesta = await fetch(url);

                if (!respuesta.ok) {
                    throw new Error('Error al consultar el detalle.');
                }

                const empresa = await respuesta.json();

                document.getElementById('detalleRazon').textContent =
                    empresa.razonSocial || '-';

                document.getElementById('detalleCuit').textContent =
                    empresa.cuit || '-';

                document.getElementById('detalleTelefono').textContent =
                    empresa.telefono || '-';

                document.getElementById('detalleEmail').textContent =
                    empresa.email || '-';

                document.getElementById('detalleContacto').textContent =
                    empresa.personaContacto || '-';

                const domicilio = [empresa.calle, empresa.numero]
                    .filter(Boolean).join(' ');

                document.getElementById('detalleDomicilio').textContent =
                    domicilio || '-';

                const localidad = [
                    empresa.localidad,
                    empresa.provincia
                ].filter(Boolean).join(', ');

                document.getElementById('detalleLocalidad').textContent =
                    localidad || '-';

                document.getElementById('detalleCodigoPostal').textContent =
                    empresa.codigoPostal || '-';

                const estado = document.getElementById('detalleEstado');

                estado.textContent = empresa.activo ? 'Activa' : 'Inactiva';
                estado.className = 'badge ' +
                    (empresa.activo ? 'bg-success' : 'bg-secondary');

                document.getElementById('detalleTotalDonaciones').textContent =
                    empresa.totalDonaciones;

                document.getElementById('detalleDisponibles').textContent =
                    empresa.disponibles;

                document.getElementById('detalleAsignadas').textContent =
                    empresa.asignadas;

                document.getElementById('detalleEntregadas').textContent =
                    empresa.entregadas;
            }
            catch (e) {
                error.textContent =
                    'No se pudo cargar el detalle. Intentá cerrar y volver a abrir el modal.';
                error.classList.remove('d-none');

                console.error(e);
            }
        });
    </script>
}