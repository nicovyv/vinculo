@model Vinculo.Models.ViewModels.AdminEmpresaViewModel

@{
    ViewData["Title"] = "Empresas";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">Empresas</h2>
            <p class="text-muted mb-0">
                Empresas registradas en la plataforma.
            </p>
        </div>

        <span class="badge bg-secondary fs-6">
            Total: @Model.Empresas.Count
        </span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Administrador"
                  asp-action="Empresas"
                  method="get"
                  class="row g-2">

                <div class="col-md-9">
                    <input type="text"
                           name="busqueda"
                           value="@Model.Busqueda"
                           class="form-control"
                           placeholder="Buscar por razón social o CUIT..." />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>

                    <a asp-controller="Administrador"
                       asp-action="Empresas"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Razón social</th>
                            <th>CUIT</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Empresas.Any())
                        {
                            @foreach (var empresa in Model.Empresas)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @empresa.RazonSocial
                                    </td>
                                    <td>@empresa.Cuit</td>
                                    <td>@empresa.Telefono</td>
                                    <td>@empresa.Email</td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detalleEmpresaModal"
                                                data-razon="@empresa.RazonSocial"
                                                data-cuit="@empresa.Cuit"
                                                data-telefono="@empresa.Telefono"
                                                data-email="@empresa.Email"
                                                data-contacto="@empresa.PersonaContacto">
                                            <i class="bi bi-eye me-1"></i>Detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No se encontraron empresas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="detalleEmpresaModal"
     tabindex="-1"
     aria-labelledby="detalleEmpresaLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="detalleEmpresaLabel">
                    <i class="bi bi-building me-2"></i>Detalle de empresa
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-5">Razón social</dt>
                    <dd class="col-7" id="detalleRazon"></dd>

                    <dt class="col-5">CUIT</dt>
                    <dd class="col-7" id="detalleCuit"></dd>

                    <dt class="col-5">Teléfono</dt>
                    <dd class="col-7" id="detalleTelefono"></dd>

                    <dt class="col-5">Email</dt>
                    <dd class="col-7" id="detalleEmail"></dd>

                    <dt class="col-5">Persona de contacto</dt>
                    <dd class="col-7" id="detalleContacto"></dd>
                </dl>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('detalleEmpresaModal')
            .addEventListener('show.bs.modal', function(event) {
                const boton = event.relatedTarget;

                document.getElementById('detalleRazon').textContent =
                    boton.dataset.razon || '-';

                document.getElementById('detalleCuit').textContent =
                    boton.dataset.cuit || '-';

                document.getElementById('detalleTelefono').textContent =
                    boton.dataset.telefono || '-';

                document.getElementById('detalleEmail').textContent =
                    boton.dataset.email || '-';

                document.getElementById('detalleContacto').textContent =
                    boton.dataset.contacto || '-';
            });
    </script>
}