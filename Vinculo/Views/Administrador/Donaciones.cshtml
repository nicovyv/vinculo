@model Vinculo.Models.ViewModels.AdminDonacionViewModel

@{
    ViewData["Title"] = "Donaciones";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between
        align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-corporate-primary mb-1">
                <i class="bi bi-box-seam me-2"></i>Donaciones
            </h2>
            <p class="text-secondary mb-0">
                Consulta y seguimiento de las donaciones registradas.
            </p>
        </div>

        <span class="badge bg-teal-subtle-custom fs-6 px-3 py-2">
            @Model.Donaciones.Count registro(s)
        </span>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-lg-4">
            <form asp-controller="Administrador"
                  asp-action="Donaciones"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-12 col-md-6">
                    <label for="busqueda" class="form-label fw-semibold">
                        Buscar donación
                    </label>
                    <input type="text"
                           id="busqueda"
                           name="busqueda"
                           value="@Model.Busqueda"
                           class="form-control"
                           placeholder="Número de referencia o empresa..." />
                </div>

                <div class="col-12 col-md-4">
                    <label for="estado" class="form-label fw-semibold">
                        Estado
                    </label>
                    <select id="estado" name="estado" class="form-select">
                        <option value="">Todos los estados</option>

                        @foreach (var opcion in Enum.GetValues<
                            Vinculo.Models.Enums.EstadoDonacion>())
                        {
                            if (Model.EstadoFiltro == opcion.ToString())
                            {
                                <option value="@opcion" selected>
                                    @opcion
                                </option>
                            }
                            else
                            {
                                <option value="@opcion">@opcion</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-teal flex-grow-1">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>

                    <a asp-controller="Administrador"
                       asp-action="Donaciones"
                       class="btn btn-outline-secondary"
                       title="Limpiar filtros"
                       aria-label="Limpiar filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Referencia</th>
                            <th>Empresa</th>
                            <th>Equipamiento</th>
                            <th>Cantidad</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Donaciones.Any())
                        {
                            @foreach (var donacion in Model.Donaciones)
                            {
                                var claseEstado = donacion.Estado switch
                                {
                                    Vinculo.Models.Enums.EstadoDonacion.Disponible
                                        => "bg-success-subtle text-success",
                                    Vinculo.Models.Enums.EstadoDonacion.Asignada
                                        => "bg-warning-subtle text-warning-emphasis",
                                    Vinculo.Models.Enums.EstadoDonacion.Entregada
                                        => "bg-primary-subtle text-primary",
                                    _ => "bg-secondary-subtle text-secondary"
                                };

                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold">
                                            @donacion.NumeroReferencia
                                        </span>
                                    </td>
                                    <td>@donacion.Empresa</td>
                                    <td>@donacion.Tipo</td>
                                    <td>@donacion.Cantidad</td>
                                    <td>@donacion.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @claseEstado">
                                            @donacion.Estado
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-teal"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detalleDonacionModal"
                                                data-referencia="@donacion.NumeroReferencia"
                                                data-empresa="@donacion.Empresa"
                                                data-tipo="@donacion.Tipo"
                                                data-cantidad="@donacion.Cantidad"
                                                data-descripcion="@donacion.Descripcion"
                                                data-fecha="@donacion.Fecha.ToString("dd/MM/yyyy")"
                                                data-estado="@donacion.Estado"
                                                data-foto="@donacion.FotoRuta">
                                            <i class="bi bi-eye me-1"></i>Detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-secondary"></i>
                                    <p class="fw-semibold mt-2 mb-1">
                                        No se encontraron donaciones
                                    </p>
                                    <p class="text-secondary small mb-0">
                                        Probá modificar la búsqueda o el filtro.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de detalle -->
<div class="modal fade"
     id="detalleDonacionModal"
     tabindex="-1"
     aria-labelledby="detalleDonacionTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-corporate-primary text-white">
                <div>
                    <h5 class="modal-title fw-bold" id="detalleDonacionTitulo">
                        Detalle de donación
                    </h5>
                    <small id="detalleReferencia"></small>
                </div>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-12 col-md-5 text-center">
                        <img id="detalleFoto"
                             src=""
                             alt="Foto de la donación"
                             class="img-fluid rounded-3 border"
                             style="max-height: 260px; object-fit: contain; display: none;" />

                        <div id="detalleSinFoto"
                             class="border rounded-3 bg-light text-secondary
                            d-flex flex-column align-items-center
                            justify-content-center p-4"
                             style="min-height: 180px;">
                            <i class="bi bi-image fs-1"></i>
                            <span class="small mt-2">Sin imagen disponible</span>
                        </div>
                    </div>

                    <div class="col-12 col-md-7">
                        <dl class="row mb-0">
                            <dt class="col-sm-5 text-secondary">Empresa</dt>
                            <dd class="col-sm-7 fw-semibold" id="detalleEmpresa"></dd>

                            <dt class="col-sm-5 text-secondary">Equipamiento</dt>
                            <dd class="col-sm-7" id="detalleTipo"></dd>

                            <dt class="col-sm-5 text-secondary">Cantidad</dt>
                            <dd class="col-sm-7" id="detalleCantidad"></dd>

                            <dt class="col-sm-5 text-secondary">Fecha</dt>
                            <dd class="col-sm-7" id="detalleFecha"></dd>

                            <dt class="col-sm-5 text-secondary">Estado</dt>
                            <dd class="col-sm-7" id="detalleEstado"></dd>
                        </dl>
                    </div>

                    <div class="col-12">
                        <h6 class="fw-bold text-corporate-primary">
                            Descripción
                        </h6>
                        <p id="detalleDescripcion"
                           class="text-secondary mb-0"
                           style="white-space: pre-wrap;"></p>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const detalleDonacionModal =
            document.getElementById('detalleDonacionModal');

        detalleDonacionModal.addEventListener('show.bs.modal', function (event) {
            const boton = event.relatedTarget;

            const obtener = (nombre) =>
                boton.getAttribute('data-' + nombre) || '';

            document.getElementById('detalleReferencia').textContent =
                obtener('referencia');

            document.getElementById('detalleEmpresa').textContent =
                obtener('empresa');

            document.getElementById('detalleTipo').textContent =
                obtener('tipo');

            document.getElementById('detalleCantidad').textContent =
                obtener('cantidad');

            document.getElementById('detalleFecha').textContent =
                obtener('fecha');

            document.getElementById('detalleEstado').textContent =
                obtener('estado');

            document.getElementById('detalleDescripcion').textContent =
                obtener('descripcion') || 'Sin descripción.';

            const rutaFoto = obtener('foto');
            const imagen = document.getElementById('detalleFoto');
            const sinFoto = document.getElementById('detalleSinFoto');

            if (rutaFoto) {
                imagen.src = rutaFoto;
                imagen.style.display = 'inline-block';
                sinFoto.style.display = 'none';

                imagen.onerror = function () {
                    imagen.style.display = 'none';
                    sinFoto.style.display = 'flex';
                };
            } else {
                imagen.removeAttribute('src');
                imagen.style.display = 'none';
                sinFoto.style.display = 'flex';
            }
        });
    </script>
}