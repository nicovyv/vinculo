@model Vinculo.Models.ViewModels.AdminInstitucionViewModel

@{
    ViewData["Title"] = "Instituciones";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-building fs-4 text-teal"></i>
                <h1 class="h3 fw-bold mb-0 text-corporate-primary">Instituciones</h1>
            </div>
            <p class="text-secondary mb-0 small">
                Administración y seguimiento de las instituciones registradas.
            </p>
        </div>

        <span class="badge bg-teal-subtle-custom border px-3 py-2">
            @Model.Instituciones.Count institución@(Model.Instituciones.Count == 1 ? "" : "es")
        </span>
    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-funnel text-teal"></i>
                <h2 class="h6 fw-bold mb-0 text-corporate-primary">Filtros</h2>
            </div>
        </div>

        <div class="card-body p-3">
            <form asp-controller="Administrador" asp-action="Instituciones" method="get">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-10">
                        <label for="busqueda" class="form-label small fw-semibold text-secondary">
                            Buscar institución
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="busqueda"
                                   name="busqueda"
                                   value="@Model.Busqueda"
                                   class="form-control"
                                   placeholder="Nombre, CUIT o email..." />
                        </div>
                    </div>

                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-teal flex-grow-1">
                            <i class="bi bi-search me-1"></i>
                            Filtrar
                        </button>

                        <a asp-controller="Administrador"
                           asp-action="Instituciones"
                           class="btn btn-outline-secondary"
                           title="Limpiar filtros"
                           aria-label="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-buildings text-teal fs-5"></i>
                    <div>
                        <h2 class="h6 fw-bold mb-0 text-corporate-primary">
                            Instituciones registradas
                        </h2>
                        <small class="text-secondary">
                            Información general y actividad de solicitudes.
                        </small>
                    </div>
                </div>

                <span class="badge bg-light text-secondary border">
                    @Model.Instituciones.Count institución@(Model.Instituciones.Count == 1 ? "" : "es")
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.Instituciones.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase"
                               style="font-size: .72rem; letter-spacing: .03em;">
                            <tr>
                                <th class="ps-4 py-3" style="min-width: 230px;">Institución</th>
                                <th class="py-3" style="min-width: 150px;">CUIT</th>
                                <th class="py-3" style="min-width: 220px;">Contacto</th>
                                <th class="py-3" style="min-width: 160px;">Ubicación</th>
                                <th class="py-3 text-center" style="min-width: 150px;">Solicitudes</th>
                                <th class="py-3 text-center" style="min-width: 110px;">Estado</th>
                                <th class="py-3 pe-4 text-end" style="min-width: 140px;">Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var institucion in Model.Instituciones)
                            {
                                <tr>
                                    <!-- Institución -->
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-teal-subtle-custom text-teal d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width: 42px; height: 42px;">
                                                <i class="bi bi-building fs-5"></i>
                                            </div>

                                            <div>
                                                <div class="fw-semibold text-dark">
                                                    @institucion.Nombre
                                                </div>
                                                <small class="text-secondary">
                                                    ID #@institucion.Id
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- CUIT -->
                                    <td>
                                        <span class="font-monospace small">
                                            @institucion.Cuit
                                        </span>
                                    </td>

                                    <!-- Contacto -->
                                    <td>
                                        <div class="small text-truncate"
                                             style="max-width: 220px;"
                                             title="@institucion.Email">
                                            <i class="bi bi-envelope me-1 text-secondary"></i>
                                            @institucion.Email
                                        </div>

                                        <div class="small text-secondary mt-1">
                                            <i class="bi bi-telephone me-1"></i>
                                            @institucion.Telefono
                                        </div>
                                    </td>

                                    <!-- Ubicación -->
                                    <td>
                                        <div class="small fw-semibold">
                                            @institucion.Localidad
                                        </div>
                                        <div class="small text-secondary">
                                            @institucion.Provincia
                                        </div>
                                    </td>

                                    <!-- Solicitudes -->
                                    <td class="text-center">
                                        <div class="fw-bold fs-5 text-corporate-primary">
                                            @institucion.CantidadSolicitudes
                                        </div>

                                        <div class="d-flex justify-content-center flex-wrap gap-1 mt-1">
                                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis"
                                                  title="Solicitudes pendientes">
                                                P @institucion.SolicitudesPendientes
                                            </span>

                                            <span class="badge rounded-pill bg-info-subtle text-info-emphasis"
                                                  title="Solicitudes en coordinación">
                                                C @institucion.SolicitudesEnCoordinacion
                                            </span>

                                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis"
                                                  title="Solicitudes concretadas">
                                                ✓ @institucion.SolicitudesConcretadas
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Estado -->
                                    <td class="text-center">
                                        @if (institucion.Activo)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis">
                                                <i class="bi bi-check-circle me-1"></i>Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">
                                                <i class="bi bi-x-circle me-1"></i>Inactiva
                                            </span>
                                        }
                                    </td>

                                    <!-- Acción -->
                                    <td class="pe-4 py-3 text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary btn-detalle-institucion"
                                                data-id="@institucion.Id">
                                            <i class="bi bi-eye me-1"></i>
                                            Ver detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px;">
                        <i class="bi bi-buildings fs-2 text-secondary"></i>
                    </div>

                    <h6 class="fw-bold text-dark">No se encontraron instituciones</h6>

                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
                    {
                        <p class="text-muted small mb-3">
                            No hay instituciones que coincidan con
                            <strong>@Model.Busqueda</strong>.
                        </p>

                        <a asp-controller="Administrador"
                           asp-action="Instituciones"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Ver todas
                        </a>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            Todavía no hay instituciones registradas.
                        </p>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: detalle de institución -->
<div class="modal fade"
     id="modalDetalleInstitucion"
     tabindex="-1"
     aria-labelledby="tituloModalInstitucion"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold text-corporate-primary"
                        id="tituloModalInstitucion">
                        <i class="bi bi-building me-2 text-teal"></i>
                        Detalle de institución
                    </h5>

                    <small class="text-secondary" id="detalleInstitucionId"></small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div id="errorDetalleInstitucion" class="alert alert-danger d-none">
                    No se pudo obtener el detalle de la institución.
                </div>

                <div id="cargandoDetalleInstitucion" class="text-center py-4">
                    <div class="spinner-border text-teal" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="text-secondary mt-2 mb-0">Cargando información...</p>
                </div>

                <div id="contenidoDetalleInstitucion" class="d-none">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                        <div>
                            <h4 class="fw-bold mb-1" id="detalleInstitucionNombre"></h4>
                            <span class="text-secondary" id="detalleInstitucionCuit"></span>
                        </div>

                        <span id="detalleInstitucionEstado" class="badge rounded-pill"></span>
                    </div>

                    <h6 class="fw-bold mb-3 text-corporate-primary">
                        <i class="bi bi-person-lines-fill me-2 text-teal"></i>
                        Datos de contacto
                    </h6>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="small text-secondary">Correo electrónico</div>
                            <div id="detalleInstitucionEmail" class="fw-semibold text-break"></div>
                        </div>

                        <div class="col-md-6">
                            <div class="small text-secondary">Teléfono</div>
                            <div id="detalleInstitucionTelefono" class="fw-semibold"></div>
                        </div>

                        <div class="col-12">
                            <div class="small text-secondary">Persona de contacto</div>
                            <div id="detalleInstitucionContacto" class="fw-semibold"></div>
                        </div>
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3 text-corporate-primary">
                        <i class="bi bi-geo-alt me-2 text-teal"></i>
                        Domicilio
                    </h6>

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <div class="small text-secondary">Calle</div>
                            <div id="detalleInstitucionCalle" class="fw-semibold"></div>
                        </div>

                        <div class="col-md-4">
                            <div class="small text-secondary">Número</div>
                            <div id="detalleInstitucionNumero" class="fw-semibold"></div>
                        </div>

                        <div class="col-md-4">
                            <div class="small text-secondary">Localidad</div>
                            <div id="detalleInstitucionLocalidad" class="fw-semibold"></div>
                        </div>

                        <div class="col-md-4">
                            <div class="small text-secondary">Provincia</div>
                            <div id="detalleInstitucionProvincia" class="fw-semibold"></div>
                        </div>

                        <div class="col-md-4">
                            <div class="small text-secondary">Código postal</div>
                            <div id="detalleInstitucionCodigoPostal" class="fw-semibold"></div>
                        </div>
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3 text-corporate-primary">
                        <i class="bi bi-clipboard-check me-2 text-teal"></i>
                        Actividad de solicitudes
                    </h6>

                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-secondary">Total</div>
                                <div class="fs-4 fw-bold" id="detalleInstitucionTotal"></div>
                            </div>
                        </div>

                        <div class="col-6 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-secondary">Pendientes</div>
                                <div class="fs-4 fw-bold text-warning" id="detalleInstitucionPendientes"></div>
                            </div>
                        </div>

                        <div class="col-6 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-secondary">En coordinación</div>
                                <div class="fs-4 fw-bold text-info" id="detalleInstitucionCoordinacion"></div>
                            </div>
                        </div>

                        <div class="col-6 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-secondary">Concretadas</div>
                                <div class="fs-4 fw-bold text-success" id="detalleInstitucionConcretadas"></div>
                            </div>
                        </div>

                        <div class="col-6 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-secondary">Canceladas</div>
                                <div class="fs-4 fw-bold text-secondary" id="detalleInstitucionCanceladas"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const modalElemento = document.getElementById("modalDetalleInstitucion");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElemento);

            const cargando = document.getElementById("cargandoDetalleInstitucion");
            const contenido = document.getElementById("contenidoDetalleInstitucion");
            const error = document.getElementById("errorDetalleInstitucion");

            const urlDetalle = '@Url.Action("ObtenerDetalleInstitucion", "Administrador")';

            function asignarTexto(id, valor) {
                document.getElementById(id).textContent =
                    valor === null || valor === undefined || valor === ""
                        ? "No informado"
                        : valor;
            }

            document.querySelectorAll(".btn-detalle-institucion").forEach(function(boton) {
                boton.addEventListener("click", async function() {
                    const id = boton.dataset.id;

                    cargando.classList.remove("d-none");
                    contenido.classList.add("d-none");
                    error.classList.add("d-none");

                    modal.show();

                    try {
                        const respuesta = await fetch(
                            `${urlDetalle}?id=${encodeURIComponent(id)}`,
                            { headers: { "Accept": "application/json" } }
                        );

                        if (!respuesta.ok) {
                            throw new Error(`Error HTTP ${respuesta.status}`);
                        }

                        const datos = await respuesta.json();

                        asignarTexto("detalleInstitucionId", `ID #${datos.id}`);
                        asignarTexto("detalleInstitucionNombre", datos.nombre);
                        asignarTexto("detalleInstitucionCuit", `CUIT: ${datos.cuit}`);
                        asignarTexto("detalleInstitucionEmail", datos.email);
                        asignarTexto("detalleInstitucionTelefono", datos.telefono);
                        asignarTexto("detalleInstitucionContacto", datos.personaContacto);

                        asignarTexto("detalleInstitucionCalle", datos.calle);
                        asignarTexto("detalleInstitucionNumero", datos.numero);
                        asignarTexto("detalleInstitucionLocalidad", datos.localidad);
                        asignarTexto("detalleInstitucionProvincia", datos.provincia);
                        asignarTexto("detalleInstitucionCodigoPostal", datos.codigoPostal);

                        asignarTexto("detalleInstitucionTotal", datos.cantidadSolicitudes);
                        asignarTexto("detalleInstitucionPendientes", datos.solicitudesPendientes);
                        asignarTexto("detalleInstitucionCoordinacion", datos.solicitudesEnCoordinacion);
                        asignarTexto("detalleInstitucionConcretadas", datos.solicitudesConcretadas);
                        asignarTexto("detalleInstitucionCanceladas", datos.solicitudesCanceladas);

                        const estado = document.getElementById("detalleInstitucionEstado");
                        estado.textContent = datos.activo ? "Activa" : "Inactiva";
                        estado.className = datos.activo
                            ? "badge rounded-pill bg-success-subtle text-success-emphasis"
                            : "badge rounded-pill bg-danger-subtle text-danger-emphasis";

                        cargando.classList.add("d-none");
                        contenido.classList.remove("d-none");
                    } catch (e) {
                        cargando.classList.add("d-none");
                        error.textContent =
                            "No se pudo obtener el detalle de la institución. Revisá la consola del servidor si el problema continúa.";
                        error.classList.remove("d-none");
                        console.error("Error al cargar el detalle de la institución:", e);
                    }
                });
            });
        });
    </script>
}
