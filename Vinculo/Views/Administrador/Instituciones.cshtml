@model Vinculo.Models.ViewModels.AdminInstitucionViewModel

@{
    ViewData["Title"] = "Instituciones";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold text-corporate-primary mb-1">
                Instituciones
            </h1>

            <p class="text-secondary mb-0">
                Administración y seguimiento de las instituciones registradas.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-2">
                @Model.Instituciones.Count institución@(Model.Instituciones.Count == 1 ? "" : "es")
            </span>
        </div>

    </div>


    <!-- Mensajes -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    <!-- Buscador -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-3">

            <form asp-controller="Administrador"
                  asp-action="Instituciones"
                  method="get">

                <div class="row g-2 align-items-end">

                    <div class="col-12 col-md-8 col-lg-9">

                        <label for="busqueda"
                               class="form-label small fw-semibold text-secondary">
                            Buscar institución
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="busqueda"
                                   name="busqueda"
                                   value="@Model.Busqueda"
                                   class="form-control"
                                   placeholder="Nombre, CUIT o email..." />

                        </div>

                    </div>

                    <div class="col-12 col-md-4 col-lg-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">

                            <i class="bi bi-search me-1"></i>
                            Buscar

                        </button>

                        <a asp-controller="Administrador"
                           asp-action="Instituciones"
                           class="btn btn-outline-secondary"
                           title="Limpiar búsqueda">

                            <i class="bi bi-x-lg"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Tabla -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex align-items-center justify-content-between">

                <div>

                    <h2 class="h6 fw-bold mb-0">
                        Instituciones registradas
                    </h2>

                    <small class="text-secondary">
                        Información general y actividad de solicitudes.
                    </small>

                </div>

                <i class="bi bi-buildings text-secondary fs-4"></i>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Instituciones.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4" style="min-width: 230px;">
                                    Institución
                                </th>

                                <th style="min-width: 150px;">
                                    CUIT
                                </th>

                                <th style="min-width: 220px;">
                                    Contacto
                                </th>

                                <th style="min-width: 160px;">
                                    Ubicación
                                </th>

                                <th class="text-center" style="min-width: 150px;">
                                    Solicitudes
                                </th>

                                <th class="text-center" style="min-width: 110px;">
                                    Estado
                                </th>

                                <th class="text-end pe-4" style="min-width: 140px;">
                                    Acción
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var institucion in Model.Instituciones)
                            {
                                <tr>

                                    <!-- Institución -->
                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="rounded-circle bg-primary-subtle text-primary
                                                d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width: 42px; height: 42px;">

                                                <i class="bi bi-building fs-5"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold text-dark">
                                                    @institucion.Nombre
                                                </div>

                                                <small class="text-secondary">
                                                    ID #@institucion.Id
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- CUIT -->
                                    <td>

                                        <span class="font-monospace small">
                                            @institucion.Cuit
                                        </span>

                                    </td>


                                    <!-- Contacto -->
                                    <td>

                                        <div class="small text-truncate"
                                             style="max-width: 220px;"
                                             title="@institucion.Email">

                                            <i class="bi bi-envelope me-1 text-secondary"></i>
                                            @institucion.Email

                                        </div>

                                        <div class="small text-secondary mt-1">

                                            <i class="bi bi-telephone me-1"></i>
                                            @institucion.Telefono

                                        </div>

                                    </td>


                                    <!-- Ubicación -->
                                    <td>

                                        <div class="small fw-semibold">
                                            @institucion.Localidad
                                        </div>

                                        <div class="small text-secondary">
                                            @institucion.Provincia
                                        </div>

                                    </td>


                                    <!-- Solicitudes -->
                                    <td>

                                        <div class="text-center">

                                            <div class="fw-bold fs-5 text-corporate-primary">
                                                @institucion.CantidadSolicitudes
                                            </div>

                                            <div class="d-flex justify-content-center
                                                flex-wrap gap-1 mt-1">

                                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis"
                                                      title="Solicitudes pendientes">

                                                    P @institucion.SolicitudesPendientes

                                                </span>

                                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis"
                                                      title="Solicitudes en coordinación">

                                                    C @institucion.SolicitudesEnCoordinacion

                                                </span>

                                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis"
                                                      title="Solicitudes concretadas">

                                                    ✓ @institucion.SolicitudesConcretadas

                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Estado -->
                                    <td class="text-center">

                                        @if (institucion.Activo)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Activa

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Inactiva

                                            </span>
                                        }

                                    </td>


                                    <!-- Acción -->
                                    <td class="text-end pe-4">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                disabled
                                                title="Detalle próximamente">

                                            <i class="bi bi-eye me-1"></i>
                                            Ver detalle

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Sin resultados -->

                <div class="text-center py-5 px-3">

                    <div class="rounded-circle bg-primary-subtle text-primary
                        d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px;">

                        <i class="bi bi-buildings fs-3"></i>

                    </div>

                    <h3 class="h5 fw-bold">
                        No se encontraron instituciones
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
                    {
                        <p class="text-secondary mb-3">

                            No hay instituciones que coincidan con
                            <strong>@Model.Busqueda</strong>.

                        </p>

                        <a asp-controller="Administrador"
                           asp-action="Instituciones"
                           class="btn btn-outline-secondary btn-sm">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Ver todas

                        </a>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">
                            Todavía no hay instituciones registradas.
                        </p>
                    }

                </div>
            }

        </div>

    </div>

</div>
