@model Vinculo.Models.ViewModels.PerfilEmpresaViewModel

@{
    ViewData["Title"] = "Dashboard Empresa";
}

<div class="container-fluid px-0">
    <!-- Breadcrumb y Título de Página -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-secondary">
                    <li class="breadcrumb-item"><a class="text-decoration-none text-secondary" href="#">Inicio</a></li>
                    <li aria-current="page" class="breadcrumb-item active text-dark fw-semibold">Dashboard Empresa</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <h1 class="h3 fw-bold text-corporate-primary mb-0">Panel Corporativo de Donaciones</h1>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace py-1 px-2">
                    <i class="bi bi-shield-lock me-1"></i>
                    <strong>@Model?.RazonSocial</strong>
                </span>
                <span class="badge bg-primary-subtle text-primary border border-info-subtle font-monospace py-1 px-2 ms-2">
                    <i class="bi bi-shield-lock me-1"></i>
                    <strong>@Model?.Cuit</strong>
                </span>
            </div>
            <p class="text-secondary mb-0 small">
                Supervisión de parque informático en desuso, trazabilidad fiscal, logística inversa y asignación geolocalizada a entidades educativas y comunitarias de la Red Eisbaer.
            </p>
        </div>
        <div class="text-nowrap">
            <a class="btn btn-teal d-inline-flex align-items-center gap-2 px-3 py-2 fw-medium shadow-sm" href="#">
                <i class="bi bi-plus-circle"></i>
                <span>Registrar Nueva Donación</span>
            </a>
        </div>
    </div>

    <!-- Fila de 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- KPI 1 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Donaciones Publicadas</span>
                        <div class="h3 fw-bold text-corporate-primary mb-0 mt-1 font-monospace">8 <span class="fs-6 text-secondary fw-normal">lotes</span></div>
                    </div>
                    <div class="kpi-icon-box bg-body-tertiary text-corporate-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1 text-success small pt-2 border-top border-light-subtle">
                    <i class="bi bi-arrow-up-right"></i>
                    <span class="fw-bold">+2 lotes</span>
                    <span class="text-secondary">ingresados este mes</span>
                </div>
            </div>
        </div>
        <!-- KPI 2 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Asignaciones en Curso</span>
                        <div class="h3 fw-bold text-corporate-primary mb-0 mt-1 font-monospace">3 <span class="fs-6 text-secondary fw-normal">activas</span></div>
                    </div>
                    <div class="kpi-icon-box bg-info-subtle text-info">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1 text-secondary small pt-2 border-top border-light-subtle">
                    <i class="bi bi-clock-history"></i>
                    <span class="fw-semibold text-dark">Logística programada</span>
                    <span class="text-muted">48-72 hs</span>
                </div>
            </div>
        </div>
        <!-- KPI 3 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Entregas Concretadas</span>
                        <div class="h3 fw-bold text-corporate-primary mb-0 mt-1 font-monospace">18 <span class="fs-6 text-secondary fw-normal">completadas</span></div>
                    </div>
                    <div class="kpi-icon-box bg-success-subtle text-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1 text-success small pt-2 border-top border-light-subtle">
                    <i class="bi bi-file-earmark-check"></i>
                    <span class="fw-bold">100% actas recibidas</span>
                    <span class="text-secondary">y visadas</span>
                </div>
            </div>
        </div>
        <!-- KPI 4 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Equipamiento Cedido</span>
                        <div class="h3 fw-bold text-corporate-primary mb-0 mt-1 font-monospace">142 <span class="fs-6 text-secondary fw-normal">unidades</span></div>
                    </div>
                    <div class="kpi-icon-box bg-teal-subtle-custom text-teal">
                        <i class="bi bi-cpu"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1 text-secondary small pt-2 border-top border-light-subtle">
                    <i class="bi bi-globe-americas text-success"></i>
                    <span class="text-secondary">Ahorro CO2 est.:</span>
                    <strong class="text-dark font-monospace">2.8 Tn eq.</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección Principal de Dos Columnas -->
    <div class="row g-4">
        <!-- Columna Izquierda (Tabla y Trazabilidad) -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                    <div>
                        <h5 class="fw-bold text-corporate-primary mb-0">Donaciones Activas y Estado Logístico</h5>
                        <small class="text-secondary">Control de inventario publicado, canalización comunitaria y remitos de entrega</small>
                    </div>
                    <!-- Tabs de filtrado -->
                    <div class="btn-group btn-group-sm p-1 bg-body-tertiary rounded-3" role="group">
                        <button class="btn btn-white fw-semibold bg-white shadow-xs text-corporate-primary rounded-2" type="button">En Curso (4)</button>
                        <button class="btn btn-light bg-transparent text-secondary border-0" type="button">Disponibles (2)</button>
                        <button class="btn btn-light bg-transparent text-secondary border-0" type="button">Historial (18)</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-nowrap">
                            <thead class="table-light small text-uppercase text-secondary border-top">
                                <tr>
                                    <th class="ps-3 py-2 fw-semibold" scope="col">Lote Ref.</th>
                                    <th class="py-2 fw-semibold" scope="col">Equipos</th>
                                    <th class="py-2 fw-semibold" scope="col">Fecha Pub.</th>
                                    <th class="py-2 fw-semibold" scope="col">Estado</th>
                                    <th class="py-2 fw-semibold" scope="col">Destino Asignado</th>
                                    <th class="pe-3 py-2 text-end fw-semibold" scope="col">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <tr>
                                    <td class="ps-3 fw-bold font-monospace text-corporate-primary">#DON-2026-089</td>
                                    <td>
                                        <div class="fw-semibold text-dark">25 Notebooks Lenovo T480</div>
                                        <span class="text-secondary font-monospace" style="font-size: 0.75rem;">i5 8va · 16GB · 256GB SSD</span>
                                    </td>
                                    <td class="text-secondary font-monospace">18/03/2026</td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>En Coordinación
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark">Escuela Técnica N° 12</div>
                                        <small class="text-secondary d-flex align-items-center gap-1 font-monospace">
                                            <i class="bi bi-geo-alt-fill text-teal"></i>2.4 km · Barracas
                                        </small>
                                    </td>
                                    <td class="pe-3 text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-sm btn-outline-primary fw-medium px-2 py-1" href="#">Gestionar Remito</a>
                                            <a class="btn btn-sm btn-light border text-secondary" href="#" title="Ver en mapa"><i class="bi bi-geo-alt"></i></a>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3 fw-bold font-monospace text-corporate-primary">#DON-2026-077</td>
                                    <td>
                                        <div class="fw-semibold text-dark">15 PC Dell OptiPlex 7050</div>
                                        <span class="text-secondary font-monospace" style="font-size: 0.75rem;">Con monitores 22" FHD</span>
                                    </td>
                                    <td class="text-secondary font-monospace">10/03/2026</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Asignada
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark">Centro Comunitario La Boca</div>
                                        <small class="text-secondary d-flex align-items-center gap-1 font-monospace">
                                            <i class="bi bi-truck text-secondary"></i>En tránsito (Flecha Sur)
                                        </small>
                                    </td>
                                    <td class="pe-3 text-end">
                                        <a class="btn btn-sm btn-outline-secondary fw-medium px-2 py-1" href="#">Hoja de Ruta</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-top border-light-subtle d-flex flex-column flex-sm-row align-items-center justify-content-between py-3 px-3 gap-2">
                    <small class="text-secondary">
                        Mostrando <strong class="text-dark font-monospace">2</strong> de <strong class="text-dark font-monospace">8</strong> lotes de activos
                    </small>
                    <a class="small fw-semibold text-teal text-decoration-none d-inline-flex align-items-center gap-1" href="#">
                        <span>Ver inventario completo de lotes</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Columna Derecha (Centro de Despacho) -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="fw-bold text-corporate-primary mb-0">Centro de Despacho Asignado</h6>
                    <i class="bi bi-building text-secondary fs-5"></i>
                </div>
                <div class="mb-2">
                    <div class="fw-semibold text-corporate-primary small">Planta Barracas (Hub CABA)</div>
                    <div class="text-secondary small">Av. Regimiento de Patricios 1052, C1266 CABA</div>
                    <div class="text-muted font-monospace mt-1" style="font-size: 0.75rem;">Dársenas 3 y 4 · Control de Acceso CUIT</div>
                </div>
                <div class="map-preview-box rounded-3 p-2 d-flex flex-column justify-content-end mb-3">
                    <div class="bg-white bg-opacity-90 rounded p-1 d-inline-flex align-items-center gap-1 shadow-xs align-self-start font-monospace small" style="font-size: 0.72rem;">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <span>-34.6412° S, -58.3731° W</span>
                    </div>
                </div>
                <div class="bg-body-tertiary rounded-3 p-2 small mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-secondary">Horario de carga habilitado:</span>
                        <strong class="text-dark font-monospace">08:00 a 16:30 hs</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pie de Módulo / Certificación Institucional -->
    <div class="mt-5 pt-4 border-top border-light-subtle d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 text-secondary small">
        <div class="d-flex align-items-center gap-3">
            <img alt="Eisbaer Logo" class="img-fluid opacity-75" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBo-17XWs1TbXjug6LezZr3BxNSZHwcUWe1RZYB1YMtBEcWqnYQ797BIfPkTtDn5VcYKEA_M8-E7sYwAvDxTqPhQ_q95KZ3D6uSWFuR2pIl0FcaYg8gF5I2ARsk6e1Wu6ShBXzhBL_LHp2HZwgblUxV9EOu0501awblbwqZw-cmPkUXbGUw0Oy8HOKOlsK5EQnczwKstL-0w_7Dfb4hrtvnf3zMPFZqW-M_Qx7XkzC53NM6ht9VWyohnUrNy4wZ_YDIZT4" style="width: 36px; height: 36px; object-fit: contain;" />
            <div>
                <div class="fw-semibold text-corporate-primary">Vínculo · Módulo de Donaciones Corporativas</div>
                <div style="font-size: 0.8rem;">Tecnología con Sentido Humano respaldada por Eisbaer. Certificación conforme Resolución AFIP 2485/DG Impositiva.</div>
            </div>
        </div>
    </div>
</div>