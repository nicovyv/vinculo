@model Vinculo.Models.ViewModels.PerfilEmpresaViewModel

@{
    ViewData["Title"] = "Mi Perfil";
}


    <style>
            :root {
              --bs-primary: #0f2a47;
              --bs-primary-rgb: 15, 42, 71;
              --vinculo-teal: #0e9aa7;
              --vinculo-teal-dark: #09757f;
              --vinculo-teal-bg: #eaf8fa;
              --vinculo-surface: #f8f9ff;
              --vinculo-surface-card: #ffffff;
              --vinculo-navy-soft: #e9eff7;
              --vinculo-border: #e3e8f0;
            }
            body {
              font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
              background-color: var(--vinculo-surface);
              color: #0b1c30;
              min-height: 100vh;
            }
            .bg-corporate-primary {
              background-color: #0f2a47 !important;
            }
            .text-corporate-primary {
              color: #0f2a47 !important;
            }
            .btn-teal {
              background-color: var(--vinculo-teal);
              border-color: var(--vinculo-teal);
              color: #ffffff;
            }
            .btn-teal:hover, .btn-teal:focus {
              background-color: var(--vinculo-teal-dark);
              border-color: var(--vinculo-teal-dark);
              color: #ffffff;
            }
            .btn-outline-teal {
              color: var(--vinculo-teal);
              border-color: var(--vinculo-teal);
            }
            .btn-outline-teal:hover {
              background-color: var(--vinculo-teal);
              color: #ffffff;
            }
            .text-teal {
              color: var(--vinculo-teal) !important;
            }
            .bg-teal-subtle-custom {
              background-color: #eaf8fa !important;
              color: #086b75 !important;
            }
            .sidebar {
              width: 260px;
              min-height: calc(100vh - 64px);
            }
            .nav-sidebar-link {
              color: #495057;
              font-weight: 500;
              font-size: 0.9rem;
              border-radius: 0.5rem;
              padding: 0.6rem 0.85rem;
              transition: all 0.15s ease-in-out;
              text-decoration: none;
              display: flex;
              align-items: center;
              gap: 0.65rem;
            }
            .nav-sidebar-link:hover {
              background-color: #f1f4fa;
              color: #0f2a47;
            }
            .nav-sidebar-link.active {
              background-color: #dce7f5;
              color: #0f2a47;
              font-weight: 600;
            }
            .kpi-icon-box {
              width: 46px;
              height: 46px;
              border-radius: 12px;
              display: inline-flex;
              align-items: center;
              justify-content: center;
              font-size: 1.35rem;
            }
            .map-preview-box {
              background: radial-gradient(circle at 50% 50%, #d4e7f5 0%, #c1d9ec 100%);
              border: 1px dashed #99bad5;
              height: 140px;
              position: relative;
            }
            .breadcrumb-item + .breadcrumb-item::before {
              content: "›";
              font-size: 1.1rem;
              line-height: 1;
              vertical-align: -1px;
            }
    </style>

<body class="d-flex flex-column min-h-screen">

    <!-- Layout Principal con Sidebar y Área de Trabajo -->
